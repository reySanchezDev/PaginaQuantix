---
import VercelAnalytics from "../components/analytics/VercelAnalytics.astro";
import SiteFooter from "../components/nav/SiteFooter.astro";
import SiteHeader from "../components/nav/SiteHeader.astro";
import EmailFeedback from "../components/system/EmailFeedback.astro";
import SiteMotion from "../components/system/SiteMotion.astro";
import { getLegalNavigation, getPrimaryNavigation, sharedUi } from "../data/navigation";
import { siteConfig } from "../data/site-config";
import { getAlternatePath, getRoute, normalizePath } from "../i18n/routes";
import type { Locale } from "../types/site";
import { organizationId, websiteId, webpageSchema } from "../lib/semantic-identity";
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  alternatePath?: string;
}

const {
  title,
  description,
  locale = "en",
  image,
  imageAlt,
  noindex = false,
  structuredData,
  alternatePath,
} = Astro.props as Props;

const site = Astro.site ?? new URL(siteConfig.siteUrl);
const canonicalUrl = new URL(normalizePath(Astro.url.pathname), site);
const alternateLocale: Locale = locale === "es" ? "en" : "es";
const alternateUrl = new URL(
  alternatePath ?? getAlternatePath(Astro.url.pathname, alternateLocale),
  site,
);
const defaultUrl = new URL(getRoute("home", "en"), site);
const pageTitle = title.includes("Quantix") ? title : `${title} | Quantix Software`;
const labels = sharedUi[locale];
const imageUrl = new URL(image ?? `/images/og/quantix-${locale}.png`, site);
const socialImageAlt = imageAlt ?? labels.socialImageAlt;
const navigation = getPrimaryNavigation(locale);
const legalNavigation = getLegalNavigation(locale);
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: siteConfig.name,
  description:
    "Quantix Software desarrolla software a medida, integraciones y soluciones para conectar procesos, ventas e inventario de empresas.",
  foundingDate: "2011",
  url: site.href,
  logo: new URL("/favicon.svg", site).href,
  email: siteConfig.email,
};
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: site.href,
      name: siteConfig.name,
      publisher: { "@id": organizationId },
    },
    webpageSchema(Astro.url.pathname, pageTitle, description, locale),
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ee" />
    <script is:inline src="/themes/calendar.js"></script>
    <script is:inline src="/themes/scheduler.js"></script>
    <script is:inline src="/themes/runtime.js"></script>
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl.href} />
          <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
          <link rel="alternate" hreflang={alternateLocale} href={alternateUrl.href} />
          <link rel="alternate" hreflang="x-default" href={defaultUrl.href} />
        </>
      )
    }
    <meta property="og:site_name" content="Quantix Software" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:secure_url" content={imageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={locale === "es" ? "es_NI" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_NI"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    <VercelAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>
    <aside
      class="seasonal-awareness"
      data-seasonal-banner="octubre-rosa"
      aria-label={locale === "es" ? "Campaña de sensibilización" : "Awareness campaign"}
      hidden
    >
      <div class="container seasonal-awareness__inner">
        <span class="seasonal-awareness__mark" aria-hidden="true">
          <svg viewBox="15 0 70 125" fill="none">
            <path
              d="M25 114 C43 85 70 56 70 31 C70 16 63 10 51 10 C35 10 29 21 29 34 C29 52 55 84 73 114"
              stroke="#d88fa8"
              stroke-width="18"
              stroke-linecap="butt"></path>
          </svg>
        </span>
        <p class="seasonal-awareness__message">
          <strong>{locale === "es" ? "Octubre Rosa." : "Breast Cancer Awareness Month."}</strong>
          {
            locale === "es"
              ? " En Quantix acompañamos con respeto a las personas afectadas por el cáncer de mama y a sus familias."
              : " At Quantix, we stand with people affected by breast cancer and their families."
          }
        </p>
        <a
          class="seasonal-awareness__link"
          href="https://www.who.int/news-room/events/detail/2026/10/01/default-calendar/breast-cancer-awareness-month-2026"
          target="_blank"
          rel="noopener noreferrer"
        >
          {locale === "es" ? "Conocer más" : "Learn more"}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>
    <aside
      class="seasonal-halloween"
      data-seasonal-banner="halloween-tech-noir"
      aria-label={locale === "es" ? "Ambientación de Halloween" : "Halloween seasonal theme"}
      hidden
    >
      <div class="container seasonal-halloween__inner">
        <span class="seasonal-halloween__icon" aria-hidden="true">✦</span>
        <p>
          <strong>{locale === "es" ? "Halloween en Quantix." : "Halloween at Quantix."}</strong>
          {locale === "es"
            ? " La misma tecnología. Una atmósfera diferente."
            : " The same technology. A different atmosphere."}
        </p>
        <span class="seasonal-halloween__icon" aria-hidden="true">✦</span>
      </div>
    </aside>
    <SiteHeader navItems={navigation} locale={locale} labels={labels} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter
      navItems={navigation}
      legalItems={legalNavigation}
      locale={locale}
      labels={labels}
    />
    <EmailFeedback locale={locale} />
    <SiteMotion />
  </body>
</html>
