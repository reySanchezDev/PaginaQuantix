---
import VercelAnalytics from "../components/analytics/VercelAnalytics.astro";
import SiteFooter from "../components/nav/SiteFooter.astro";
import SiteHeader from "../components/nav/SiteHeader.astro";
import MotionController from "../components/system/MotionController.astro";
import { getLegalNavigation, getPrimaryNavigation, sharedUi } from "../data/navigation";
import { siteConfig } from "../data/site-config";
import { getAlternatePath, getRoute, normalizePath } from "../i18n/routes";
import type { Locale } from "../types/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  locale = "en",
  image = "/images/og-default.png",
  noindex = false,
  structuredData,
} = Astro.props as Props;

const site = Astro.site ?? new URL(siteConfig.siteUrl);
const canonicalUrl = new URL(normalizePath(Astro.url.pathname), site);
const alternateLocale: Locale = locale === "es" ? "en" : "es";
const alternateUrl = new URL(getAlternatePath(Astro.url.pathname, alternateLocale), site);
const defaultUrl = new URL(getRoute("home", "en"), site);
const imageUrl = new URL(image, site);
const pageTitle = title.includes("Quantix") ? title : `${title} | Quantix Software`;
const labels = sharedUi[locale];
const navigation = getPrimaryNavigation(locale);
const legalNavigation = getLegalNavigation(locale);
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: site.href,
  logo: new URL("/favicon.svg", site).href,
  email: siteConfig.email,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl.href} />
          <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
          <link rel="alternate" hreflang={alternateLocale} href={alternateUrl.href} />
          <link rel="alternate" hreflang="x-default" href={defaultUrl.href} />
        </>
      )
    }
    <meta property="og:site_name" content="Quantix Software" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.name} />
    <meta property="og:locale" content={locale === "es" ? "es_NI" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_NI"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />

    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    <VercelAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>
    <SiteHeader navItems={navigation} locale={locale} labels={labels} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter
      navItems={navigation}
      legalItems={legalNavigation}
      locale={locale}
      labels={labels}
    />
    <MotionController />
  </body>
</html>
