---
import type { Locale, ProductId } from "../types/site";
import { productPageSchema } from "../lib/semantic-identity";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  productName: string;
  productId: ProductId;
  image: string;
  imageAlt: string;
  operatingSystem?: string;
}

const { title, description, locale, productName, productId, image, imageAlt, operatingSystem } =
  Astro.props as Props;
const schema = productPageSchema(productId, locale, productName, description, operatingSystem);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  image={image}
  imageAlt={imageAlt}
  structuredData={schema}
>
  <slot />
</BaseLayout>
