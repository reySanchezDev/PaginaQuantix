---
import type { Locale } from "../types/site";
import { siteConfig } from "../data/site-config";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  productName: string;
  operatingSystem?: string;
}

const { title, description, locale, productName, operatingSystem } = Astro.props as Props;
const site = Astro.site ?? new URL(siteConfig.siteUrl);
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: productName,
  description,
  url: new URL(Astro.url.pathname, site).href,
  applicationCategory: "BusinessApplication",
  ...(operatingSystem ? { operatingSystem } : {}),
};
---

<BaseLayout title={title} description={description} locale={locale} structuredData={schema}>
  <slot />
</BaseLayout>
