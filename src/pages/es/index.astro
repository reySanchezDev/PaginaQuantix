---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import { products } from "../../data/products";

const positioning = [
  "Productos listos",
  "Soluciones adaptables",
  "Sistemas a medida",
  "Acompañamiento técnico",
];

const operations = [
  {
    title: "Usa una solución lista",
    text: "Adopta productos y herramientas de Quantix que ya existen para resolver necesidades operativas concretas.",
  },
  {
    title: "Adapta una solución existente",
    text: "Ajusta módulos, flujos, reglas e integraciones cuando una herramienta existente necesita encajar mejor con tu operación.",
  },
  {
    title: "Define tu idea con asesoría técnica",
    text: "Convierte una necesidad inicial en alcance, prioridades, módulos y una ruta realista antes de invertir en desarrollo.",
  },
  {
    title: "Construye un sistema a medida",
    text: "Crea una plataforma nueva desde cero cuando no existe una solución adecuada para el proceso, datos o modelo de negocio.",
  },
];

const operatingSolutions = [
  {
    title: "Restaurantes y punto de venta",
    text: "Ordena comandas, mesas, pagos, cocina, inventario y operación diaria con flujos listos para restaurantes.",
  },
  {
    title: "Facturación y control comercial",
    text: "Centraliza ventas, documentos, pagos, clientes y reglas comerciales para tener más control del ciclo operativo.",
  },
  {
    title: "Inventario y operaciones",
    text: "Controla movimientos, stock, trazabilidad y tareas repetitivas que sostienen la ejecución del negocio.",
  },
  {
    title: "Clientes, membresías y accesos",
    text: "Gestiona perfiles, membresías, permisos, validaciones y experiencias digitales para usuarios o clientes.",
  },
  {
    title: "Reportería y dashboards",
    text: "Convierte datos operativos en vistas claras para seguimiento, decisiones y control gerencial.",
  },
  {
    title: "Automatización de procesos",
    text: "Reduce pasos manuales con flujos confiables, alertas, aprobaciones y tareas conectadas entre equipos.",
  },
  {
    title: "APIs e integraciones",
    text: "Conecta POS, ERP, pagos, sistemas legados, servicios externos y nuevas plataformas con contratos claros.",
  },
  {
    title: "Herramientas QA y evidencia visual",
    text: "Documenta pruebas, incidencias y evidencia visual con herramientas creadas para equipos técnicos y de calidad.",
  },
];

const heroPanelSolutions = [
  "Operación integral",
  "Clientes y caja",
  "Inventario",
  "Restaurantes y POS",
  "Facturación",
  "Dashboards",
  "Automatización",
];

const workAreas = [
  "Operación integral de negocios",
  "Operaciones de restaurantes",
  "Herramientas financieras",
  "Evidencia QA",
  "Control de inventario",
  "Flujos de facturación",
  "Sistemas relacionados con POS",
  "Dashboards de reportería",
  "Herramientas de automatización",
];

const process = [
  {
    title: "Entender la operación",
    text: "Aclaramos flujos, restricciones, usuarios, datos y el resultado de negocio que el sistema debe apoyar.",
  },
  {
    title: "Diseñar el sistema",
    text: "Definimos la estructura del producto, integraciones, modelo de datos y ruta de implementación antes de construir.",
  },
  {
    title: "Construir e integrar",
    text: "Desarrollamos la plataforma, herramienta o automatización con uso real y mantenibilidad en mente.",
  },
  {
    title: "Acompañar la evolución",
    text: "Ayudamos a mejorar el sistema conforme cambian los requisitos, equipos y condiciones operativas.",
  },
];

const getProduct = (id: string) => {
  const product = products.find((item) => item.id === id);

  if (!product) {
    throw new Error(`Producto no encontrado: ${id}`);
  }

  return product;
};

const productProof = [
  {
    product: getProduct("viggo"),
    statusLabel: "Próximo lanzamiento",
    domain: "Producto destacado de Quantix",
    railLabel: "Operación integral",
    proofLine:
      "VIGGO es la nueva plataforma de Quantix para negocios que necesitan controlar clientes, servicios, productos, caja, inventario, credenciales, accesos e historial desde una sola operación.",
    areas: [
      {
        label: "Operación",
        items: ["Clientes", "Servicios", "Vigencias"],
      },
      {
        label: "Control diario",
        items: ["Caja", "Cobros", "Historial"],
      },
      {
        label: "Productos",
        items: ["Inventario", "Stock", "Movimientos"],
      },
    ],
    visitLabel: "Solicitar información",
  },
  {
    product: getProduct("takofy"),
    statusLabel: "Plataforma comercial",
    domain: "Plataforma de Quantix",
    railLabel: "Plataforma comercial",
    proofLine:
      "Takofy es una plataforma comercial de Quantix para operación de restaurantes, creada alrededor de comandas, mesas, pagos, cocina, reportería, inventario y continuidad sin conexión.",
    areas: [
      {
        label: "Operación",
        items: ["Comandas", "Mesas", "Pagos"],
      },
      {
        label: "Cocina y stock",
        items: ["Cocina", "Inventario", "Sin conexión"],
      },
      {
        label: "Control",
        items: ["Reportería", "Flujos claros"],
      },
    ],
    visitLabel: "Visitar Takofy",
  },
  {
    product: getProduct("nica-finanzas"),
    statusLabel: "Herramienta gratuita para Nicaragua",
    domain: "Herramienta financiera gratuita",
    railLabel: "Herramienta gratuita",
    proofLine:
      "Nica Finanzas es una herramienta financiera gratuita creada por Quantix para Nicaragua, con calculadoras para salario, préstamos y liquidación laboral.",
    areas: [
      {
        label: "Cálculos",
        items: ["Salario", "Préstamos", "Liquidación"],
      },
      {
        label: "Parámetros locales",
        items: ["Nicaragua", "Entradas claras"],
      },
      {
        label: "Resultados",
        items: ["Salidas claras", "Utilidades prácticas"],
      },
    ],
    visitLabel: "Visitar Nica Finanzas",
  },
  {
    product: getProduct("qavision"),
    statusLabel: "Herramienta QA gratuita",
    domain: "Herramienta gratuita de evidencia QA",
    railLabel: "Herramienta gratuita",
    proofLine:
      "QAVision es una herramienta gratuita de evidencia QA creada por Quantix para captura visual, grabación por zona, anotaciones y flujos organizados de evidencia.",
    areas: [
      {
        label: "Captura",
        items: ["Pantallas", "Modo clip", "Video por zona"],
      },
      {
        label: "Revisión",
        items: ["Visor Pro", "Anotaciones", "Edición enriquecida"],
      },
      {
        label: "Evidencia",
        items: ["Autosave", "Carpetas", "Contexto de trabajo"],
      },
    ],
    visitLabel: "Descargar QAVision",
  },
];
---

<BaseLayout
  title="Software empresarial listo, adaptable y a medida"
  description="Quantix ofrece productos y herramientas de software listas para producción, adapta soluciones existentes y construye sistemas a medida cuando una empresa necesita algo único."
  lang="es"
>
  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <Container class="home-hero__container">
        <div class="home-hero__content">
          <p class="home-kicker">Quantix Software</p>
          <h1 id="home-hero-title">Software empresarial listo, adaptable y construido a la medida cuando tu negocio lo necesita</h1>
          <p class="home-hero__lead">
            Encuentra soluciones ya desarrolladas por Quantix, adapta una herramienta existente a tu operación o construye un sistema desde cero con un equipo técnico especializado.
          </p>
          <div class="home-actions">
            <Button href="/es/contacto/" variant="primary">Evaluar mi necesidad</Button>
            <Button href="/es/productos/" variant="secondary">Ver productos</Button>
          </div>
        </div>

        <div class="hero-solutions-panel" aria-label="Soluciones y productos de Quantix">
          <div class="hero-solutions-panel__header">
            <span>Listo para adoptar o adaptar</span>
            <strong>Soluciones empresariales</strong>
          </div>

          <div class="hero-products">
            <a href="/es/productos/viggo/">
              <span>VIGGO</span>
              <strong>Operación integral</strong>
            </a>
            <a href="/es/productos/takofy/">
              <span>Takofy</span>
              <strong>Operación de restaurantes</strong>
            </a>
            <a href="/es/productos/nica-finanzas/">
              <span>Nica Finanzas</span>
              <strong>Herramienta gratuita</strong>
            </a>
            <a href="/es/productos/qavision/">
              <span>QAVision</span>
              <strong>Evidencia QA gratuita</strong>
            </a>
          </div>

          <div class="hero-solution-tags" aria-label="Áreas que Quantix puede resolver">
            {heroPanelSolutions.map((item) => <span>{item}</span>)}
          </div>

          <div class="hero-delivery-path">
            <div>
              <span>01</span>
              <strong>Usar producto</strong>
            </div>
            <div>
              <span>02</span>
              <strong>Adaptar solución</strong>
            </div>
            <div>
              <span>03</span>
              <strong>Construir a medida</strong>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section class="positioning-strip" aria-label="Enfoques de Quantix Software">
      <Container>
        <ul>
          {positioning.map((item) => <li>{item}</li>)}
        </ul>
      </Container>
    </section>

    <section class="home-section home-section--solutions" aria-labelledby="solutions-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Soluciones para operar tu empresa</p>
          <h2 id="solutions-title">Aplicaciones, herramientas e integraciones para áreas reales del negocio</h2>
          <p>
            Quantix no empieza cada conversación desde una hoja en blanco. Partimos de productos, herramientas y experiencia en flujos empresariales concretos para acelerar decisiones y ejecución.
          </p>
        </div>

        <div class="solutions-card-grid">
          {operatingSolutions.map((item) => (
            <article class="solution-business-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-section--surface" aria-labelledby="operations-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Modelo de trabajo</p>
          <h2 id="operations-title">Cuatro formas de llevar software a producción con Quantix</h2>
          <p>
            Puedes adoptar una solución existente, adaptarla a tu operación, definir una idea con acompañamiento técnico o construir un sistema nuevo cuando el negocio lo requiere.
          </p>
        </div>

        <div class="delivery-model-grid">
          {operations.map((item, index) => (
            <article class="delivery-model-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="model-cta">
          <p>El objetivo es elegir el camino con mejor retorno: producto listo cuando existe, adaptación cuando conviene y desarrollo a medida cuando hace falta.</p>
          <Button href="/es/soluciones/" variant="secondary">Explorar soluciones</Button>
        </div>
      </Container>
    </section>

    <section class="home-section" aria-labelledby="products-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Productos</p>
          <h2 id="products-title">Productos y herramientas creadas por Quantix</h2>
          <p>
            Quantix crea sus propias plataformas y herramientas para necesidades operativas específicas, desde operación integral de negocios y ejecución de restaurantes hasta cálculos financieros y flujos de evidencia QA.
          </p>
        </div>

        <div class="product-proof-stack">
          {productProof.map((proof) => (
            <article class="product-proof-card">
              <div class="product-proof-card__content">
                <div class="product-proof-card__header">
                  <span class="product-status">{proof.statusLabel}</span>
                  <span class="product-domain">{proof.domain}</span>
                </div>
                <h3>{proof.product.title.es}</h3>
                <p>{proof.proofLine}</p>
                <div class="card-actions">
                  <Button href={proof.product.href.es} variant="secondary">Ver producto</Button>
                  {proof.product.publicUrl && (
                    <Button href={proof.product.publicUrl} target="_blank" variant="primary">
                      {proof.visitLabel}
                    </Button>
                  )}
                </div>
              </div>

              <div class="product-proof-map" aria-label={`Áreas del producto ${proof.product.title.es}`}>
                <div class="product-proof-map__rail">
                  <span>{proof.railLabel}</span>
                  <strong>{proof.product.title.es}</strong>
                </div>
                <div class="product-proof-map__areas">
                  {proof.areas.map((area) => (
                    <div class="product-proof-area">
                      <span>{area.label}</span>
                      <div>
                        {area.items.map((item) => <strong>{item}</strong>)}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-section--surface" aria-labelledby="work-title">
      <Container>
        <div class="section-split section-split--reverse">
          <div class="work-panel">
            {workAreas.map((item) => <span>{item}</span>)}
          </div>

          <div class="section-heading">
            <p class="section-eyebrow">Experiencia</p>
            <h2 id="work-title">Experiencia en áreas de software operativo</h2>
            <p>
              Nuestro trabajo se organiza alrededor de los tipos de sistemas que las empresas necesitan para operar, controlar información y reducir trabajo repetitivo.
            </p>
            <div class="home-actions">
              <Button href="/es/trabajo/" variant="secondary">Ver áreas de trabajo</Button>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section class="home-section" aria-labelledby="process-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Cómo trabajamos</p>
          <h2 id="process-title">Del contexto operativo al software en uso</h2>
        </div>

        <div class="process-grid">
          {process.map((step, index) => (
            <article class="process-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-section--closing" aria-labelledby="closing-title">
      <Container>
        <div class="closing-panel">
          <div>
            <p class="section-eyebrow">Iniciar conversación</p>
            <h2 id="closing-title">Hablemos sobre tu necesidad de software</h2>
            <p>
              Trae el contexto operativo. Podemos ayudarte a evaluar una herramienta existente, adaptar una plataforma, definir requerimientos o construir el sistema adecuado.
            </p>
          </div>
          <Button href="/es/contacto/" variant="primary">Contactar a Quantix</Button>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .home-page {
    background: var(--bg);
    color: var(--text);
  }

  .home-hero {
    padding: clamp(8rem, 13vw, 10.5rem) 0 clamp(4rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--primary-soft) 24%, var(--bg)) 0%, var(--bg) 72%);
  }

  :global(.home-hero__container) {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .home-hero__content,
  .section-heading,
  .hero-solutions-panel,
  .closing-panel > div {
    min-width: 0;
  }

  .home-kicker,
  .section-eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 50rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(2.45rem, 5.2vw, 4.1rem);
    font-weight: 780;
    line-height: 1.03;
    letter-spacing: -0.018em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .home-hero__lead {
    max-width: 46rem;
    margin: var(--space-6) 0 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.72;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-solutions-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.15rem, 2.8vw, 1.65rem);
    border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--border));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--surface) 93%, var(--primary-soft)), var(--surface));
    box-shadow: var(--shadow-lg);
  }

  .hero-solutions-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--border) 42%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--border) 42%, transparent) 1px, transparent 1px);
    background-size: 2rem 2rem;
    opacity: 0.32;
    pointer-events: none;
  }

  .hero-solutions-panel__header,
  .hero-products,
  .hero-solution-tags,
  .hero-delivery-path {
    position: relative;
    z-index: 1;
  }

  .hero-solutions-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 68%, transparent);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .hero-solutions-panel__header span {
    font-weight: 700;
  }

  .hero-solutions-panel__header strong {
    color: var(--text);
    font-weight: 800;
  }

  .hero-products {
    display: grid;
    gap: var(--space-3);
  }

  .hero-products a {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    min-height: 4.4rem;
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--primary) 12%, var(--border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 92%, white);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  .hero-products a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--primary) 24%, var(--border));
    background: color-mix(in srgb, var(--surface) 84%, var(--primary-soft));
  }

  .hero-products span {
    display: block;
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.2;
  }

  .hero-products strong {
    display: block;
    color: var(--text);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .hero-solution-tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .hero-solution-tags span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.45rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
  }

  .hero-delivery-path {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--border-strong) 68%, transparent);
  }

  .hero-delivery-path div {
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--primary) 12%, var(--border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--primary-soft) 30%, var(--surface));
  }

  .hero-delivery-path span {
    display: block;
    color: var(--primary);
    font-size: var(--text-xs);
    font-weight: 900;
    line-height: 1;
  }

  .hero-delivery-path strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--text);
    font-size: var(--text-xs);
    line-height: 1.25;
  }

  .positioning-strip {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .positioning-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .positioning-strip li {
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    background: var(--surface-2);
  }

  .home-section {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
  }

  .home-section--surface {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .home-section--solutions {
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .section-heading {
    max-width: 42rem;
  }

  .section-heading--wide {
    max-width: 58rem;
    margin-bottom: var(--space-10);
  }

  .section-heading h2,
  .closing-panel h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 4.4vw, 3.35rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .section-heading p,
  .closing-panel p {
    margin: var(--space-4) 0 0;
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .editorial-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
