---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";

const focusAreas = [
  "Restaurants & POS",
  "Billing",
  "Inventory",
  "Customers & access",
  "Dashboards",
  "APIs & automation",
];

const solutionPaths = [
  {
    title: "Ready-made software",
    text: "Use an existing Quantix tool or platform when the operating need already has a focused product path.",
  },
  {
    title: "Customizable platforms",
    text: "Adapt an existing platform around company workflows, rules, modules and integrations.",
  },
  {
    title: "Custom-built systems",
    text: "Build a new operational system when the need does not fit an existing product or platform.",
  },
  {
    title: "Software advisory and requirements definition",
    text: "Turn an early software idea into structured scope, modules, flows, business rules and technical deliverables.",
  },
];

const solutions = [
  {
    title: "Restaurants and point of sale",
    text: "Solutions for orders, tables, payments, kitchen workflows, inventory, reporting and daily restaurant operations.",
  },
  {
    title: "Billing and commercial control",
    text: "Workflows for sales, documents, payments, customers, commercial rules and operating cycle tracking.",
  },
  {
    title: "Inventory and operations",
    text: "Modules for stock, movements, traceability, approvals, operating tasks and day-to-day control.",
  },
  {
    title: "Customers, memberships and access",
    text: "Profile, membership, permission, validation and digital experience management for users or customers.",
  },
  {
    title: "Reporting & BI",
    text: "Dashboards, data models and reporting workflows to understand performance, operations and control points.",
  },
  {
    title: "Process automation",
    text: "Reliable workflows to reduce manual steps, coordinate approvals, issue alerts and connect teams.",
  },
  {
    title: "APIs and integrations",
    text: "Connections between POS, ERP, payments, external services, legacy systems and new platforms.",
  },
  {
    title: "QA tools and visual evidence",
    text: "Tools to capture, organize and review visual evidence in testing and quality control processes.",
  },
];

---

<BaseLayout
  title="Solutions for Operational Software"
  description="Quantix helps companies use ready-made software, adapt existing platforms, build custom systems and define software requirements before development."
  lang="en"
  isHeaderTransparent={false}
>
  <main class="solutions-page">
    <section class="solutions-hero" aria-labelledby="solutions-title">
      <Container>
        <div class="solutions-hero__grid">
          <div class="solutions-hero__content">
            <p class="page-kicker">Solutions</p>
            <h1 id="solutions-title">Find, adapt, define or build operational software</h1>
            <p>
              Quantix Software helps companies choose the right path for business operations: use an existing tool, adapt a platform, define requirements or build a custom system.
            </p>
            <div class="page-actions">
              <Button href="/en/contact/" variant="primary" size="lg">Book a consultation</Button>
              <Button href="/en/products/" variant="secondary" size="lg">View products</Button>
            </div>
          </div>

          <aside class="solutions-panel" aria-label="Solution focus areas">
            <span>Focus areas</span>
            <ul>
              {focusAreas.map((item) => <li>{item}</li>)}
            </ul>
          </aside>
        </div>
      </Container>
    </section>

    <section class="positioning-band" aria-label="Ways Quantix helps companies move forward">
      <Container>
        <div class="positioning-band__grid">
          {solutionPaths.map((item) => (
            <article class="solution-path-card">
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="solutions-section" aria-labelledby="capabilities-title">
      <Container>
        <div class="section-heading">
          <p class="page-kicker">Capabilities</p>
          <h2 id="capabilities-title">Built around operations, data and execution</h2>
          <p>
            The work is practical by design: structure the process, connect the systems, make the data usable and reduce manual effort where automation is valuable.
          </p>
        </div>

        <div class="solutions-grid">
          {solutions.map((solution) => (
            <article class="solution-card">
              <h3>{solution.title}</h3>
              <p>{solution.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="solutions-section solutions-section--surface" aria-labelledby="scoping-title">
      <Container>
        <div class="cta-panel">
          <div>
            <p class="page-kicker">Advisory</p>
            <h2 id="scoping-title">Software advisory and requirements definition</h2>
            <p>
              We can help clarify scope, modules, workflows, business rules, technical constraints, integration needs and a practical implementation path before development starts.
            </p>
          </div>
          <div class="page-actions">
            <Button href="/en/contact/" variant="primary" size="lg">Book a consultation</Button>
            <Button href="/en/work/" variant="secondary" size="lg">See experience areas</Button>
          </div>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .solutions-page {
    background: var(--bg);
    color: var(--text);
  }

  .solutions-hero {
    padding: clamp(8rem, 13vw, 10rem) 0 clamp(4rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, color-mix(in srgb, var(--primary-soft) 24%, var(--bg)) 0%, var(--bg) 76%);
  }

  .solutions-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.44fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }

  .solutions-hero__content,
  .section-heading,
  .cta-panel > div {
    min-width: 0;
  }

  .page-kicker {
    margin: 0 0 var(--space-4);
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .solutions-hero h1 {
    max-width: 54rem;
    margin: 0;
    font-size: clamp(2.55rem, 6.4vw, 5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.024em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .solutions-hero__content > p:not(.page-kicker) {
    max-width: 45rem;
    margin: var(--space-6) 0 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .solutions-panel {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .solutions-panel span {
    display: block;
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .solutions-panel ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .solutions-panel li {
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
    font-weight: 800;
  }

  .positioning-band {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .positioning-band__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .solution-path-card {
    min-width: 0;
    min-height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    overflow: hidden;
  }

  .solution-path-card h2 {
    margin: 0 0 var(--space-3);
    color: var(--text);
    font-size: var(--text-lg);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .solution-path-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .solutions-section {
    padding: clamp(4rem, 7vw, 6rem) 0;
  }

  .solutions-section--surface {
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }

  .section-heading {
    max-width: 58rem;
    margin-bottom: var(--space-10);
  }

  .section-heading h2,
  .cta-panel h2 {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .section-heading p:not(.page-kicker),
  .cta-panel p:not(.page-kicker) {
    max-width: 48rem;
    margin: var(--space-4) 0 0;
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .solution-card {
    min-width: 0;
    min-height: 100%;
    padding: clamp(1.2rem, 2.5vw, 1.6rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .solution-card h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .solution-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: clamp(2rem, 5vw, 3rem);
    border: 1px solid color-mix(in srgb, var(--primary) 10%, var(--border));
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, color-mix(in srgb, var(--surface) 94%, var(--primary-soft)), var(--surface));
  }

  .cta-panel > div {
    max-width: 46rem;
  }

  @media (max-width: 1080px) {
    .solutions-grid,
    .positioning-band__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .solutions-hero__grid,
    .positioning-band__grid {
      grid-template-columns: 1fr;
    }

    .solutions-panel {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .solutions-hero {
      padding-top: 7.5rem;
    }

    .solutions-hero h1 {
      max-width: 20rem;
      font-size: clamp(2rem, 9.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.014em;
      text-wrap: wrap;
    }

    .solutions-hero__content > p:not(.page-kicker),
    .section-heading p:not(.page-kicker),
    .cta-panel p:not(.page-kicker),
    .solution-path-card p {
      max-width: 20rem;
    }

    .page-actions,
    .cta-panel {
      flex-direction: column;
      align-items: stretch;
    }

    .page-actions :global(.btn),
    .cta-panel :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .solution-path-card,
    .solution-card,
    .solutions-panel {
      max-width: 22.5rem;
    }

    .solutions-grid {
      grid-template-columns: 1fr;
    }

    .section-heading h2,
    .cta-panel h2 {
      max-width: 20rem;
      font-size: clamp(1.8rem, 8vw, 2.35rem);
    }
  }
</style>
