---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import { products } from "../../data/products";

const positioning = [
  "Ready products",
  "Adaptable solutions",
  "Custom systems",
  "Technical guidance",
];

const operations = [
  {
    title: "Use a ready solution",
    text: "Adopt existing Quantix products and tools created to solve concrete operating needs.",
  },
  {
    title: "Adapt an existing solution",
    text: "Adjust modules, workflows, rules and integrations when an existing tool needs to fit your operation more closely.",
  },
  {
    title: "Define your idea with technical guidance",
    text: "Turn an early need into scope, priorities, modules and a realistic implementation path before investing in development.",
  },
  {
    title: "Build a custom system",
    text: "Create a new platform from the ground up when no suitable solution exists for the process, data or business model.",
  },
];

const operatingSolutions = [
  {
    title: "Restaurants and point of sale",
    text: "Run orders, tables, payments, kitchen workflows, inventory and daily restaurant operations with ready business flows.",
  },
  {
    title: "Billing and commercial control",
    text: "Centralize sales, documents, payments, customers and commercial rules for better control of the operating cycle.",
  },
  {
    title: "Inventory and operations",
    text: "Control movements, stock, traceability and repeatable tasks that keep the business running.",
  },
  {
    title: "Customers, memberships and access",
    text: "Manage profiles, memberships, permissions, validations and digital experiences for users or customers.",
  },
  {
    title: "Reporting and dashboards",
    text: "Turn operational data into clear views for tracking, decision-making and management control.",
  },
  {
    title: "Process automation",
    text: "Reduce manual steps with reliable workflows, alerts, approvals and connected tasks across teams.",
  },
  {
    title: "APIs and integrations",
    text: "Connect POS, ERP, payments, legacy systems, external services and new platforms through clear contracts.",
  },
  {
    title: "QA tools and visual evidence",
    text: "Document tests, issues and visual evidence with tools created for technical and quality teams.",
  },
];

const heroPanelSolutions = [
  "Integrated operations",
  "Customers & sales",
  "Inventory",
  "Restaurants & POS",
  "Billing",
  "Dashboards",
  "Automation",
];

const workAreas = [
  "Integrated business operations",
  "Restaurant operations",
  "Financial tools",
  "QA evidence",
  "Inventory control",
  "Billing workflows",
  "POS-related systems",
  "Reporting dashboards",
  "Automation tools",
];

const process = [
  {
    title: "Understand the operation",
    text: "We clarify workflows, constraints, users, data and the business outcome the system must support.",
  },
  {
    title: "Design the system",
    text: "We define the product structure, integrations, data model and implementation path before building.",
  },
  {
    title: "Build and integrate",
    text: "We develop the platform, tool or automation workflow with production use and maintainability in mind.",
  },
  {
    title: "Support evolution",
    text: "We help improve the system as requirements, teams and operating conditions change.",
  },
];

const getProduct = (id: string) => {
  const product = products.find((item) => item.id === id);

  if (!product) {
    throw new Error(`Product not found: ${id}`);
  }

  return product;
};

const productProof = [
  {
    product: getProduct("viggo"),
    statusLabel: "Published product",
    domain: "Quantix platform",
    railLabel: "Integrated operations",
    proofLine:
      "VIGGO is the Quantix platform for businesses that need to control customers, services, inventory, sales, payments, credentials, access, and history from one operating flow.",
    areas: [
      {
        label: "Operation",
        items: ["Customers", "Services", "Validity"],
      },
      {
        label: "Daily control",
        items: ["Sales", "Payments", "History"],
      },
      {
        label: "Inventory",
        items: ["Inventory", "Stock", "Movements"],
      },
    ],
    visitLabel: "Go to VIGGO",
  },
  {
    product: getProduct("takofy"),
    statusLabel: "Commercial platform",
    domain: "Quantix platform",
    railLabel: "Commercial platform",
    proofLine:
      "Takofy is a Quantix commercial platform for restaurant operations, built around orders, tables, payments, kitchen workflows, reporting, inventory and continuity without connection.",
    areas: [
      {
        label: "Operation",
        items: ["Orders", "Tables", "Payments"],
      },
      {
        label: "Kitchen and stock",
        items: ["Kitchen", "Inventory", "No connection"],
      },
      {
        label: "Control",
        items: ["Reporting", "Workflow clarity"],
      },
    ],
    visitLabel: "Visit Takofy",
  },
  {
    product: getProduct("nica-finanzas"),
    statusLabel: "Free Nicaragua utility",
    domain: "Free financial utility",
    railLabel: "Free utility",
    proofLine:
      "Nica Finanzas is a free financial utility created by Quantix for Nicaragua, with calculators for salary, loans and employment settlement scenarios.",
    areas: [
      {
        label: "Calculations",
        items: ["Salary", "Loans", "Settlement"],
      },
      {
        label: "Local parameters",
        items: ["Nicaragua", "Clear inputs"],
      },
      {
        label: "Outputs",
        items: ["Clear results", "Practical utilities"],
      },
    ],
    visitLabel: "Visit Nica Finanzas",
  },
  {
    product: getProduct("qavision"),
    statusLabel: "Free QA tool",
    domain: "Free QA evidence tool",
    railLabel: "Free tool",
    proofLine:
      "QAVision is a free QA evidence tool created by Quantix for visual capture, zone video recording, annotations and organized evidence workflows.",
    areas: [
      {
        label: "Capture",
        items: ["Screenshots", "Clip mode", "Video zones"],
      },
      {
        label: "Review",
        items: ["Pro Viewer", "Annotations", "Rich editing"],
      },
      {
        label: "Evidence",
        items: ["Autosave", "Folders", "Work context"],
      },
    ],
    visitLabel: "Download QAVision",
  },
];
---

<BaseLayout
  title="Ready-made, adaptable and custom business software"
  description="Quantix offers production-ready software products and tools, adapts existing solutions and builds custom systems when a company needs something unique."
  lang="en"
>
  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <Container class="home-hero__container">
        <div class="home-hero__content">
          <p class="home-kicker">Quantix Software</p>
          <h1 id="home-hero-title">Ready-made business software, adaptable and custom-built when your company needs it</h1>
          <p class="home-hero__lead">
            Find solutions already developed by Quantix, adapt an existing tool to your operation or build a system from the ground up with a specialized technical team.
          </p>
          <div class="home-actions">
            <Button href="/en/contact/" variant="primary">Evaluate my need</Button>
            <Button href="/en/products/" variant="secondary">View products</Button>
          </div>
        </div>

        <div class="hero-solutions-panel" aria-label="Quantix solutions and products">
          <div class="hero-solutions-panel__header">
            <span>Ready to adopt or adapt</span>
            <strong>Business solutions</strong>
          </div>

          <div class="hero-products">
            <a href="/en/products/viggo/">
              <span>VIGGO</span>
              <strong>Integrated operations</strong>
            </a>
            <a href="/en/products/takofy/">
              <span>Takofy</span>
              <strong>Restaurant operations</strong>
            </a>
            <a href="/en/products/nica-finanzas/">
              <span>Nica Finanzas</span>
              <strong>Free utility</strong>
            </a>
            <a href="/en/products/qavision/">
              <span>QAVision</span>
              <strong>Free QA evidence tool</strong>
            </a>
          </div>

          <div class="hero-solution-tags" aria-label="Areas Quantix can solve">
            {heroPanelSolutions.map((item) => <span>{item}</span>)}
          </div>

          <div class="hero-delivery-path">
            <div>
              <span>01</span>
              <strong>Use product</strong>
            </div>
            <div>
              <span>02</span>
              <strong>Adapt solution</strong>
            </div>
            <div>
              <span>03</span>
              <strong>Build custom</strong>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section class="positioning-strip" aria-label="Quantix Software focus areas">
      <Container>
        <ul>
          {positioning.map((item) => <li>{item}</li>)}
        </ul>
      </Container>
    </section>

    <section class="home-section home-section--solutions" aria-labelledby="solutions-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Solutions to run your company</p>
          <h2 id="solutions-title">Applications, tools and integrations for real business areas</h2>
          <p>
            Quantix does not start every conversation from a blank page. We build from products, tools and experience in concrete business workflows to accelerate decisions and execution.
          </p>
        </div>

        <div class="solutions-card-grid">
          {operatingSolutions.map((item) => (
            <article class="solution-business-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-section--surface" aria-labelledby="operations-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Delivery model</p>
          <h2 id="operations-title">Four ways to bring software into production with Quantix</h2>
          <p>
            You can adopt an existing solution, adapt it to your operation, define an idea with technical guidance or build a new system when the business requires it.
          </p>
        </div>

        <div class="delivery-model-grid">
          {operations.map((item, index) => (
            <article class="delivery-model-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="model-cta">
          <p>The goal is to choose the path with the best return: ready product when it exists, adaptation when it fits, and custom development when needed.</p>
          <Button href="/en/solutions/" variant="secondary">Explore solutions</Button>
        </div>
      </Container>
    </section>

    <section class="home-section" aria-labelledby="products-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">Products</p>
          <h2 id="products-title">Products and tools created by Quantix</h2>
          <p>
            Quantix creates its own platforms and utilities for specific operating needs, from integrated business operations and restaurant execution to financial calculations and QA evidence workflows.
          </p>
        </div>

        <div class="product-proof-stack">
          {productProof.map((proof) => (
            <article class="product-proof-card">
              <div class="product-proof-card__content">
                <div class="product-proof-card__header">
                  <span class="product-status">{proof.statusLabel}</span>
                  <span class="product-domain">{proof.domain}</span>
                </div>
                <h3>{proof.product.title.en}</h3>
                <p>{proof.proofLine}</p>
                <div class="card-actions">
                  <Button href={proof.product.href.en} variant="secondary">View product</Button>
                  {proof.product.publicUrl && (
                    <Button href={proof.product.publicUrl} target="_blank" variant="primary">
                      {proof.visitLabel}
                    </Button>
                  )}
                </div>
              </div>

              <div class="product-proof-map" aria-label={`${proof.product.title.en} product areas`}>
                <div class="product-proof-map__rail">
                  <span>{proof.railLabel}</span>
                  <strong>{proof.product.title.en}</strong>
                </div>
                <div class="product-proof-map__areas">
                  {proof.areas.map((area) => (
                    <div class="product-proof-area">
                      <span>{area.label}</span>
                      <div>
                        {area.items.map((item) => <strong>{item}</strong>)}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-section--surface" aria-labelledby="work-title">
      <Container>
        <div class="section-split section-split--reverse">
          <div class="work-panel">
            {workAreas.map((item) => <span>{item}</span>)}
          </div>

          <div class="section-heading">
            <p class="section-eyebrow">Work experience</p>
            <h2 id="work-title">Experience across operational software areas</h2>
            <p>
              Our work is organized around the types of systems businesses need to operate, control information and reduce repetitive work.
            </p>
            <div class="home-actions">
              <Button href="/en/work/" variant="secondary">View work areas</Button>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section class="home-section" aria-labelledby="process-title">
      <Container>
        <div class="section-heading section-heading--wide">
          <p class="section-eyebrow">How we work</p>
          <h2 id="process-title">From operational context to working software</h2>
        </div>

        <div class="process-grid">
          {process.map((step, index) => (
            <article class="process-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-section home-section--closing" aria-labelledby="closing-title">
      <Container>
        <div class="closing-panel">
          <div>
            <p class="section-eyebrow">Start a conversation</p>
            <h2 id="closing-title">Let&rsquo;s talk about your software need</h2>
            <p>
              Bring the operational context. We can help evaluate an existing tool, adapt a platform, define requirements or build the system that fits it.
            </p>
          </div>
          <Button href="/en/contact/" variant="primary">Contact Quantix</Button>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .home-page {
    background: var(--bg);
    color: var(--text);
  }

  .home-hero {
    padding: clamp(8rem, 13vw, 10.5rem) 0 clamp(4rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--primary-soft) 24%, var(--bg)) 0%, var(--bg) 72%);
  }

  :global(.home-hero__container) {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .home-hero__content,
  .section-heading,
  .hero-solutions-panel,
  .closing-panel > div {
    min-width: 0;
  }

  .home-kicker,
  .section-eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 50rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(2.45rem, 5.2vw, 4.1rem);
    font-weight: 780;
    line-height: 1.03;
    letter-spacing: -0.018em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .home-hero__lead {
    max-width: 46rem;
    margin: var(--space-6) 0 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.72;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-solutions-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.15rem, 2.8vw, 1.65rem);
    border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--border));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--surface) 93%, var(--primary-soft)), var(--surface));
    box-shadow: var(--shadow-lg);
  }

  .hero-solutions-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--border) 42%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--border) 42%, transparent) 1px, transparent 1px);
    background-size: 2rem 2rem;
    opacity: 0.32;
    pointer-events: none;
  }

  .hero-solutions-panel__header,
  .hero-products,
  .hero-solution-tags,
  .hero-delivery-path {
    position: relative;
    z-index: 1;
  }

  .hero-solutions-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--border-strong) 68%, transparent);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .hero-solutions-panel__header span {
    font-weight: 700;
  }

  .hero-solutions-panel__header strong {
    color: var(--text);
    font-weight: 800;
  }

  .hero-products {
    display: grid;
    gap: var(--space-3);
  }

  .hero-products a {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    min-height: 4.4rem;
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--primary) 12%, var(--border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 92%, white);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  .hero-products a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--primary) 24%, var(--border));
    background: color-mix(in srgb, var(--surface) 84%, var(--primary-soft));
  }

  .hero-products span {
    display: block;
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1.2;
  }

  .hero-products strong {
    display: block;
    color: var(--text);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .hero-solution-tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .hero-solution-tags span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.45rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
  }

  .hero-delivery-path {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--border-strong) 68%, transparent);
  }

  .hero-delivery-path div {
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--primary) 12%, var(--border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--primary-soft) 30%, var(--surface));
  }

  .hero-delivery-path span {
    display: block;
    color: var(--primary);
    font-size: var(--text-xs);
    font-weight: 900;
    line-height: 1;
  }

  .hero-delivery-path strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--text);
    font-size: var(--text-xs);
    line-height: 1.25;
  }

  .positioning-strip {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .positioning-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .positioning-strip li {
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    background: var(--surface-2);
  }

  .home-section {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
  }

  .home-section--surface {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .home-section--solutions {
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .section-heading {
    max-width: 42rem;
  }

  .section-heading--wide {
    max-width: 58rem;
    margin-bottom: var(--space-10);
  }

  .section-heading h2,
  .closing-panel h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 4.4vw, 3.35rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .section-heading p,
  .closing-panel p {
    margin: var(--space-4) 0 0;
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .editorial-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .editorial-grid--four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .solutions-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .solution-business-card,
  .delivery-model-card {
    min-width: 0;
    min-height: 100%;
    padding: clamp(1.2rem, 2.5vw, 1.6rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .solution-business-card h3,
  .delivery-model-card h3 {
    margin: 0 0 var(--space-3);
    color: var(--text);
    font-size: var(--text-lg);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .solution-business-card p,
  .delivery-model-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .delivery-model-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .delivery-model-card {
    background: var(--surface);
  }

  .delivery-model-card > span {
    display: block;
    margin-bottom: var(--space-5);
    color: var(--primary);
    font-size: var(--text-sm);
    font-weight: 900;
  }

  .model-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--primary) 12%, var(--border));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 88%, var(--primary-soft));
  }

  .model-cta p {
    max-width: 46rem;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

