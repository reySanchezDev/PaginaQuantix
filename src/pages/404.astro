---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import { notFoundContent as content } from "../data/not-found-content";
---

<BaseLayout title={content.seo.title} description={content.seo.description} locale="en" noindex>
  <section class="not-found">
    <Container narrow>
      <p class="eyebrow">{content.code}</p>
      <h1>{content.title}<br /><span lang="es">{content.titleEs}</span></h1>
      <p>
        {content.message}<br />
        <span lang="es">{content.messageEs}</span>
      </p>
      <div>
        <Button href={content.actions.en.href} hreflang="en" size="lg">
          {content.actions.en.label}
        </Button>
        <Button href={content.actions.es.href} hreflang="es" variant="secondary" size="lg">
          <span lang="es">{content.actions.es.label}</span>
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 68vh;
    place-items: center;
    padding: var(--space-20) 0;
    background: var(--color-surface);
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 8vw, 5.5rem);
  }
  p:not(.eyebrow) {
    max-width: 36rem;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
  div div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
