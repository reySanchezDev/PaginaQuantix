              <button class="mp-control mp-control-outline" type="button" data-mp-backup-action="save-settings">{en?'Save backup settings':'Guardar configuración de respaldo'}</button>
            </div>
            <div class="mp-card"><div class="mp-list-tile"><strong>{en?'Restore backup':'Restaurar Respaldo'}</strong><small>{en?'Load the database from a backup file.':'Cargar la base de datos desde un archivo.'}</small></div><button class="mp-control mp-control-outline" type="button" data-mp-backup-action="restore">{en?'Restore backup':'Restaurar respaldo'}</button></div>
            <div class="mp-card"><div class="mp-list-tile"><strong>{en?'Local backups':'Respaldos locales'}</strong><small data-mp-local-backups>{en?'No backups available':'No hay respaldos disponibles'}</small></div><button class="mp-control mp-control-outline" type="button" data-mp-backup-action="manage">{en?'View backups':'Ver respaldos'}</button></div>
            <p class="mp-inline-feedback" data-mp-backup-feedback aria-live="polite"></p>
          </section>

          <section class="mp-screen" data-mp-screen="collection" aria-label={modeLabels.collection} hidden>
            <div class="mp-section-title">{en?'Today’s collection':'Cobranza de hoy'}</div>
            <div class="mp-collection-tabs" role="tablist"><button type="button" class="is-selected" role="tab" data-mp-collection-tab="upcoming">{en?'Up to date':'Al Día'}</button><button type="button" role="tab" data-mp-collection-tab="overdue">{en?'Overdue':'Atrasados'}</button></div>
            <label class="mp-search-field"><span class="mp-sr-only">{en?'Search collection':'Buscar cobranza'}</span><input type="search" placeholder={en?'Search by name or amount...':'Buscar por nombre o monto...'} /></label>
            <div class="mp-card mp-status-list" data-mp-collection-list></div>
          </section>

          <section class="mp-screen" data-mp-screen="history" aria-label={modeLabels.history} hidden>
            <div class="mp-section-title">{en?'Payment history':'Historial de pagos'}</div>
            <div class="mp-card mp-status-list" data-mp-history-list></div>
            <div class="mp-section-title">{en?'Customer statement':'Estado de cuenta del cliente'}</div>
            <div class="mp-card mp-statement-card"><div><strong data-mp-statement-name>{en?'New customer':'Nuevo cliente'}</strong><small data-mp-statement-id></small></div><div><span>{en?'Loan balance':'Saldo del préstamo'}</span><b data-mp-statement-balance>C$ 0</b></div><div><span>{en?'Payment application':'Aplicación del pago'}</span><b data-mp-statement-application>C$ 0</b></div><button type="button" class="mp-control mp-control-outline" data-mp-statement-action>{en?'View account details':'Ver detalle de cuenta'}</button></div>
            <p class="mp-inline-feedback" data-mp-statement-feedback aria-live="polite"></p>
          </section>

          <section class="mp-screen" data-mp-screen="reports" aria-label={modeLabels.reports} hidden>
            <div class="mp-section-title">{en?'Report center':'Centro de reportes'}</div>
            <div class="mp-report-tabs"><button type="button" class="is-selected" data-mp-report-tab="realized">{en?'Realized earnings':'Ganancias Reales'}</button><button type="button" data-mp-report-tab="projected">{en?'Projection':'Proyección'}</button><button type="button" data-mp-report-tab="fx">{en?'Currency differential':'Diferencial Cambiario'}</button></div>
            <div class="mp-card mp-report-card"><div><strong>{en?'Realized earnings':'Ganancias Reales'}</strong><span data-mp-report="realized">C$ 0</span><small data-mp-report-active>{en?'Payments in selected date range':'Pagos dentro del rango seleccionado'}</small></div><div><strong>{en?'Projection':'Proyección'}</strong><span data-mp-report="projected">C$ 0</span><small>{en?'Based on active loans':'Basada en préstamos activos'}</small></div><div><strong>{en?'Currency differential':'Diferencial Cambiario'}</strong><span data-mp-report="fx">C$ 0</span><small>{en?'Exchange-rate difference':'Diferencia por tipo de cambio'}</small></div></div>
            <div class="mp-report-range"><span>{en?'Date range':'Rango de fechas'}</span><input type="date" aria-label={en?'Start date':'Fecha inicial'} data-mp-report-start /><span>—</span><input type="date" aria-label={en?'End date':'Fecha final'} data-mp-report-end /><button type="button" class="mp-control mp-control-outline" data-mp-report-action="export">{en?'Export report':'Exportar reporte'}</button></div>
            <p class="mp-inline-feedback" data-mp-report-feedback aria-live="polite"></p>
          </section>

          <section class="mp-screen" data-mp-screen="sequences" aria-label={t.sequencesTitle} hidden>
            <div class="mp-section-title">{t.sequencesTitle}</div>
            <div class="mp-card">
              <div class="mp-field">
                <label for="mp-lastLoan">{t.lastLoanGenerated}</label>
                <small>{t.nextLoanSequenceDesc}</small>
                <div class="mp-input-wrap">
                  <span>#</span>
                  <input id="mp-lastLoan" data-mp-field="lastLoan" type="text" placeholder="A-000" autocapitalize="characters" autocomplete="off"/>
                  <button class="mp-icon-button" type="button" data-mp-action="saveLoan" aria-label={t.sequenceUpdated}><svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths.save} /></svg></button>
                </div>
              </div>
              <div class="mp-divider"></div>
              <div class="mp-field">
                <label for="mp-lastReceipt">{t.lastReceiptGenerated}</label>
                <small>{t.nextReceiptSequenceDesc}</small>
                <div class="mp-input-wrap">
                  <span>#</span>
                  <input id="mp-lastReceipt" data-mp-field="lastReceipt" type="text" placeholder="R-000" autocapitalize="characters" autocomplete="off"/>
                  <button class="mp-icon-button" type="button" data-mp-action="saveReceipt" aria-label={t.receiptSequenceUpdated}><svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths.save} /></svg></button>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
      <div class="mp-bottom-gesture" aria-hidden="true"><span></span></div>
    </div>
    <span class="mp-demo-pointer" data-mp-pointer aria-hidden="true">
      <svg viewBox="0 0 28 28"><path d="M3 3v18l5.8-5.8 4.2 9 3.6-1.7-4.4-9H22z" fill="#fff" stroke="#1E3A5F" stroke-width="1.5"/></svg>
    </span>
  </div>
  <div class="mp-story-panel" data-mp-story-panel aria-hidden="true" role="status">
    <p class="mp-story-message" data-mp-story-message></p>
  </div>
  <template data-mp-i18n data-play={t.play} data-pause={t.pause} data-company={t.companyData} data-monetary={t.monetaryManagement} data-monetary-subtitle={t.monetarySubtitle} data-policy={policyText.financialTitle} data-sequences={t.sequencesTitle} data-customer-title={flowLabels.newCustomer} data-loan-title={flowLabels.newLoan} data-payment-title={flowLabels.registerPayment} data-settings-heading={journey.settingsHeading} data-customer-heading={journey.customerHeading} data-loan-heading={journey.loanHeading} data-payment-heading={journey.paymentHeading} data-story-configured={journey.configured} data-story-customer-saved={journey.customerSaved} data-story-loan-created={journey.loanCreated} data-story-completed={journey.completed} data-visible={t.visible} data-hidden={t.hidden}></template>
</section>
