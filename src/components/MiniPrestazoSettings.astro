8-4Z","badge":"M20 5h-4.18C15.4 3.84 14.3 3 13 3h-2c-1.3 0-2.4.84-2.82 2H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm-9 0h2v2h-2V5ZM5 10h14v9H5v-9Zm4 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm4 1h4v1h-4v-1Zm0 2h4v1h-4v-1Z","face":"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-3 7a1.2 1.2 0 1 1 0 2.4A1.2 1.2 0 0 1 9 9Zm6 0a1.2 1.2 0 1 1 0 2.4A1.2 1.2 0 0 1 15 9Zm-3 8c-2.4 0-4.5-1.3-5.5-3.4h11c-1 2.1-3.1 3.4-5.5 3.4Z","pin_drop":"M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 10a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z","calendar_today":"M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 16H5V9h14v11Z","note":"M19 2H5a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10l6-6V4a2 2 0 0 0-2-2ZM7 7h10v2H7V7Zm0 4h10v2H7v-2Zm0 4h6v2H7v-2Zm9 4v-4h4l-4 4Z","percent":"M6 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm12 12a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM5 21 19 3l-1.5-1.2-14 18L5 21Z"};
---
<section class="mp-demo" data-miniprestazo data-locale={en?'en':'es'} data-mp-phase-screens="company,monetary,policy,sequences,dashboard,customer,loan,payment,collection,history,reports,backup" aria-label={en?'Interactive Prestazo settings preview':'Vista interactiva de Prestazo'}>
  <div class="mp-editorial">
    <h2 class="mp-step-heading" data-mp-order-title aria-live="polite">{en?'First,':'Lo primero es'}</h2>
    <h3 data-mp-story-title aria-live="polite">{journey.settingsHeading}</h3>
    <ol class="mp-phase-list" data-mp-phase-list aria-label={en?'Demo phases':'Fases de la demostración'}>
      {(en ? ['Company data','Monetary management','Financial policy','Sequences','Dashboard','New customer','New loan','Register payment','To Collect','Payment History','Reports','Scheduled Backup'] : ['Configurar tu empresa','Gestión monetaria','Política financiera','Consecutivos','Revisar tu cartera','Crear tu primer cliente','Gestionarle un préstamo','Registrar un pago','A cobrar','Historial de pagos','Reportes','Respaldo programado']).map((label, index) => (
        <li data-mp-phase-item data-mp-phase-index={index}><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong></li>
      ))}
    </ol>
    <div class="mp-actions">
      <button class="mp-control mp-control-primary" type="button" data-mp-play aria-pressed="false">
        <svg data-mp-play-icon aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
        <svg data-mp-pause-icon aria-hidden="true" viewBox="0 0 24 24" style="display:none"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor"/></svg>
      </button>
      <button class="mp-control mp-control-outline" type="button" data-mp-back aria-label={en?'Go back 3 seconds':'Retroceder 3 segundos'} title={en?'Go back 3 seconds':'Retroceder 3 segundos'}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M11 6 5 12l6 6M5 12h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="mp-control mp-control-outline" type="button" data-mp-next aria-label={en?'Advance 3 seconds':'Adelantar 3 segundos'} title={en?'Advance 3 seconds':'Adelantar 3 segundos'}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m13 6 6 6-6 6m6-6H5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="mp-control mp-control-outline" type="button" data-mp-reset aria-label={en?'Restart demo':'Reiniciar demo'} title={en?'Restart demo':'Reiniciar demo'}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7M3 3v6h6" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
      </button>
    </div>
    <nav class="mp-mode-navigation" aria-label={en?'Prestazo navigation':'Navegación de Prestazo'} data-mp-navigation>
      <button type="button" class="is-active" data-mp-nav="dashboard">{modeLabels.dashboard}</button>
      <button type="button" data-mp-nav="company">{modeLabels.settings}</button>
      <button type="button" data-mp-nav="customer">{modeLabels.customers}</button>
      <button type="button" data-mp-nav="loan">{modeLabels.loans}</button>
      <button type="button" data-mp-nav="payment">{modeLabels.payments}</button>
      <button type="button" data-mp-nav="backup">{modeLabels.backup}</button>
      <button type="button" data-mp-nav="collection">{modeLabels.collection}</button>
      <button type="button" data-mp-nav="history">{modeLabels.history}</button>
      <button type="button" data-mp-nav="reports">{modeLabels.reports}</button>
    </nav>
  </div>

  <div class="mp-stage">
    <div class="mp-device">
      <div class="mp-statusbar" aria-hidden="true"><span>9:41</span><span class="mp-camera"></span><span>◢ ▰ 100%</span></div>
      <div class="mp-appbar"><div class="mp-appbar-copy"><strong data-mp-app-title>{t.companyData}</strong><small data-mp-app-subtitle hidden></small></div></div>
      <div class="mp-app-scroll" data-mp-scroll>
        <div class="mp-app-inner">
          <nav class="mp-mode-navigation mp-device-navigation" aria-label={en?'Prestazo navigation':'NavegaciÃ³n de Prestazo'} data-mp-navigation>
            <button type="button" class="is-active" data-mp-nav="dashboard">{modeLabels.dashboard}</button>
            <button type="button" data-mp-nav="company">{modeLabels.settings}</button>
            <button type="button" data-mp-nav="customer">{modeLabels.customers}</button>
            <button type="button" data-mp-nav="loan">{modeLabels.loans}</button>
            <button type="button" data-mp-nav="payment">{modeLabels.payments}</button>
            <button type="button" data-mp-nav="backup">{modeLabels.backup}</button>
            <button type="button" data-mp-nav="collection">{modeLabels.collection}</button>
            <button type="button" data-mp-nav="history">{modeLabels.history}</button>
            <button type="button" data-mp-nav="reports">{modeLabels.reports}</button>
          </nav>
          <section class="mp-screen" data-mp-screen="company" aria-label={t.companyData} hidden>
            <div class="mp-info mp-company-info"><svg class="mp-info-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 11v6"/><path d="M12 7h.01"/></svg><span>{t.companyInfoHelp}</span></div>
            <div class="mp-section-title">{t.identity}</div>
            <div class="mp-field">
              <label for="mp-country">{t.countryOfOperation}</label>
              <div class="mp-input-wrap">
                <svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths.public} /></svg>
                <input id="mp-country" data-mp-field="country" data-mp-country readonly placeholder={t.selectCountry} />
              </div>
            </div>
            {companyGroups.map(group=><>
              <div class="mp-company-group">
                {group[0]!=='identity' && <div class="mp-section-title">{t[group[0] as keyof typeof t]}</div>}
                {group[1].map(field=><div class="mp-company-field">
                  <div class="mp-field">
                    <label for={'mp-'+field[0]}>{t[field[0] as keyof typeof t]}</label>
                    <div class="mp-input-wrap">
                      <svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths[field[1] as keyof typeof iconPaths]}/></svg>
                      <input id={'mp-'+field[0]} data-mp-field={field[0]} type={['phoneFixed','cellPhone','whatsapp'].includes(field[0])?'tel':'text'} autocomplete="off"/>
                    </div>
                  </div>
                  <label class="mp-visibility">
                    <input type="checkbox" data-mp-toggle={field[0]}/>
                    <span class="mp-switch" aria-hidden="true"></span>
                    <small data-mp-visible-label={field[0]}>{t.hidden}</small>
                  </label>
                </div>)}
              </div>
            </>)}
            <div class="mp-section-title">{t.branding}</div>
            <div class="mp-company-field">
              <div class="mp-field">
                <label for="mp-logoPath">{t.logoPath}</label>
                <div class="mp-input-wrap">
                  <svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths.image} /></svg>
                  <input id="mp-logoPath" readonly placeholder={t.selectFile} data-mp-field="logoPath"/>
                </div>
              </div>
              <label class="mp-visibility">
                <input type="checkbox" data-mp-toggle="logoPath"/>
                <span class="mp-switch" aria-hidden="true"></span>
                <small data-mp-visible-label="logoPath">{t.hidden}</small>
              </label>
            </div>
            <button class="mp-save-button" data-mp-action="saveCompany" type="button">{t.saveChanges}</button>
            <p class="mp-inline-feedback" data-mp-settings-feedback aria-live="polite"></p>
          </section>

          <section class="mp-screen" data-mp-screen="monetary" aria-label={t.monetaryManagement} hidden>
            <div class="mp-section-title">{t.baseConfiguration}</div>
            <div class="mp-card">
              <label class="mp-select-tile mp-currency-tile">
                <span>{t.baseCurrency}<small data-mp-currency-value>C$ (NIO)</small></span>
                <select data-mp-field="currency" aria-label={t.baseCurrency}>
                  <option value="NIO">C$ (NIO)</option>
                  <option value="USD">$ (USD)</option>
                </select>
                <svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths.chevron_right} /></svg>
              </label>
              <small class="mp-currency-desc">{t.baseCurrencyDesc}</small>
              <div class="mp-divider"></div>
              <div class="mp-field mp-money-field">
                <label for="mp-capital">{t.availableCapital}</label>
                <div class="mp-input-wrap">
                  <span data-mp-currency-symbol>C$</span>
                  <input id="mp-capital" data-mp-field="capital" inputmode="numeric" type="text" placeholder="0" autocomplete="off"/>
                  <button type="button" data-mp-action="saveCapital" class="mp-icon-button" aria-label={t.capitalSaved}>
                    <svg class="mp-svg-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d={iconPaths.save} /></svg>
                  </button>
                </div>
                <small>{t.availableCapitalDesc}</small>
              </div>
              <div class="mp-divider"></div>
              <label class="mp-switch-tile">
                <span>{t.validateCapital}<small>{t.validateCapitalDesc}</small></span>
                <input type="checkbox" data-mp-toggle="validateCapital"/>
                <span class="mp-switch" aria-hidden="true"></span>
              </label>
              <div class="mp-divider"></div>
              <div class="mp-field">
                <label for="mp-priority">{t.recoveryPriority}</label>
                <select id="mp-priority" data-mp-field="priority">
                  <option value="CAPITAL_FIRST">{t.prioritizeCapital}</option>
                  <option value="INTEREST_FIRST">{t.prioritizeInterest}</option>
                </select>
              </div>
            </div>
            <div class="mp-section-title">{t.currencyCenter}</div>
            <div class="mp-card">
              <div class="mp-list-tile"><strong>{t.manageExchangeRates}</strong><small>{t.currencyMaster}</small></div>
              <div class="mp-divider"></div>
              <label class="mp-switch-tile">
                <span>{t.contractRatePolicy}<small>{t.contractRatePolicyDesc}</small></span>
                <input type="checkbox" data-mp-toggle="contractRatePolicy"/>
                <span class="mp-switch" aria-hidden="true"></span>
              </label>
