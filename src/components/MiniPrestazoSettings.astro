const {en=false}=Astro.props;
const policyText = en ? { financialTitle:'Financial Convention', financialInfo:'This setting defines how interest is calculated. Existing loans keep their original policy.', dayConvention:'Day Count Convention', daysMonth:'Days per Month', daysYear:'Days per Year', proration:'Proration Rule', roundPolicy:'Rounding Policy', roundDecimals:'Decimals', roundMode:'Mode', calcTitle:'Calculation preview', savePolicy:'Save configuration' } : { financialTitle:'ConvenciÃ³n Financiera', financialInfo:'Esta configuraciÃ³n define cÃ³mo se calculan los intereses. Los prÃ©stamos existentes mantienen su polÃ­tica original.', dayConvention:'ConvenciÃ³n de Conteo de DÃ­as', daysMonth:'DÃ­as por Mes', daysYear:'DÃ­as por AÃ±o', proration:'Regla de Prorrateo', roundPolicy:'PolÃ­tica de Redondeo', roundDecimals:'Decimales', roundMode:'Modo', calcTitle:'Vista Previa del CÃ¡lculo', savePolicy:'Guardar ConfiguraciÃ³n' };
const locale= en ? {"settings":"Settings","companyData":"Company Data","identity":"Identity","countryOfOperation":"Country of Operation","selectCountry":"Select a country","companyName":"Company Name","rucId":"TAX ID / Identification","contact":"Contact","phoneFixed":"Landline","cellPhone":"Mobile","whatsapp":"WhatsApp","location":"Location","address":"Address","branding":"Branding","logoPath":"Logo Path (PNG)","selectFile":"Select file...","visible":"Visible","hidden":"Hidden","companyInfoHelp":"Toggle the switch to show this data on receipts and reports.","saveChanges":"Save Changes","monetaryManagement":"Monetary Management","monetarySubtitle":"Currencies, Capital & Exchange Rates","baseConfiguration":"Base Configuration","baseCurrency":"Base Currency","baseCurrencyDesc":"Main currency for calculations and reports","availableCapital":"Capital available for lending","availableCapitalDesc":"Maximum amount available for lending","capitalSaved":"Capital saved","validateCapital":"Validate working capital","validateCapitalDesc":"Loan amount will be validated against available limits","recoveryPriority":"Recovery Priority","prioritizeCapital":"Prioritize Principal (Recommended)","prioritizeInterest":"Prioritize Overdue Interest","currencyCenter":"Currency Center","manageExchangeRates":"Manage exchange rates","currencyMaster":"Exchange Rate Master","contractRatePolicy":"Contract Rate Policy","contractRatePolicyDesc":"Allow manual exchange rate modification when creating a loan","reportConsolidation":"Report Consolidation","presentationCurrency":"Presentation Currency","sequencesTitle":"Sequences","lastLoanGenerated":"Last Loan Generated","nextLoanSequenceDesc":"The next loan will follow this sequence","lastReceiptGenerated":"Last Receipt Generated","nextReceiptSequenceDesc":"The next receipt will follow this sequence","sequenceUpdated":"Sequence updated","receiptSequenceUpdated":"Receipt sequence updated"} : {"settings":"Configuraciones","companyData":"Datos de la Empresa","identity":"Identidad","countryOfOperation":"País de Operación","selectCountry":"Seleccione un país","companyName":"Nombre de la Empresa","rucId":"RUC / Identificación","contact":"Contacto","phoneFixed":"Teléfono Fijo","cellPhone":"Celular","whatsapp":"WhatsApp","location":"Ubicación","address":"Dirección","branding":"Branding","logoPath":"Ruta del Logo (PNG)","selectFile":"Seleccione archivo...","visible":"Visible","hidden":"Oculto","companyInfoHelp":"Activa el interruptor para mostrar el dato en los recibos y reportes.","saveChanges":"Guardar Cambios","monetaryManagement":"Gestión Monetaria","monetarySubtitle":"Monedas, Capital y Tasas de Cambio","baseConfiguration":"Configuración Base","baseCurrency":"Moneda Base","baseCurrencyDesc":"Moneda principal para cálculos y reportes","availableCapital":"Capital disponible para prestar","availableCapitalDesc":"Monto máximo que tienes disponible para préstamos","capitalSaved":"Capital guardado","validateCapital":"Validar capital de trabajo","validateCapitalDesc":"Se validará que el monto del préstamo no exceda el saldo disponible","recoveryPriority":"Prioridad en Recuperación","prioritizeCapital":"Priorizar Capital (Recomendado)","prioritizeInterest":"Priorizar Interés Vencido","currencyCenter":"Centro de Divisas","manageExchangeRates":"Gestionar tasas de cambio","currencyMaster":"Maestro de tasas de compra y venta","contractRatePolicy":"Política de Tasa en Contrato","contractRatePolicyDesc":"Permitir modificar la tasa de cambio al crear un préstamo","reportConsolidation":"Consolidación de Reportes","presentationCurrency":"Moneda de Visualización","sequencesTitle":"Consecutivos","lastLoanGenerated":"Último Préstamo Generado","nextLoanSequenceDesc":"El próximo préstamo será el siguiente en la secuencia","lastReceiptGenerated":"Último Recibo Generado","nextReceiptSequenceDesc":"El próximo recibo será el siguiente en la secuencia","sequenceUpdated":"Consecutivo actualizado","receiptSequenceUpdated":"Consecutivo de recibos 