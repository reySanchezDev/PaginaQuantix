---
interface Props {
  tone?: "neutral" | "accent";
  class?: string;
}

const { tone = "neutral", class: className } = Astro.props as Props;
---

<span class:list={["badge", `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: 1.2;
  }

  .badge--accent {
    border-color: transparent;
    background: var(--product-soft, var(--color-primary-soft));
    color: var(--product-accent, var(--color-primary));
  }
</style>
