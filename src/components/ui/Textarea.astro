---
interface Props extends astroHTML.JSX.TextareaHTMLAttributes {
  label: string;
  error?: string;
  hint?: string;
}

const { label, error, hint, id, required, ...attributes } = Astro.props as Props;
const textareaId = id ?? `textarea-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const descriptionId = error || hint ? `${textareaId}-description` : undefined;
---

<label class="field" for={textareaId}>
  <span>{label}{required && <span aria-hidden="true"> *</span>}</span>
  <textarea
    {...attributes}
    id={textareaId}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={descriptionId}></textarea>
  {
    (error || hint) && (
      <small id={descriptionId} class:list={{ error }} role={error ? "alert" : undefined}>
        {error ?? hint}
      </small>
    )
  }
</label>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
    color: var(--color-ink);
    font-weight: 700;
  }
  textarea {
    min-height: 8rem;
    resize: vertical;
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  small {
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  small.error {
    color: var(--color-danger);
  }
</style>
