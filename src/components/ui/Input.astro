---
interface Props extends Omit<astroHTML.JSX.InputHTMLAttributes, "size"> {
  label: string;
  error?: string;
  hint?: string;
}

const { label, error, hint, id, required, ...attributes } = Astro.props as Props;
const inputId = id ?? `input-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const descriptionId = error || hint ? `${inputId}-description` : undefined;
---

<label class="field" for={inputId}>
  <span>{label}{required && <span aria-hidden="true"> *</span>}</span>
  <input
    {...attributes}
    id={inputId}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={descriptionId}
  />
  {
    (error || hint) && (
      <small id={descriptionId} class:list={{ error }} role={error ? "alert" : undefined}>
        {error ?? hint}
      </small>
    )
  }
</label>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
    color: var(--color-ink);
    font-weight: 700;
  }
  input {
    min-height: 3rem;
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  small {
    color: var(--color-ink-muted);
    font-weight: 500;
  }
  small.error {
    color: var(--color-danger);
  }
</style>
