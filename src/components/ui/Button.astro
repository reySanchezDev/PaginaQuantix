---
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "link";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  target?: "_self" | "_blank";
  disabled?: boolean;
  loading?: boolean;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: className,
  target,
  disabled = false,
  loading = false,
  ...attributes
} = Astro.props as Props;

const isDisabled = disabled || loading;
const Element = href ? "a" : "button";
const safeHref = href && !isDisabled ? href : undefined;
---

<Element
  href={safeHref}
  type={!href ? type : undefined}
  target={safeHref ? target : undefined}
  rel={safeHref && target === "_blank" ? "noopener noreferrer" : undefined}
  class:list={["button", `button--${variant}`, `button--${size}`, className]}
  disabled={!href && isDisabled}
  aria-disabled={isDisabled || undefined}
  aria-busy={loading || undefined}
  tabindex={href && isDisabled ? -1 : undefined}
  {...attributes}
>
  {loading && <span class="button__spinner" aria-hidden="true" />}
  <slot />
</Element>

<style>
  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .button:hover:not([aria-disabled="true"]) {
    transform: translateY(-1px);
  }

  .button[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .button--primary {
    background: var(--color-primary);
    box-shadow: var(--shadow-sm);
    color: var(--color-surface);
  }

  .button--primary:hover:not([aria-disabled="true"]) {
    background: var(--color-primary-hover);
    box-shadow: var(--shadow-md);
  }

  .button--secondary {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .button--secondary:hover:not([aria-disabled="true"]),
  .button--ghost:hover:not([aria-disabled="true"]) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .button--ghost {
    border-color: transparent;
    background: transparent;
    color: var(--color-ink-muted);
  }

  .button--link {
    min-height: auto;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-primary);
  }

  .button--link:hover:not([aria-disabled="true"]) {
    text-decoration: underline;
    transform: none;
  }

  .button--sm {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  .button--md {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-base);
  }
  .button--lg {
    min-height: 3.5rem;
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-lg);
  }

  .button__spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
</style>
