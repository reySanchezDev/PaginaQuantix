---
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "link";
  tone?: "default" | "inverse";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  target?: "_self" | "_blank";
  hreflang?: string;
  disabled?: boolean;
  loading?: boolean;
}

const {
  variant = "primary",
  tone = "default",
  size = "md",
  href,
  type = "button",
  class: className,
  target,
  hreflang,
  disabled = false,
  loading = false,
  ...attributes
} = Astro.props as Props;

const isDisabled = disabled || loading;
const Element = href ? "a" : "button";
const safeHref = href && !isDisabled ? href : undefined;
---

<Element
  href={safeHref}
  type={!href ? type : undefined}
  target={safeHref ? target : undefined}
  rel={safeHref && target === "_blank" ? "noopener noreferrer" : undefined}
  hreflang={safeHref ? hreflang : undefined}
  class:list={[
    "button",
    `button--${variant}`,
    `button--${size}`,
    { "button--inverse": tone === "inverse" },
    className,
  ]}
  disabled={!href && isDisabled}
  aria-disabled={isDisabled || undefined}
  aria-busy={loading || undefined}
  tabindex={href && isDisabled ? -1 : undefined}
  {...attributes}
>
  {loading && <span class="button__spinner" aria-hidden="true" />}
  <slot />
</Element>

<style>
  .button {
    display: inline-flex;
    min-height: 2.875rem;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid var(--button-border, transparent);
    background: var(--button-bg);
    color: var(--button-fg);
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      transform var(--motion-feedback) var(--motion-ease-out);
  }
  .button[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .button--primary {
    --button-bg: var(--color-primary);
    --button-fg: var(--color-inverse);
    --button-hover-bg: var(--color-primary-hover);
  }
  .button--secondary {
    --button-border: var(--color-control-border);
    --button-bg: transparent;
    --button-fg: var(--color-ink);
    --button-hover-bg: var(--color-surface-muted);
    --button-hover-border: var(--color-ink);
  }
  .button--ghost {
    --button-bg: transparent;
    --button-fg: var(--color-ink-muted);
    --button-hover-bg: var(--color-surface-muted);
    --button-hover-border: var(--color-ink);
  }
  .button--link {
    --button-bg: transparent;
    --button-fg: var(--color-ink);
    --button-hover-fg: var(--color-primary);
    padding: 0;
    border-radius: 0;
  }
  .button--inverse {
    --color-focus: var(--color-inverse);
  }
  .button--inverse.button--primary {
    --button-bg: var(--color-inverse);
    --button-fg: var(--color-primary-hover);
    --button-hover-bg: var(--color-canvas);
  }
  .button--inverse:is(.button--secondary, .button--ghost) {
    --button-fg: var(--color-inverse);
    --button-hover-bg: var(--color-primary-hover);
    --button-hover-border: var(--color-inverse);
  }
  .button--inverse.button--secondary {
    --button-border: var(--color-inverse);
  }
  .button--inverse.button--link {
    --button-fg: var(--color-inverse);
    --button-hover-fg: var(--color-inverse);
  }
  .button:is(:hover, :focus-visible):not([aria-disabled="true"]) {
    background: var(--button-hover-bg, var(--button-bg));
    color: var(--button-hover-fg, var(--button-fg));
    border-color: var(--button-hover-border, var(--button-border, transparent));
  }
  .button--link:is(:hover, :focus-visible):not([aria-disabled="true"]) {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .button:active:not([aria-disabled="true"]) {
    filter: brightness(0.95);
  }
  .button--sm {
    padding: 0.6rem 1rem;
  }
  .button--md {
    padding: 0.8rem 1.4rem;
  }
  .button--lg {
    min-height: 3.25rem;
    padding: 0.875rem 1.5rem;
    font-size: var(--text-base);
  }
  .button__spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) and (pointer: fine) {
      .button:not(.button--link):hover:not([aria-disabled="true"]) {
        transform: translateY(-2px);
      }
    }
    .button:not(.button--link):active:not([aria-disabled="true"]) {
      transform: translateY(0) scale(0.98);
      transition-duration: 100ms;
    }
  }
  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
</style>
