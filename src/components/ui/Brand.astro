---
import { getRoute } from "../../i18n/routes";
import type { Locale } from "../../types/site";
import { sharedUi } from "../../data/navigation";

interface Props {
  locale: Locale;
  compact?: boolean;
  inverse?: boolean;
}

const { locale, compact = false, inverse = false } = Astro.props as Props;
const markStart = inverse ? "#f4a47d" : "#123f46";
const markEnd = inverse ? "#f2f4f1" : "#a94f2f";
---

<a
  class:list={["brand", { "brand--compact": compact }]}
  href={getRoute("home", locale)}
  aria-label={sharedUi[locale].brandHome}
>
  <span class="brand__mark" aria-hidden="true">
    <svg viewBox="0 0 100 100" role="presentation">
      <g transform="translate(6 6) scale(3.6)">
        <path
          d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
          fill="none"
          stroke={markStart}
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"></path>
        <path
          d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
          fill="none"
          stroke={markEnd}
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"></path>
      </g>
    </svg>
  </span>
  <span>Quantix</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 680;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .brand__mark {
    width: 2.15rem;
    height: 2.15rem;
    flex: 0 0 auto;
  }

  .brand__mark svg {
    width: 100%;
    height: 100%;
  }

  .brand--compact .brand__mark {
    width: 2rem;
    height: 2rem;
  }
</style>
