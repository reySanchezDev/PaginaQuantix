---
import { getRoute } from "../../i18n/routes";
import type { Locale } from "../../types/site";
import { sharedUi } from "../../data/navigation";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props as Props;
---

<a
  class:list={["brand", { "brand--compact": compact }]}
  href={getRoute("home", locale)}
  aria-label={sharedUi[locale].brandHome}
>
  <span class="brand__mark" aria-hidden="true">
    <svg viewBox="0 0 100 100" role="presentation">
      <g transform="translate(6 6) scale(3.6)">
        <path
          class="brand__link brand__link--one"
          d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"></path>
        <path
          class="brand__link brand__link--two"
          d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"></path>
      </g>
    </svg>
  </span>
  <span>Quantix</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand__mark {
    width: 2.15rem;
    height: 2.15rem;
    flex: 0 0 auto;
  }

  .brand__mark svg {
    width: 100%;
    height: 100%;
  }

  .brand__link--one {
    stroke: var(--brand-mark-start, #0a3d36);
  }

  .brand__link--two {
    stroke: var(--brand-mark-end, #2f8c78);
  }

  .brand--compact .brand__mark {
    width: 2rem;
    height: 2rem;
  }
</style>
