---
import { getRoute } from "../../i18n/routes";
import type { Locale } from "../../types/site";
import { sharedUi } from "../../data/navigation";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props as Props;
---

<a
  class:list={["brand", { "brand--compact": compact }]}
  href={getRoute("home", locale)}
  aria-label={sharedUi[locale].brandHome}
>
  <span class="brand__mark" aria-hidden="true">Q</span>
  <span>Quantix</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand__mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-dark);
    color: var(--color-inverse);
    font-size: 1rem;
    font-weight: 600;
  }

  .brand--compact .brand__mark {
    width: 1.8rem;
    height: 1.8rem;
    font-size: 0.9rem;
  }
</style>
