---
import type { Locale } from "../../types/site";
import { getRoute } from "../../i18n/routes";
import { sharedUi } from "../../data/navigation";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const label = sharedUi[locale].brandHome;
---

<a
  class:list={["brand", { "brand--compact": compact }]}
  href={getRoute("home", locale)}
  aria-label={label}
>
  <img src="/favicon.svg" width={compact ? 28 : 32} height={compact ? 28 : 32} alt="" />
  <span>Quantix</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .brand--compact {
    font-size: var(--text-lg);
  }

  .brand img {
    flex: 0 0 auto;
  }
</style>
