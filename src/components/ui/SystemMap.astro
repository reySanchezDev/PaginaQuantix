---
import type { SystemMapContent } from "../../types/site";

interface Props {
  content: SystemMapContent;
}

const { content } = Astro.props as Props;
---

<div class="system-map" aria-hidden="true">
  <div class="system-map__bar">
    <span>{content.label}</span>
    <span class="system-map__status"><i></i>{content.status}</span>
  </div>
  <div class="system-map__canvas">
    <svg viewBox="0 0 520 460" role="presentation">
      <path class="route route--base" d="M260 230 116 105"></path>
      <path class="route route--base" d="M260 230 404 105"></path>
      <path class="route route--base" d="M260 230 116 355"></path>
      <path class="route route--base" d="M260 230 404 355"></path>

      <path class="route route--signal route--one" pathLength="1" d="M260 230 116 105"></path>
      <path class="route route--signal route--two" pathLength="1" d="M260 230 404 105"></path>
      <path class="route route--signal route--three" pathLength="1" d="M260 230 116 355"></path>
      <path class="route route--signal route--four" pathLength="1" d="M260 230 404 355"></path>
    </svg>
    <div class="system-map__core">
      <span>Quantix</span>
      <small>{content.core}</small>
    </div>
    {
      content.items.slice(0, 4).map((item, index) => (
        <div class:list={["system-map__node", `system-map__node--${index + 1}`]}>
          <small>{item.area}</small>
          <strong>{item.name}</strong>
        </div>
      ))
    }
  </div>
  <div class="system-map__stream">
    <span>{content.stream}</span>
    <span class="system-map__meter"><i></i><i></i><i></i><i></i><i></i></span>
  </div>
</div>

<style>
  .system-map {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(242 244 241 / 0.2);
    background: var(--color-dark-deep);
    box-shadow: var(--shadow-lg);
    color: var(--color-inverse);
    isolation: isolate;
  }
  .system-map::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(242 244 241 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(242 244 241 / 0.045) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 88%);
  }
  .system-map::after {
    position: absolute;
    inset: 0 auto auto 0;
    width: 5rem;
    height: 0.25rem;
    background: var(--color-accent);
    content: "";
  }
  .system-map__bar,
  .system-map__stream {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-inline: var(--space-5);
    color: var(--color-inverse-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .system-map__bar {
    border-bottom: 1px solid rgb(242 244 241 / 0.14);
  }
  .system-map__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .system-map__status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-focus-inverse);
    box-shadow: 0 0 0 0.25rem rgb(244 164 125 / 0.12);
    animation: status-pulse 3s ease-in-out infinite;
  }
  .system-map__canvas {
    --node-edge: 11%;
    position: relative;
    aspect-ratio: 520 / 460;
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .route {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .route--base {
    stroke: rgb(242 244 241 / 0.18);
    stroke-width: 1;
  }
  .route--signal {
    stroke: var(--color-focus-inverse);
    stroke-width: 2;
    stroke-linecap: square;
    stroke-dasharray: 0.05 0.95;
    animation: route-flow 4.8s linear infinite;
  }
  .route--two {
    animation-delay: -1.2s;
  }
  .route--three {
    animation-delay: -2.4s;
  }
  .route--four {
    animation-delay: -3.6s;
  }
  .system-map__core,
  .system-map__node {
    position: absolute;
    display: grid;
    align-content: center;
    border: 1px solid rgb(242 244 241 / 0.24);
    background: var(--color-dark-raised);
  }

  .system-map__core {
    inset: 50% auto auto 50%;
    width: 9rem;
    aspect-ratio: 1;
    padding: var(--space-4);
    box-shadow: 0 0 0 0.5rem rgb(244 164 125 / 0.06);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .system-map__core::after {
    position: absolute;
    inset: 0.55rem;
    border: 1px solid rgb(244 164 125 / 0.22);
    content: "";
  }

  .system-map__core span {
    color: var(--color-inverse);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .system-map__core small,
  .system-map__node small {
    color: var(--color-inverse-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .system-map__node {
    width: 8.5rem;
    min-height: 4.5rem;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    animation: node-enter 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .system-map__node strong {
    color: var(--color-inverse);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .system-map__node--1 {
    inset: var(--node-edge) auto auto 5%;
    animation-delay: 380ms;
  }

  .system-map__node--2 {
    inset: var(--node-edge) 5% auto auto;
    animation-delay: 500ms;
  }

  .system-map__node--3 {
    inset: auto auto var(--node-edge) 5%;
    animation-delay: 620ms;
  }

  .system-map__node--4 {
    inset: auto 5% var(--node-edge) auto;
    animation-delay: 740ms;
  }

  .system-map__stream {
    border-top: 1px solid rgb(242 244 241 / 0.14);
  }

  .system-map__meter {
    display: flex;
    align-items: end;
    gap: 0.2rem;
  }

  .system-map__meter i {
    width: 0.2rem;
    height: 0.8rem;
    background: var(--color-focus-inverse);
    transform-origin: bottom;
    animation: meter 1.5s ease-in-out infinite alternate;
  }

  .system-map__meter i:nth-child(2) {
    height: 1.15rem;
    animation-delay: -0.7s;
  }

  .system-map__meter i:nth-child(3) {
    height: 0.55rem;
    animation-delay: -1.1s;
  }

  .system-map__meter i:nth-child(4) {
    height: 0.95rem;
    animation-delay: -0.35s;
  }

  .system-map__meter i:nth-child(5) {
    height: 0.65rem;
    animation-delay: -0.9s;
  }

  @keyframes route-flow {
    to {
      stroke-dashoffset: -1;
    }
  }

  @keyframes node-enter {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @keyframes status-pulse {
    50% {
      opacity: 0.55;
    }
  }

  @keyframes meter {
    to {
      transform: scaleY(0.35);
    }
  }

  @media (max-width: 32rem) {
    .system-map__bar,
    .system-map__stream {
      padding-inline: var(--space-4);
    }
    .system-map__core {
      width: 6.5rem;
    }
    .system-map__node {
      width: 6.75rem;
      min-height: 3.5rem;
      padding: var(--space-2) var(--space-3);
    }
    .system-map__canvas {
      --node-edge: 9%;
      min-height: 18rem;
    }
  }
</style>
