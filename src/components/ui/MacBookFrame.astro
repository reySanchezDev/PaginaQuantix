---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
}
const { src, alt, width, height } = Astro.props;
---

<div class="macbook">
  <div class="macbook-lid">
    <div class="macbook-display">
      <img {src} {alt} {width} {height} fetchpriority="high" decoding="async" />
      <span class="macbook-camera" aria-hidden="true"></span>
    </div>
  </div>
  <div class="macbook-base" aria-hidden="true">
    <span class="macbook-keyboard"></span>
    <span class="macbook-trackpad"></span>
  </div>
  <div class="macbook-edge" aria-hidden="true"></div>
</div>

<style>
  .macbook {
    position: relative;
    padding-bottom: 6.5%;
    filter: drop-shadow(0 1.25rem 1.25rem rgb(60 17 9 / 0.3));
  }
  .macbook-lid {
    position: relative;
    width: 91%;
    margin-inline: auto;
    padding: 1.1% 1.1% 1.8%;
    border: 1px solid #b6b8bb;
    border-radius: 3% 3% 1% 1% / 4.5% 4.5% 1.5% 1.5%;
    background: #17191c;
    box-shadow: inset 0 0 0 1px #45484b;
  }
  .macbook-display {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.7;
    border-radius: 1.5% 1.5% 0 0;
    background: #edf2f9;
  }
  .macbook-display img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the complete dashboard content; crop the navigation sidebar. */
    object-position: top right;
  }
  .macbook-camera {
    position: absolute;
    top: 0;
    left: 44%;
    width: 12%;
    height: 4%;
    border-radius: 0 0 15% 15% / 0 0 65% 65%;
    background: #17191c;
  }
  .macbook-camera::after {
    content: "";
    position: absolute;
    top: 24%;
    left: 47%;
    width: 6%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #26313e;
  }
  .macbook-base {
    position: absolute;
    inset: auto 0 1.2%;
    height: 10%;
    clip-path: polygon(4.5% 0, 95.5% 0, 100% 100%, 0 100%);
    background: linear-gradient(#b2b5b9, #e4e5e7 75%, #bfc2c5);
  }
  .macbook-keyboard {
    position: absolute;
    inset: 10% 15% 48%;
    border-radius: 2px;
    background:
      repeating-linear-gradient(90deg, transparent 0 6%, #a4a7ac 6% 6.5%),
      repeating-linear-gradient(#34373b 0 2px, #a4a7ac 2px 3px);
    transform: perspective(80px) rotateX(18deg);
  }
  .macbook-trackpad {
    position: absolute;
    inset: 60% 40% 8%;
    border: 1px solid rgb(86 91 97 / 0.25);
    border-radius: 2px;
  }
  .macbook-edge {
    position: absolute;
    inset: auto 0 0;
    height: 1.5%;
    border-radius: 0 0 4% 4% / 0 0 100% 100%;
    background: linear-gradient(90deg, #93979b, #eceef0 8%, #b7babd 50%, #eceef0 92%, #93979b);
    box-shadow: 0 1px 0 #777c81;
  }
  .macbook-edge::after {
    content: "";
    position: absolute;
    inset: 0 43% 35%;
    border-radius: 0 0 30% 30% / 0 0 100% 100%;
    background: #92969b;
  }
</style>
