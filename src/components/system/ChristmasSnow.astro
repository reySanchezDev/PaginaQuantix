---
import type { Locale } from "../../types/site";
interface Props {
  locale: Locale;
}
const es = Astro.props.locale === "es";
---

<canvas class="christmas-snow" data-christmas-snow aria-hidden="true" hidden></canvas>
<button
  class="christmas-snow-toggle"
  data-snow-toggle
  data-pause={es ? "Pausar nieve" : "Pause snow"}
  data-resume={es ? "Activar nieve" : "Enable snow"}
  type="button"
  aria-pressed="false"
  hidden
  ><span aria-hidden="true">❄</span><span data-snow-label>{es ? "Pausar nieve" : "Pause snow"}</span
  ></button
>
<style>
  .christmas-snow {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 70;
  }
  .christmas-snow-toggle {
    position: fixed;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    left: max(0.75rem, env(safe-area-inset-left));
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid #a98c52;
    border-radius: 2rem;
    background: #fff9ed;
    color: #214b3c;
    font: 500 0.75rem/1.3 var(--font-body);
    box-shadow: 0 2px 10px #102d2715;
    cursor: pointer;
    z-index: 81;
  }
  .christmas-snow-toggle:focus-visible {
    outline: 3px solid #a66f24;
    outline-offset: 3px;
  }
  .christmas-snow[hidden],
  .christmas-snow-toggle[hidden] {
    display: none !important;
  }
  @media (prefers-reduced-motion: reduce), print {
    .christmas-snow,
    .christmas-snow-toggle {
      display: none !important;
    }
  }
</style>
<script src="../../scripts/christmas-snow.js"></script>
