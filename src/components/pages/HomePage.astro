---
import { getHomeContent } from "../../data/home-content";
import type { ContentSection, Locale } from "../../types/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../products/ProductCard.astro";
import ContentBlock from "../sections/ContentSection.astro";
import CtaSection from "../sections/CtaSection.astro";
import HomeHero from "../sections/HomeHero.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const content = getHomeContent(locale);
const productsTitleId = "featured-products";

const toSection = (source: typeof content.model): ContentSection => ({
  eyebrow: source.eyebrow,
  title: source.title,
  lead: "lead" in source ? source.lead : undefined,
  items: source.items.map(([title, text]) => ({ title, text })),
});
---

<BaseLayout title={content.seo.title} description={content.seo.description} locale={locale}>
  <HomeHero content={content.hero} visual={content.visual} />

  <ContentBlock content={toSection(content.model)} />

  <section class="section products-showcase" aria-labelledby={productsTitleId}>
    <Container>
      <div class="section-intro" data-reveal>
        <p class="eyebrow">{content.productsSection.eyebrow}</p>
        <h2 id={productsTitleId}>{content.productsSection.title}</h2>
        <p>{content.productsSection.lead}</p>
      </div>
      <div class="products-list">
        {
          content.products
            .slice(0, 2)
            .map((product, index) => (
              <ProductCard
                product={product}
                viewLabel={content.productsSection.viewLabel}
                index={index}
              />
            ))
        }
      </div>
      <div class="products-showcase__more" data-reveal>
        <Button href={content.productsSection.allHref} variant="link">
          {content.productsSection.allLabel}
          <span aria-hidden="true">→</span>
        </Button>
      </div>
    </Container>
  </section>

  <CtaSection content={content.cta} />
</BaseLayout>

<style>
  .products-showcase {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .section-intro {
    max-width: 52rem;
  }

  .products-list {
    display: grid;
  }

  .products-showcase__more {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-8);
  }
</style>
