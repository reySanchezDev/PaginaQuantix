---
import { getHomeContent } from "../../data/home-content";
import type { Locale } from "../../types/site";
import { getRoute } from "../../i18n/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaSection from "../sections/CtaSection.astro";
import HomeHero from "../sections/HomeHero.astro";
import CaseStudiesSection from "../sections/CaseStudiesSection.astro";
import HomeTeam from "../company/HomeTeam.astro";
import Container from "../ui/Container.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = getHomeContent(locale);
const es = locale === "es";
---

<BaseLayout title={content.seo.title} description={content.seo.description} locale={locale}>
  <HomeHero locale={locale} />
  <CaseStudiesSection locale={locale} />
  <section class="section approach" aria-labelledby="approach-title">
    <Container>
      <div class="approach-intro" data-reveal>
        <p class="eyebrow">{content.model.eyebrow}</p><div>
          <h2 id="approach-title">{content.model.title}</h2><p>{content.model.lead}</p>
        </div>
      </div>
      <div class="approach-options">
        {
          content.model.items.map(([title, text], index) => (
            <article data-reveal class:list={{ "approach-option--primary": index === 0 }}>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))
        }
      </div>
      <a class="approach-link" href={getRoute("solutions", locale)}>
        {es ? "Ver soluciones" : "View solutions"}<span aria-hidden="true">→</span>
      </a>
    </Container>
  </section>
  <HomeTeam locale={locale} />
  <CtaSection content={content.cta} />
</BaseLayout>
<style>
  .approach-intro {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    gap: 2rem;
  }
  .approach-intro h2 {
    max-width: 25ch;
    font-size: var(--text-section);
  }
  .approach-intro p:not(.eyebrow) {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
  }
  .approach-options {
    margin-top: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .approach-options article {
    display: grid;
    grid-template-columns: minmax(0, 0.45fr) minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .approach-options h3 {
    max-width: 18ch;
    font-size: var(--text-heading);
    line-height: var(--leading-snug);
  }
  .approach-options p {
    max-width: 60ch;
    margin: 0;
    color: var(--color-ink-muted);
    line-height: var(--leading-relaxed);
  }
  .approach-options .approach-option--primary {
    padding-block: 2rem;
    border-top-color: var(--color-border-strong);
  }
  .approach-option--primary h3 {
    color: var(--color-primary);
  }
  .approach-option--primary p {
    max-width: 48ch;
    color: var(--color-ink);
    font-size: var(--text-lead);
  }
  .approach-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    margin-top: 1.25rem;
    padding-block: 0.75rem;
    width: fit-content;
    font-size: var(--text-base);
    font-weight: 500;
    text-underline-offset: 0.3em;
  }
  .approach-link:hover {
    color: var(--color-primary);
  }
  @media (max-width: 48rem) {
    .approach-intro {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .approach-options article {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem 0;
    }
    .approach-options h3 {
      max-width: 25ch;
    }
  }
</style>
