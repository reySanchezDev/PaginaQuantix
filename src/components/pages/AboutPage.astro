---
import type { Locale } from "../../types/site";
import { getCompanyProfile } from "../../data/company-profile";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CompanyWork from "../company/CompanyWork.astro";
import CtaSection from "../sections/CtaSection.astro";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getCompanyProfile(locale);
---

<BaseLayout title={c.seo.title} description={c.seo.description} locale={locale}>
  <section class="company-intro" aria-labelledby="page-title">
    <Container class="company-intro__layout">
      <div class="company-intro__copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 id="page-title">{c.title}</h1>
        <p class="company-intro__lead">{c.lead}</p>
        <p class="company-intro__origin">{c.origin}</p>
        <div class="company-intro__actions">
          <Button href={c.contactHref} size="lg">{c.contactLabel}</Button>
          <Button href={c.workHref} variant="link"
            >{c.workLabel}<span aria-hidden="true">→</span></Button
          >
        </div>
      </div>
      <aside class="founders" aria-labelledby="founders-title">
        <h2 class="eyebrow" id="founders-title">{c.teamLabel}</h2>
        <ul role="list">
          {
            c.founders.map((founder) => (
              <li>
                <h3>{founder.name}</h3>
                <p>{founder.role}</p>
                {founder.linkedin && (
                  <a
                    href={founder.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${c.linkedinLabel}: ${founder.name}`}
                  >
                    {c.linkedinLabel}
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </aside>
    </Container>
  </section>
  <CompanyWork
    content={c.proof}
    processLink={{ label: c.workLabel, href: `${c.workHref}#work-process` }}
  />
  <CtaSection content={c.cta} />
</BaseLayout>

<style>
  .company-intro {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .company-intro__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  h1 {
    max-width: 18ch;
  }
  .company-intro__lead {
    max-width: 48ch;
    margin: 1.5rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
  }
  .company-intro__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .company-intro__origin {
    max-width: 54ch;
    margin: 1.25rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-base);
    line-height: 1.7;
  }
  .founders {
    padding-left: clamp(2rem, 4vw, 4rem);
    border-left: 1px solid var(--color-border-strong);
  }
  .founders h2 {
    line-height: var(--leading-normal);
  }
  .founders ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .founders li + li {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .founders h3 {
    text-wrap: pretty;
  }
  .founders p {
    margin: 0.5rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .founders a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    text-underline-offset: 0.25em;
  }
  .founders a:hover {
    color: var(--color-primary);
  }
  @media (max-width: 58rem) {
    .company-intro__layout {
      grid-template-columns: 1fr;
    }
    .founders {
      padding: 2rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border-strong);
    }
  }
  @media (max-width: 25rem) {
    .company-intro__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
