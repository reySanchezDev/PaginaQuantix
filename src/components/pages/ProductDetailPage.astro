---
import { getProductPage } from "../../data/product-pages";
import { getProduct } from "../../data/products";
import { getCaseStudy } from "../../data/case-studies";
import { getContactHref } from "../../lib/contact-context";
import type { Locale, ProductId } from "../../types/site";
import ProductLayout from "../../layouts/ProductLayout.astro";
import ProductGallery from "../products/ProductGallery.astro";
import ProductHero from "../products/ProductHero.astro";
import ProductOverview from "../products/ProductOverview.astro";
import ProductCaseNote from "../products/ProductCaseNote.astro";
import Container from "../ui/Container.astro";
import ReleaseNotes from "../products/ReleaseNotes.astro";
import ContentSection from "../sections/ContentSection.astro";
import CtaSection from "../sections/CtaSection.astro";

interface Props {
  locale: Locale;
  productId: ProductId;
}
const { locale, productId } = Astro.props as Props;
const content = getProductPage(productId, locale);
const product = getProduct(productId, locale);
const featuresId = content.sections[0]?.id ?? "product-features";
const caseStudy =
  productId === "takofy" || productId === "viggo" ? getCaseStudy(productId, locale) : undefined;
---

<ProductLayout
  title={content.seo.title}
  description={content.seo.description}
  locale={locale}
  productName={product.name}
  image={`/images/og/${product.id}-${locale}.png`}
  imageAlt={`${product.name} — ${product.category}`}
  operatingSystem={productId === "qavision" ? "Windows" : undefined}
>
  <ProductHero content={content} product={product} locale={locale} />
  <nav
    class="product-nav"
    aria-label={locale === "es" ? "Secciones del producto" : "Product sections"}
  >
    <Container class="product-nav__inner"
      ><span>{product.name}</span><a href="#overview-title"
        >{locale === "es" ? "Descripción" : "Overview"}</a
      >{
        content.sections.length > 0 && (
          <a href={`#${featuresId}`}>{locale === "es" ? "Funciones" : "Features"}</a>
        )
      }{content.gallery && <a href="#gallery-title">{locale === "es" ? "Galería" : "Gallery"}</a>}{
        content.release && (
          <a href="#release-title">{locale === "es" ? "Versión actual" : "Current release"}</a>
        )
      }</Container
    >
  </nav>
  <ProductOverview content={content.overview} />
  {caseStudy && <ProductCaseNote caseStudy={caseStudy} locale={locale} />}
  {
    content.sections.map((section, index) => (
      <ContentSection content={{ ...section, id: index === 0 ? featuresId : section.id }} />
    ))
  }
  {content.gallery && <ProductGallery content={content.gallery} />}
  {content.release && <ReleaseNotes content={content.release} />}
  <CtaSection
    content={{
      ...content.cta,
      secondary: {
        label: locale === "es" ? `Consultar sobre ${product.name}` : `Ask about ${product.name}`,
        href: getContactHref(locale, productId),
      },
    }}
  />
</ProductLayout>

<style>
  .product-nav {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .product-nav__inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    flex-wrap: wrap;
    padding-block: 0.5rem;
  }
  .product-nav__inner > span {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 550;
    margin-right: auto;
  }
  .product-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .product-nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  @media (max-width: 40rem) {
    .product-nav__inner {
      gap: 0.25rem 1.25rem;
    }
    .product-nav__inner > span {
      display: none;
    }
  }
</style>
