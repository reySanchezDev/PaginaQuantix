---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/bricolage-grotesque";
import MiniPrestazoSettings from './MiniPrestazoSettings.astro';
import editorialMarkdown from '../content/textos-landing.md?raw';
interface Props { lang?: 'es'|'en' }
const {lang='es'} = Astro.props;
const en = lang === 'en';
const play = 'https://play.google.com/store/apps/details?id=com.prestamos.prestamos_app';
const icon = '/img/prestazo-app-icon.png';
const path = en ? '/en/products/prestazo/' : '/es/productos/prestazo/';
const alternatePath = en ? '/es/productos/prestazo/' : '/en/products/prestazo/';
const site = Astro.site ?? 'https://www.quantix.software';
const canonical = new URL(path, site).href;
const alternate = new URL(alternatePath, site).href;
const socialImage = new URL(`/images/og/prestazo-${en ? 'en' : 'es'}.png`, site).href;
const socialImageAlt = en ? 'Prestazo loan portfolio management' : 'Gestión de cartera de préstamos Prestazo';
const heroCopyMarkers = (language: 'ES'|'EN') => {
 const begin = '<!-- HERO_'+language+'_START -->';
 const finish = '<!-- HERO_'+language+'_END -->';
 const a = editorialMarkdown.indexOf(begin);
 const b = editorialMarkdown.indexOf(finish);
 if (a < 0 || b <= a) throw new Error('Missing landing copy section: '+language);
 const fields: Record<string,string> = {};
 const segment = editorialMarkdown.slice(a+begin.length,b);
 for (const line of segment.split('\n')) {
  const match = line.match(/^\s*-\s+\*\*([A-Za-z][A-Za-z0-9]*)\*\*:\s*(.*?)\s*$/);
  if (match) fields[match[1]] = match[2];
 }
 for (const field of ['seoTitle','seoDescription','hero1','hero2','heroButton']) {
  if (!fields[field]) throw new Error('Missing landing text "'+field+'" for '+language);
 }
 return fields;
};
const H = heroCopyMarkers(en?'EN':'ES');
const C = en ? {
 navApp:'The app', navCollections:'Collections', navSettings:'Settings', download:'Download free', language:'ES',
 processTitle:'From the first customer to the final payment.', processBody:'Register the customer, create the loan, review collections and record each payment. The entire process stays connected.',
 processSteps:['Customer','Demo','Collection','Payment'],
 galleryKicker:'INTERACTIVE PREVIEW', galleryTitle:'Explore Prestazo before downloading it.',
 tabs:['Overview','To Collect','Customers','Reports'],
 tourTitles:['Your portfolio at a glance.','Know who is due and who is late.','Customer records, all in one place.','Understand your earnings.'],
 tourTexts:['See principal placed, earnings, projections and overdue loans.','Separate upcoming payments from overdue accounts and open the relevant loan.','Search customers and keep their details and loan histories together.','Review realized earnings, projected earnings and foreign-exchange differences.'],
 collectionsKicker:'EVERYDAY COLLECTIONS', collectionsTitle:'Two lists. One clear view of what to collect.', collectionsBody:'Upcoming accounts and overdue loans have their own view. Find the next collection without reviewing your entire portfolio.',
 onTime:'On track', onTimeBody:'Accounts with payments coming due.', late:'Overdue', lateBody:'Loans with pending, overdue payments.',
 reportsKicker:'FINANCIAL VISIBILITY', reportsTitle:'What you earned. What you expect to earn.', reportsBody:'Review realized and projected earnings separately. Prestazo also includes a foreign-exchange differential report.',
 earned:'Realized earnings', earnedBody:'Received payments and income breakdown, filtered by date.', expected:'Projected earnings', expectedBody:'Estimated returns from active loans.', fxReport:'FX differential',fxReportBody:'Review exchange differences in a dedicated report.',
 settingsKicker:'FAR BEYOND A LOAN LIST', settingsTitle:'Configure the way your business works.', settingsBody:'Receipts, financial rules, loan sequences, validations and backups are part of Prestazo today. Explore the real settings screens.',
 s1:'Company and catalogs',d1:'Company details, customer categories, payment frequencies and lending plans.',
 s2:'Financial policies',d2:'Daily accrual, unpaid-interest capitalization, multiple loans and payment restrictions.',
 s3:'Customizable receipts',d3:'Signatures, legends and company details for payment and disbursement PDFs.',
 s4:'Loan and receipt sequences',d4:'Configure the numbering of new loans and receipts.',
 s5:'Validations',d5:'ID format and duplicate-document checks.',
 s6:'Backups',d6:'Export, restore and configure backup checks.',
 s7:'Language and appearance',d7:'Spanish or English; light or dark mode.',
 prev:'Previous screen',next:'Next screen',
 fxTitle:'Working with more than one currency?', fxBody:'Set your base currency and your reporting currency. Manage buy and sell rates by date, currency pair, and even apply rates across a month.',
 fxA:'Base and reporting currencies', fxB:'Exchange rate management', fxC:'FX differential reports',
 storageTitle:'Your records stay on your device.', storageBody:'Prestazo uses local storage for customers, loans and payments. Everyday operations do not require a constant connection. You can export and restore backups.',
 storageA:'Local records',storageB:'Backups',storageC:'Works offline',
 faqTitle:'Before you download',q1:'Does Prestazo issue loans?',a1:'No. Prestazo helps you manage the loans you issue. It does not lend money.',q2:'Is the app free?',a2:'Yes. The current version is available for free on Google Play.',q3:'Can I use it without an internet connection?',a3:'Day-to-day records are stored locally. Downloading and updating the app requires a connection.',q4:'Can I customize receipts?',a4:'Yes. You can configure company details, logos, signatures, receipt legends and numbering.',
 finalTitle:'Interested?',finalBody:'Visit Google Play, download the app, and discover the full potential of Prestazo for yourself.',
 footerOwnerPrefix:'Another product by',footerValue:'to manage loans at another level.',footerTop:'Back to top'
} : {
 navApp:'La aplicación', navCollections:'A Cobrar', navSettings:'Configuraciones', download:'Descargar gratis', language:'EN',
 processTitle:'Del primer cliente al último abono.',processBody:'Registrá al cliente, creá el préstamo, revisá A Cobrar y guardá cada pago. Todo queda relacionado.',
 processSteps:['Cliente','Demo','Cobro','Pago'],
 galleryKicker:'PRESTAZO POR DENTRO',galleryTitle:'Conocé la aplicación antes de descargarla.',
 tabs:['Inicio','A Cobrar','Clientes','Reportes'],
 tourTitles:['Tu cartera, en una sola vista.','Sabé quién paga y quién está atrasado.','Clientes y préstamos organizados.','Conocé tus ganancias.'],
 tourTexts:['Consultá el capital colocado, las ganancias, las proyecciones y los préstamos vencidos.','Separá los cobros al día de los atrasados y entrá al préstamo correspondiente.','Buscá clientes y mantené sus datos e historial de préstamos en un mismo lugar.','Revisá ganancias realizadas, proyectadas y diferencial cambiario.'],
 collectionsKicker:'COBROS DE TODOS LOS DÍAS',collectionsTitle:'Dos listas. Una forma más clara de cobrar.',collectionsBody:'Los préstamos al día y los atrasados tienen su propia vista. Encontrá el siguiente cobro sin revisar toda la cartera.',
 onTime:'Al Día',onTimeBody:'Cuentas con pagos próximos.',late:'Atrasados',lateBody:'Préstamos con cuotas pendientes y vencidas.',
 reportsKicker:'VISIBILIDAD FINANCIERA',reportsTitle:'Lo que ya ganaste. Lo que podrías ganar.',reportsBody:'Consultá por separado las ganancias realizadas y las proyectadas. Prestazo también incluye un reporte de diferencial cambiario.',
 earned:'Ganancias realizadas',earnedBody:'Pagos recibidos y desglose de ingresos con filtros por fecha.',expected:'Ganancias proyectadas',expectedBody:'Retornos estimados de los préstamos activos.',fxReport:'Diferencial cambiario',fxReportBody:'Revisá las diferencias de cambio en un reporte independiente.',
 settingsKicker:'MUCHO MÁS QUE ANOTAR PRÉSTAMOS',settingsTitle:'Configurá Prestazo según la manera en que trabajás.',settingsBody:'Recibos, políticas financieras, consecutivos, validaciones y respaldos ya forman parte de la app. Conocé sus pantallas.',
 s1:'Empresa y catálogos',d1:'Datos del negocio, categorías de clientes, frecuencias y planes de pago.',
 s2:'Políticas financieras',d2:'Devengo diario, capitalización de intereses, préstamos múltiples y restricciones de pago.',
 s3:'Recibos personalizables',d3:'Firmas, leyendas y datos de la empresa en PDF de pagos y desembolsos.',
 s4:'Numeración de préstamos y recibos',d4:'Definí los consecutivos utilizados en préstamos y comprobantes.',
 s5:'Validaciones',d5:'Formato de cédula y comprobación de documentos duplicados.',
 s6:'Respaldos',d6:'Exportá, restaurá y configurá verificaciones de respaldo.',
 s7:'Idioma y apariencia',d7:'Español o inglés; tema claro u oscuro.',
 prev:'Pantalla anterior',next:'Siguiente pantalla',
 fxTitle:'¿Trabajás con más de una moneda?',fxBody:'Definí la moneda base y la de reportes. Registrá tasas de compra y venta por fecha y par de monedas, con opción de aplicar una tasa a todo el mes.',
 fxA:'Moneda base y de reportes',fxB:'Administración de tipos de cambio',fxC:'Reporte de diferencial cambiario',
 storageTitle:'Tus registros quedan en tu teléfono.',storageBody:'Prestazo guarda localmente los clientes, préstamos y pagos. Las operaciones cotidianas no requieren una conexión permanente, y podés exportar o restaurar respaldos.',
 storageA:'Datos locales',storageB:'Respaldos',storageC:'Uso sin conexión',
 faqTitle:'Antes de descargar',q1:'¿Prestazo presta dinero?',a1:'No. Prestazo sirve para administrar los préstamos que vos otorgás. No brinda financiamiento.',q2:'¿La aplicación es gratis?',a2:'Sí. La versión publicada actualmente se puede descargar gratis desde Google Play.',q3:'¿Funciona sin internet?',a3:'Las operaciones diarias se hacen con registros locales. Para instalar o actualizar la app necesitás conexión.',q4:'¿Se pueden personalizar los recibos?',a4:'Sí. Podés configurar los datos y logo de tu negocio, firmas, leyendas y numeración de los comprobantes.',
 finalTitle:'¿Interesado?',finalBody:'Ve a la Play Store, descargá la app. Date cuenta tú mismo de todo el potencial de Prestazo.',
 footerOwnerPrefix:'Un producto más de',footerValue:'para gestionar préstamos a otro nivel.',footerTop:'Volver al inicio'
};
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
 <meta name="theme-color" content="#091D30"/>
 <meta name="robots" content="index,follow"/>
 <link rel="canonical" href={canonical}/>
 <link rel="alternate" hreflang={en ? 'es' : 'en'} href={alternate}/>
 <link rel="alternate" hreflang={en ? 'en' : 'es'} href={canonical}/>
 <link rel="alternate" hreflang="x-default" href={new URL('/es/productos/prestazo/', site).href}/>
 <meta name="description" content={H.seoDescription}/>
 <title>{H.seoTitle}</title>
 <meta property="og:title" content={H.seoTitle}/>
 <meta property="og:description" content={H.seoDescription}/>
 <meta property="og:type" content="website"/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:image" content={socialImage}/>
 <meta property="og:image:alt" content={socialImageAlt}/>
 <meta name="twitter:card" content="summary_large_image"/>
 <meta name="twitter:image" content={socialImage}/>
 <meta name="twitter:image:alt" content={socialImageAlt}/>
 <link rel="icon" href={icon} type="image/png"/>
 <link rel="stylesheet" href="/css/prestazo-v4.css"/>
 <link rel="stylesheet" href="/css/prestazo-responsive.css"/>
 <link rel="stylesheet" href="/css/prestazo-hero-photo.css"/>
 <link rel="stylesheet" href="/css/mini-prestazo.css?v=seek-093c643"/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'SoftwareApplication',name:'Prestazo',applicationCategory:'BusinessApplication',operatingSystem:'Android',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},downloadUrl:play,description:H.seoDescription})}/>
</head>
<body>
 <a class="skip" href="#content">{en?'Skip to content':'Saltar al contenido'}</a>
 <header class="site-header" id="top">
  <div class="container header-inner">
   <a class="brand" href="#top" aria-label="Prestazo"><img src={icon} width="40" height="40" alt=""/><strong>prestazo</strong></a>
   <nav class="primary-nav" aria-label={en?'Primary':'Principal'}><a href="#pantallas">{C.navApp}</a><a href="#descargar">{C.download}</a></nav>
   <div class="header-actions"><a class="language" href={en?'/es/productos/prestazo/':'/en/products/prestazo/'} aria-label="Switch language">{C.language}</a></div>
  </div>
 </header>
 <main id="content">
 <section class="hero hero--full-bleed">
  <div class="hero-background" aria-hidden="true">
   <img src="/img/prestazo-hero-personas-crecimiento.png"
     width="1672" height="941"
     loading="eager" fetchpriority="high" decoding="async" alt="" />
  </div>
  <div class="hero-grid container">
   <div class:list={['hero-copy', !en && 'hero-copy--minimal']}>
    {H.audience && <p class="hero-intro">{H.audience}</p>}
    <h1><span class="hero-mainline">{H.hero1}</span><em>{H.hero2}</em>{H.hero3 && <span class="hero-final-line">{H.hero3}</span>}</h1>
   </div>


  </div>
 </section>
 <section class="tour mp-tour" id="pantallas">
  <div class="container">
   <div class="tour-heading reveal"><h2 data-mp-order-title aria-live="polite">{en?'First,':'Lo primero es'}</h2></div>
   <MiniPrestazoSettings en={en}/>
  </div>
 </section>
 <section class="final final-premium" id="descargar" aria-labelledby="final-title">
   <div class="container final-grid">
     <div class="final-copy reveal">
       <h2 id="final-title">{C.finalTitle}</h2>
       <p>{C.finalBody}</p>
       <a class="final-googleplay-link" href={play} target="_blank" rel="noopener noreferrer" data-cta="final"
          aria-label={en?'Get Prestazo on Google Play':'Descargar Prestazo en Google Play'}>
         <img
           src={en
             ? 'https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png'
             : 'https://play.google.com/intl/en_us/badges/static/images/badges/es-419_badge_web_generic.png'}
           alt={en?'Get it on Google Play':'Descargar en Google Play'}
           width="646" height="250" loading="lazy" decoding="async"
         />
       </a>
     </div>
   </div>
 </section>
 </main>
 <footer class="footer footer-rebrand">
   <div class="container footer-main">
     <div class="footer-identity">
       <div class="footer-brand">Prestazo.</div>
       <p class="footer-quantix">{C.footerOwnerPrefix} <a href="https://www.quantix.software/" target="_blank" rel="noopener noreferrer">Quantix</a></p>
       <p class="footer-promise">{C.footerValue}</p>
     </div>
   </div>
   <div class="container footer-end">© {new Date().getFullYear()} Prestazo</div>
 </footer>
 <a href="#top" class="back-to-top" data-back-to-top aria-label={C.footerTop} title={C.footerTop} aria-hidden="true" tabindex="-1" inert>
   <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
     <path d="M12 19V5m-6 6 6-6 6 6"/>
   </svg>
 </a>
  <script is:inline src="/js/prestazo-v4.js" defer></script>
  <script is:inline src="/js/mini-prestazo.js?v=seek-093c643" defer></script>
  <script is:inline src="/js/mini-prestazo-navigation.js" defer></script>
  <script is:inline src="/js/mini-prestazo-state.js" defer></script>
</body>
</html>
