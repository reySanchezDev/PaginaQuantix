---
import type { HeroContent } from "../../types/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  content: HeroContent;
  highlights?: readonly string[];
  compact?: boolean;
}

const { content, highlights = [], compact = false } = Astro.props as Props;
---

<section class:list={["page-hero", { "page-hero--compact": compact }]} aria-labelledby="page-title">
  <Container class="page-hero__layout">
    <div class="page-hero__content">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="page-title">{content.title}</h1>
      <p class="page-hero__lead">{content.lead}</p>

      {
        (content.primary || content.secondary) && (
          <div class="page-hero__actions">
            {content.primary && (
              <Button
                href={content.primary.href}
                target={content.primary.target}
                variant="primary"
                size="lg"
              >
                {content.primary.label}
              </Button>
            )}
            {content.secondary && (
              <Button
                href={content.secondary.href}
                target={content.secondary.target}
                variant="secondary"
                size="lg"
              >
                {content.secondary.label}
              </Button>
            )}
          </div>
        )
      }
    </div>

    {
      highlights.length > 0 && (
        <div class="page-hero__visual" aria-hidden="true">
          <div class="visual-header">
            <>
              <span />
              <span />
              <span />
            </>
          </div>
          <div class="visual-grid">
            {highlights.map((item, index) => (
              <div class="visual-item">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item}</strong>
              </div>
            ))}
          </div>
          <div class="visual-status">
            <i />
            <span>Quantix Software</span>
          </div>
        </div>
      )
    }
  </Container>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(7.5rem, 10vw, 8.5rem) 0 clamp(4.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-primary-soft), var(--color-canvas) 78%);
  }

  .page-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: linear-gradient(to bottom, var(--color-mask), transparent 72%);
    content: "";
  }

  .page-hero--compact {
    padding-bottom: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .page-hero__layout {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .page-hero__content {
    max-width: 48rem;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.65rem, 5.3vw, 4.25rem);
  }

  .page-hero--compact h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 5.2vw, 4.25rem);
  }

  .page-hero__lead {
    max-width: 43rem;
    margin: var(--space-6) 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    line-height: var(--leading-relaxed);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .page-hero__visual {
    width: 100%;
    max-width: 34rem;
    justify-self: end;
    padding: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(8px);
  }

  .visual-header {
    display: flex;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .visual-header span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .visual-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .visual-item {
    min-height: 5.5rem;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .visual-item span {
    display: block;
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .visual-item strong {
    font-family: var(--font-heading);
    line-height: var(--leading-snug);
  }

  .visual-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-subtle);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .visual-status i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success);
  }

  @media (min-width: 84rem) {
    .page-hero__layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(24rem, 0.92fr);
    }
  }

  @media (max-width: 40rem) {
    .page-hero {
      padding-top: 7.5rem;
    }

    h1 {
      font-size: clamp(2.45rem, 13vw, 3.65rem);
    }

    .page-hero__actions {
      display: grid;
    }
  }
</style>
