---
import type { HeroContent } from "../../types/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  content: HeroContent;
  compact?: boolean;
}

const { content, compact = false } = Astro.props as Props;
---

<section class:list={["page-hero", { "page-hero--compact": compact }]} aria-labelledby="page-title">
  <Container class="page-hero__layout">
    <p class="eyebrow">{content.eyebrow}</p>
    <div class="page-hero__content">
      <h1 id="page-title">{content.title}</h1>
      <p class="page-hero__lead">{content.lead}</p>

      {
        (content.primary || content.secondary) && (
          <div class="page-hero__actions">
            {content.primary && (
              <Button href={content.primary.href} target={content.primary.target} size="lg">
                {content.primary.label}
              </Button>
            )}
            {content.secondary && (
              <Button
                href={content.secondary.href}
                target={content.secondary.target}
                variant="secondary"
                size="lg"
              >
                {content.secondary.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .page-hero {
    padding: clamp(var(--space-16), 9vw, 7.5rem) 0 clamp(var(--space-20), 10vw, 8.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero--compact {
    padding-bottom: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .page-hero__layout {
    display: grid;
    gap: var(--space-6);
  }

  .eyebrow {
    padding-top: 0.55rem;
  }

  .page-hero__content {
    max-width: 58rem;
  }

  h1 {
    max-width: 18ch;
  }

  .page-hero__lead {
    max-width: 41rem;
    margin: var(--space-6) 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    line-height: var(--leading-relaxed);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  @media (min-width: 56rem) {
    .page-hero__layout {
      grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1.65fr);
    }
  }

  @media (max-width: 40rem) {
    .page-hero__actions {
      display: grid;
    }
  }
</style>
