---
import type { CtaContent } from "../../types/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  content: CtaContent;
}
const { content } = Astro.props as Props;
---

<section class="cta-section" aria-labelledby="cta-title">
  <Container>
    <div class="cta-panel">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h2 id="cta-title">{content.title}</h2>
        <p>{content.text}</p>
      </div>
      <div class="cta-panel__actions">
        <Button href={content.primary.href} target={content.primary.target} size="lg">
          {content.primary.label}
        </Button>
        {
          content.secondary && (
            <Button
              href={content.secondary.href}
              target={content.secondary.target}
              variant="secondary"
              size="lg"
            >
              {content.secondary.label}
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .cta-section {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .cta-panel {
    display: grid;
    gap: var(--space-8);
    align-items: end;
    padding: clamp(var(--space-8), 6vw, var(--space-16));
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
    box-shadow: var(--shadow-md);
  }

  h2 {
    max-width: 16ch;
  }

  .cta-panel p:not(.eyebrow) {
    max-width: 40rem;
    margin: var(--space-5) 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 60rem) {
    .cta-panel {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 40rem) {
    .cta-panel__actions {
      display: grid;
    }
  }
</style>
