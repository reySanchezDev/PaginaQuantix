---
import type { CtaContent } from "../../types/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  content: CtaContent;
}

const { content } = Astro.props as Props;
---

<section class="cta-section" aria-labelledby="cta-title">
  <Container class="cta-section__layout" data-reveal>
    <p class="eyebrow">{content.eyebrow}</p>
    <div class="cta-section__content">
      <h2 id="cta-title">{content.title}</h2>
      <p>{content.text}</p>
      <div class="cta-section__actions">
        <Button href={content.primary.href} target={content.primary.target} size="lg">
          {content.primary.label}
        </Button>
        {
          content.secondary && (
            <Button
              href={content.secondary.href}
              target={content.secondary.target}
              variant="secondary"
              size="lg"
              class="cta-secondary"
            >
              {content.secondary.label}
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .cta-section {
    padding-block: clamp(var(--space-16), 9vw, var(--space-24));
    background: var(--color-dark);
  }

  .cta-section__layout {
    display: grid;
    gap: var(--space-6);
  }

  .eyebrow {
    color: var(--color-inverse-muted);
  }

  h2 {
    max-width: 16ch;
    color: var(--color-inverse);
  }

  .cta-section__content > p {
    max-width: 38rem;
    margin: var(--space-5) 0 0;
    color: var(--color-inverse-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .cta-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .cta-section :global(.cta-secondary) {
    border-color: color-mix(in srgb, var(--color-inverse) 45%, transparent);
    color: var(--color-inverse);
  }

  .cta-section :global(.cta-secondary:hover) {
    border-color: var(--color-inverse);
    color: var(--color-inverse);
  }

  @media (min-width: 56rem) {
    .cta-section__layout {
      grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1.65fr);
    }
  }

  @media (max-width: 40rem) {
    .cta-section__actions {
      display: grid;
    }
  }
</style>
