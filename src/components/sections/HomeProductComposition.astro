---
import type { Locale } from "../../types/site";
import MacBookFrame from "../ui/MacBookFrame.astro";
import IPhoneFrame from "../ui/IPhoneFrame.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === "es";
---

<figure class="product-composition" data-enter="stage" data-motion-delay="160">
  <div class="product-stage">
    <div class="desktop-product">
      <MacBookFrame
        src="/images/viggo/viggo-dashboard.webp"
        alt={es
          ? "Panel de VIGGO con ventas, cobros y la actividad del negocio."
          : "VIGGO dashboard showing sales, payments and business activity."}
        width={1917}
        height={945}
      />
    </div>
    <div class="mobile-product">
      <IPhoneFrame
        src="/images/takofy/pedido-hero-mobile.png"
        alt={es
          ? "Takofy en móvil: resumen y platos de un pedido de la Mesa 1."
          : "Takofy on mobile: the summary and items of an order for Table 1."}
        width={390}
        height={844}
      />
    </div>
  </div>
  <figcaption class="composition-note">
    {es ? "Interfaces reales." : "Real interfaces."}
    <span>{es ? "Datos de ejemplo." : "Sample data."}</span>
  </figcaption>
</figure>

<style>
  .product-composition {
    position: relative;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
  }
  .product-stage {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1.12;
  }
  .desktop-product {
    position: absolute;
    width: 95%;
    top: 10%;
    right: 0;
    transform: rotate(-4deg);
  }
  .mobile-product {
    position: absolute;
    width: 28%;
    bottom: 4%;
    left: 2%;
    transform: rotate(5deg);
  }
  .composition-note {
    position: absolute;
    left: 39%;
    right: 0;
    bottom: 4%;
    margin: 0;
    font-size: var(--text-base);
  }
  .composition-note span {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-xs);
  }
  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage::before,
  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage::after {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage::before {
    inset: -9% -10% 1% -9%;
    background: radial-gradient(
      ellipse at 61% 42%,
      rgb(255 218 147 / 0.38),
      rgb(222 173 87 / 0.17) 32%,
      transparent 69%
    );
  }

  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage::after {
    inset: 58% -3% 4% -6%;
    background:
      radial-gradient(ellipse closest-side at 51% 43%, rgb(5 20 16 / 0.66), transparent),
      radial-gradient(ellipse closest-side at 40% 60%, rgb(228 180 93 / 0.18), transparent);
  }

  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage :global(.macbook) {
    filter: drop-shadow(0 1.35rem 1.15rem rgb(3 17 13 / 0.54));
  }

  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage :global(.macbook-lid),
  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage :global(.iphone) {
    border-color: #d5bf9b;
  }

  :global(html[data-seasonal-theme="navidad-premium"]) .product-stage :global(.iphone) {
    box-shadow:
      inset 0 0 0 1px #827766,
      inset 0 0 0 2px #292a2b,
      0.4rem 1.25rem 1.6rem -0.3rem rgb(3 17 13 / 0.78),
      0 0 1.25rem rgb(247 204 127 / 0.14);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-seasonal-theme="navidad-premium"])
      .product-composition[data-motion-state="running"]
      .mobile-product {
      animation: navidad-phone-enter 400ms var(--motion-ease-out) 140ms backwards;
    }
  }

  @keyframes navidad-phone-enter {
    from {
      translate: 0 0.65rem;
    }
    to {
      translate: 0 0;
    }
  }

  @media (max-width: 35.999rem) {
    .product-stage {
      aspect-ratio: 1.15;
    }
    .desktop-product {
      top: 4%;
    }
    .mobile-product {
      width: 30%;
      bottom: 2%;
    }
    .composition-note {
      left: 40%;
      bottom: 5%;
      font-size: var(--text-sm);
    }
  }
  @media (max-width: 23.999rem) {
    .product-stage {
      aspect-ratio: 1.1;
    }
  }
</style>
