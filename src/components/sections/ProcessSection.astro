---
import type { ProcessContent } from "../../types/site";
import Container from "../ui/Container.astro";

interface Props {
  content: ProcessContent;
}

const { content } = Astro.props;
---

<section id="work-process" class="section process" aria-labelledby="process-title">
  <Container>
    <header class="process-intro">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h2 id="process-title">{content.title}</h2>
      </div>
      <p class="process-lead">{content.lead}</p>
    </header>
    <ol class="process-stages" role="list">
      {
        content.stages.map((stage) => (
          <li class="process-stage">
            <div class="stage-work">
              <h3>{stage.title}</h3>
              <p>{stage.text}</p>
            </div>
            <dl class="stage-result">
              <div class="stage-outcome">
                <dt>{content.outcomeLabel}</dt>
                <dd>{stage.outcome}</dd>
              </div>
              <div class="stage-review">
                <dt>{content.reviewLabel}</dt>
                <dd>{stage.review}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .process-intro,
  .process-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 7rem);
  }

  .process-intro {
    align-items: end;
    margin-bottom: 3rem;
  }

  .process-intro h2 {
    max-width: 20ch;
  }

  .process-lead {
    max-width: 46ch;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
  }

  .process-stages {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border-strong);
  }

  .process-stage {
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .stage-work > p {
    max-width: 38ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink-muted);
  }

  .stage-result {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .stage-result dt {
    margin-bottom: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .stage-result dd {
    max-width: 52ch;
    margin: 0;
  }

  .stage-outcome dt {
    color: var(--color-primary);
  }

  .stage-outcome dd {
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .stage-review {
    color: var(--color-ink-muted);
  }

  @media (max-width: 48rem) {
    .process-intro,
    .process-stage {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .process-intro {
      margin-bottom: 2rem;
    }

    .stage-work > p,
    .stage-result dd {
      max-width: 52ch;
    }
  }
</style>
