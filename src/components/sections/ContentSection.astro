---
import type { ContentSection as SectionContent } from "../../types/site";
import Card from "../ui/Card.astro";
import Container from "../ui/Container.astro";

interface Props {
  content: SectionContent;
}

const { content } = Astro.props as Props;
const headingId = content.id ? `${content.id}-title` : undefined;
---

<section
  id={content.id}
  class:list={["section", { "section--soft": content.variant === "soft" }]}
  aria-labelledby={headingId}
>
  <Container>
    <div class="section-intro">
      {content.eyebrow && <p class="eyebrow">{content.eyebrow}</p>}
      <h2 id={headingId}>{content.title}</h2>
      {content.lead && <p>{content.lead}</p>}
    </div>

    <div class="feature-grid">
      {
        content.items.map((item, index) => (
          <Card>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </Card>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .feature-card span {
    display: inline-block;
    margin-bottom: var(--space-8);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }
</style>
