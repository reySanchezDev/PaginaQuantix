---
import type { HeroContent, SystemMapContent } from "../../types/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SystemMap from "../ui/SystemMap.astro";

interface Props {
  content: HeroContent;
  visual: SystemMapContent;
}

const { content, visual } = Astro.props as Props;
---

<section class="home-hero" aria-labelledby="page-title">
  <Container class="home-hero__layout">
    <div class="home-hero__content">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="page-title">{content.title}</h1>
      <p class="home-hero__lead">{content.lead}</p>

      <div class="home-hero__actions">
        {
          content.primary && (
            <Button href={content.primary.href} target={content.primary.target} size="lg">
              {content.primary.label}
            </Button>
          )
        }
        {
          content.secondary && (
            <Button
              href={content.secondary.href}
              target={content.secondary.target}
              variant="secondary"
              size="lg"
            >
              {content.secondary.label}
            </Button>
          )
        }
      </div>
    </div>

    <div class="home-hero__visual">
      <SystemMap content={visual} />
    </div>
  </Container>
</section>

<style>
  .home-hero {
    overflow: hidden;
    padding: clamp(var(--space-12), 7vw, var(--space-24)) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .home-hero__layout {
    display: grid;
    gap: clamp(var(--space-12), 7vw, var(--space-24));
    align-items: center;
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .eyebrow {
    animation: hero-enter 560ms 40ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(2.75rem, 6.3vw, 5.5rem);
    animation: hero-enter 680ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .home-hero__lead {
    max-width: 40rem;
    margin: var(--space-6) 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(var(--text-lg), 1.8vw, var(--text-xl));
    line-height: var(--leading-relaxed);
    animation: hero-enter 680ms 180ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
    animation: hero-enter 680ms 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .home-hero__visual {
    width: min(100%, 36rem);
    margin-inline: auto;
    min-width: 0;
    animation: visual-enter 880ms 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes visual-enter {
    from {
      opacity: 0;
      transform: translateX(2rem);
    }
  }

  @media (min-width: 70rem) {
    .home-hero {
      min-height: calc(100svh - var(--header-height));
      display: grid;
      align-items: center;
    }

    .home-hero__layout {
      grid-template-columns: minmax(0, 1.12fr) minmax(27rem, 0.88fr);
      gap: clamp(var(--space-12), 6vw, var(--space-24));
    }
  }

  @media (max-width: 40rem) {
    .home-hero {
      padding-top: var(--space-12);
    }

    .home-hero__layout {
      gap: var(--space-12);
    }

    .home-hero__actions {
      display: grid;
    }
  }
</style>
