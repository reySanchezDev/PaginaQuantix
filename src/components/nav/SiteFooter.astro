---
import { getRoute } from "../../i18n/routes";
import type { LinkItem, Locale, NavItem } from "../../types/site";
import { siteConfig } from "../../data/site-config";
import Brand from "../ui/Brand.astro";
import Container from "../ui/Container.astro";

interface Props {
  navItems: NavItem[];
  legalItems: LinkItem[];
  locale: Locale;
  labels: {
    navigation: string;
    legal: string;
    footerText: string;
    copyright: string;
    process: string;
  };
}

const { navItems, legalItems, locale, labels } = Astro.props as Props;
const companyLinks = [
  ...navItems.filter((item) => item.id !== "contact"),
  { label: labels.process, href: getRoute("work", locale) },
];
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__statement">
      <Brand locale={locale} />
      <p>{labels.footerText}</p>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>

    <div class="site-footer__links">
      <nav aria-label={labels.navigation}>
        <h2>{labels.navigation}</h2>
        <ul>
          {
            companyLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={labels.legal}>
        <h2>{labels.legal}</h2>
        <ul>
          {
            legalItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} {siteConfig.name}. {labels.copyright}</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding: clamp(var(--space-16), 8vw, var(--space-24)) 0 var(--space-6);
    background: var(--color-dark);
    color: var(--color-inverse);
  }

  .site-footer__statement {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid rgb(239 242 237 / 0.18);
  }

  .site-footer__statement :global(.brand) {
    color: var(--color-inverse);
  }

  .site-footer__statement :global(.brand__mark) {
    background: var(--color-inverse);
    color: var(--color-dark);
  }

  .site-footer__statement p {
    max-width: 32rem;
    margin: 0;
    color: var(--color-inverse-muted);
    font-size: clamp(var(--text-xl), 2.6vw, var(--text-3xl));
    line-height: var(--leading-snug);
  }

  .site-footer__statement > a {
    width: fit-content;
    color: var(--color-inverse);
    font-size: var(--text-sm);
    text-underline-offset: 0.25em;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  h2 {
    margin-bottom: var(--space-5);
    color: var(--color-inverse-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-inverse);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__bottom {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(239 242 237 / 0.18);
    color: var(--color-inverse-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .site-footer__statement {
      grid-template-columns: minmax(0, 0.7fr) minmax(20rem, 1.3fr);
    }

    .site-footer__statement > a {
      grid-column: 2;
    }

    .site-footer__links {
      width: 50%;
      margin-left: auto;
    }
  }
</style>
