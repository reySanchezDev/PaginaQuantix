---
import { isRouteActive } from "../../i18n/routes";
import type { Locale, NavItem } from "../../types/site";
import Brand from "../ui/Brand.astro";
import Container from "../ui/Container.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import MobileMenu from "./MobileMenu.astro";

interface Props {
  navItems: NavItem[];
  locale: Locale;
  labels: {
    primaryNav: string;
    mobileNav: string;
    openMenu: string;
    closeMenu: string;
    language: string;
  };
}

const { navItems, locale, labels } = Astro.props as Props;
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <Container class="site-header__inner">
    <Brand locale={locale} compact />

    <nav class="desktop-nav" aria-label={labels.primaryNav}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{
                  active: isRouteActive(pathname, item.id),
                  "contact-link": item.id === "contact",
                }}
                aria-current={isRouteActive(pathname, item.id) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <LanguageSwitch locale={locale} label={labels.language} />
    </nav>

    <button
      id="mobile-menu-toggle"
      class="menu-toggle"
      type="button"
      aria-label={labels.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span>
    </button>
  </Container>
</header>

<MobileMenu navItems={navItems} locale={locale} labels={labels} pathname={pathname} />

<style>
  .site-header {
    position: sticky;
    inset: 0 0 auto;
    z-index: 80;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-canvas);
    transition:
      background var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .site-header[data-scrolled] {
    border-color: color-mix(in srgb, var(--color-border) 72%, transparent);
    background: color-mix(in srgb, var(--color-canvas) 88%, transparent);
    box-shadow: 0 0.8rem 2rem -1.6rem rgb(20 35 38 / 0.5);
    -webkit-backdrop-filter: blur(0.9rem) saturate(120%);
    backdrop-filter: blur(0.9rem) saturate(120%);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a:not(.language-switch) {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: var(--space-4);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .desktop-nav a:not(.language-switch):hover,
  .desktop-nav a.active:not(.language-switch) {
    color: var(--color-primary);
  }

  .desktop-nav a:not(.language-switch, .contact-link)::after {
    position: absolute;
    inset: auto var(--space-4) 0.4rem;
    height: 2px;
    background: var(--color-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-base);
  }

  .desktop-nav a:not(.language-switch, .contact-link):hover::after,
  .desktop-nav a.active:not(.language-switch, .contact-link)::after,
  .desktop-nav a:not(.language-switch, .contact-link):focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .desktop-nav a.contact-link:not(.language-switch) {
    margin-left: var(--space-2);
    border: 1px solid var(--color-dark);
    border-radius: var(--radius-control);
    background: var(--color-dark);
    box-shadow:
      var(--shadow-control),
      inset 0 1px rgb(255 255 255 / 0.14);
    color: var(--color-inverse);
  }

  .desktop-nav a.contact-link:not(.language-switch):hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow: var(--shadow-control-hover);
    color: var(--color-inverse);
    transform: translateY(-1px);
  }

  .menu-toggle {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-content: center;
    gap: 0.35rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-surface) 58%, transparent);
    box-shadow: inset 0 1px rgb(255 255 255 / 0.72);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .menu-toggle:hover {
    border-color: var(--color-ink);
    box-shadow: var(--shadow-control);
    transform: translateY(-1px);
  }

  .menu-toggle span {
    width: 1.15rem;
    height: 1px;
    background: currentColor;
  }

  @media (min-width: 60rem) {
    .desktop-nav {
      display: flex;
    }

    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  let scrollFrame: number | undefined;

  function syncHeaderSurface() {
    header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  }

  function handleHeaderScroll() {
    if (scrollFrame) return;
    scrollFrame = window.requestAnimationFrame(() => {
      syncHeaderSurface();
      scrollFrame = undefined;
    });
  }

  syncHeaderSurface();
  window.addEventListener("scroll", handleHeaderScroll, { passive: true });
</script>
