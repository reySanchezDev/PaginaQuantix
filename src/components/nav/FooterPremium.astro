---
import type { Locale, NavItem } from "../../types/site";
import type { LinkItem } from "../../types/site";
import { siteConfig } from "../../data/site-config";
import Brand from "../ui/Brand.astro";
import Container from "../ui/Container.astro";

interface Props {
  navItems: NavItem[];
  legalItems: LinkItem[];
  locale: Locale;
  labels: {
    navigation: string;
    legal: string;
    footerText: string;
    copyright: string;
  };
}

const { navItems, legalItems, locale, labels } = Astro.props as Props;
---

<footer class="site-footer">
  <Container class="site-footer__grid">
    <div class="site-footer__brand">
      <Brand locale={locale} />
      <p>{labels.footerText}</p>
    </div>

    <nav aria-label={labels.navigation}>
      <h2>{labels.navigation}</h2>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={labels.legal}>
      <h2>{labels.legal}</h2>
      <ul>
        {
          legalItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>

  <Container class="site-footer__bottom">
    <p>© {new Date().getFullYear()} {siteConfig.name}. {labels.copyright}</p>
  </Container>
</footer>

<style>
  .site-footer {
    padding: var(--space-16) 0 var(--space-6);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(8rem, 0.5fr));
    gap: var(--space-12);
  }

  .site-footer__brand p {
    max-width: 26rem;
    margin: var(--space-5) 0 0;
    color: var(--color-ink-muted);
  }

  h2 {
    margin-bottom: var(--space-4);
    color: var(--color-ink-subtle);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .site-footer__bottom p {
    margin: 0;
    color: var(--color-ink-subtle);
    font-size: var(--text-sm);
  }

  @media (max-width: 44rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
