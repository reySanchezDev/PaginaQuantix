---
import { isRouteActive } from "../../i18n/routes";
import type { Locale, NavItem } from "../../types/site";
import Brand from "../ui/Brand.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  navItems: NavItem[];
  locale: Locale;
  pathname: string;
  labels: {
    mobileNav: string;
    openMenu: string;
    closeMenu: string;
    language: string;
  };
}

const { navItems, locale, pathname, labels } = Astro.props as Props;
---

<div id="mobile-menu" class="menu-overlay" data-state="closed" hidden aria-hidden="true">
  <button
    class="menu-backdrop"
    type="button"
    data-menu-close
    tabindex="-1"
    aria-label={labels.closeMenu}></button>
  <div class="menu-dialog" role="dialog" aria-modal="true" aria-label={labels.mobileNav}>
    <div class="menu-dialog__header">
      <Brand locale={locale} compact />
      <button class="menu-close" type="button" data-menu-close aria-label={labels.closeMenu}>
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <nav aria-label={labels.mobileNav}>
      <ul>
        {
          navItems.map((item, index) => (
            <li>
              <a
                href={item.href}
                class:list={{ active: isRouteActive(pathname, item.id) }}
                aria-current={isRouteActive(pathname, item.id) ? "page" : undefined}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-dialog__footer">
      <LanguageSwitch locale={locale} label={labels.language} />
    </div>
  </div>
</div>

<style>
  .menu-overlay[hidden] {
    display: none;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    justify-items: end;
  }

  .menu-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: 0;
    background: var(--color-overlay);
    transition: opacity var(--transition-base);
  }

  .menu-dialog {
    position: relative;
    width: min(100%, 32rem);
    min-height: 100dvh;
    padding: max(var(--space-5), env(safe-area-inset-top)) var(--space-5)
      max(var(--space-6), env(safe-area-inset-bottom));
    overflow-y: auto;
    opacity: 0;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    transform: translateX(1rem);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .menu-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .menu-close {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
  }

  ul {
    display: grid;
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    min-height: 4.75rem;
    align-items: center;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink);
    font-size: clamp(var(--text-xl), 7vw, var(--text-3xl));
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  nav a span {
    color: var(--color-ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  nav a.active {
    color: var(--color-primary);
  }

  nav li {
    opacity: 0;
    transform: translateX(1rem);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-overlay[data-state="open"] .menu-backdrop,
  .menu-overlay[data-state="open"] .menu-dialog,
  .menu-overlay[data-state="open"] nav li {
    opacity: 1;
  }

  .menu-overlay[data-state="open"] .menu-dialog,
  .menu-overlay[data-state="open"] nav li {
    transform: translateX(0);
  }

  .menu-overlay[data-state="open"] nav li:nth-child(2) {
    transition-delay: 45ms;
  }

  .menu-overlay[data-state="open"] nav li:nth-child(3) {
    transition-delay: 90ms;
  }

  .menu-overlay[data-state="open"] nav li:nth-child(4) {
    transition-delay: 135ms;
  }

  .menu-overlay[data-state="closing"] nav li {
    transition-delay: 0ms;
    transition-duration: 120ms;
  }

  .menu-dialog__footer {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--space-10);
  }

  @media (min-width: 60rem) {
    .menu-overlay {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const overlay = document.getElementById("mobile-menu");
  const dialog = overlay?.querySelector<HTMLElement>(".menu-dialog");
  const closeButton = overlay?.querySelector<HTMLButtonElement>(".menu-close");
  const desktopViewport = window.matchMedia("(min-width: 60rem)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const focusableSelector = "a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])";
  let closeFallback: number | undefined;

  function closeMenu({ immediate = false, restoreFocus = true } = {}) {
    if (!overlay || overlay.hidden || overlay.dataset.state === "closing") return;
    toggle?.setAttribute("aria-expanded", "false");
    if (restoreFocus) toggle?.focus();
    overlay.setAttribute("aria-hidden", "true");
    overlay.inert = true;
    overlay.dataset.state = "closing";

    const finish = () => {
      if (overlay.dataset.state !== "closing") return;
      overlay.hidden = true;
      overlay.inert = false;
      overlay.dataset.state = "closed";
      document.body.removeAttribute("data-menu-open");
    };
    window.clearTimeout(closeFallback);
    if (immediate || reducedMotion.matches) return finish();
    closeFallback = window.setTimeout(finish, 320);
  }

  function openMenu() {
    if (!overlay) return;
    window.clearTimeout(closeFallback);
    overlay.hidden = false;
    overlay.inert = false;
    overlay.setAttribute("aria-hidden", "false");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.dataset.menuOpen = "true";
    overlay.dataset.state = reducedMotion.matches ? "open" : "opening";
    if (!reducedMotion.matches) {
      requestAnimationFrame(() => {
        if (overlay.dataset.state === "opening") overlay.dataset.state = "open";
      });
    }
    closeButton?.focus();
  }

  toggle?.addEventListener("click", openMenu);
  desktopViewport.addEventListener("change", (event) => {
    if (!event.matches || overlay?.hidden) return;
    closeMenu({ immediate: true, restoreFocus: false });
    document.querySelector<HTMLElement>(".site-header a")?.focus();
  });
  overlay?.querySelectorAll<HTMLElement>("[data-menu-close]").forEach((element) => {
    element.addEventListener("click", () => closeMenu());
  });
  overlay?.querySelectorAll<HTMLElement>("nav a").forEach((element) => {
    element.addEventListener("click", () => closeMenu({ immediate: true, restoreFocus: false }));
  });

  document.addEventListener("keydown", (event) => {
    if (!overlay || overlay.hidden) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeMenu();
      return;
    }
    if (event.key !== "Tab" || !dialog) return;

    const focusable = [...dialog.querySelectorAll<HTMLElement>(focusableSelector)];
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
