---
import { isRouteActive } from "../../i18n/routes";
import type { Locale, NavItem } from "../../types/site";
import Brand from "../ui/Brand.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  navItems: NavItem[];
  locale: Locale;
  pathname: string;
  labels: {
    mobileNav: string;
    openMenu: string;
    closeMenu: string;
    language: string;
  };
}

const { navItems, locale, pathname, labels } = Astro.props as Props;
---

<div id="mobile-menu" class="menu-overlay" data-state="closed" hidden aria-hidden="true">
  <button
    class="menu-backdrop"
    type="button"
    data-menu-close
    tabindex="-1"
    aria-label={labels.closeMenu}></button>
  <div class="menu-dialog" role="dialog" aria-modal="true" aria-label={labels.mobileNav}>
    <div class="menu-dialog__header">
      <Brand locale={locale} compact />
      <button class="menu-close" type="button" data-menu-close aria-label={labels.closeMenu}>
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <nav aria-label={labels.mobileNav}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{
                  active: isRouteActive(pathname, item.id),
                  "menu-contact": item.id === "contact",
                }}
                aria-current={isRouteActive(pathname, item.id) ? "page" : undefined}
              >
                {item.label}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-dialog__footer">
      <LanguageSwitch locale={locale} label={labels.language} />
    </div>
  </div>
</div>

<style>
  .menu-overlay[hidden] {
    display: none;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    justify-items: end;
  }

  .menu-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    border: 0;
    background: var(--color-overlay);
    transition: opacity var(--transition-base);
  }

  .menu-dialog {
    position: relative;
    width: min(100%, 32rem);
    height: 100dvh;
    padding: 0 var(--space-5) max(var(--space-6), env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding-top: 7rem;
    opacity: 0;
    background: var(--menu-panel-bg, var(--color-canvas));
    box-shadow: var(--shadow-lg);
    transform: translateX(1rem);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .menu-dialog__header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-inline: calc(-1 * var(--space-5));
    padding: max(var(--space-4), env(safe-area-inset-top)) var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--menu-header-border, var(--color-border));
    background: var(--menu-header-bg, var(--color-canvas));
  }

  .menu-dialog__header::after {
    content: "";
    position: absolute;
    inset: calc(100% - 0.15rem) 0 auto;
    height: var(--menu-ornament-height, 0px);
    background: var(--menu-ornament, none);
    pointer-events: none;
  }

  .menu-close {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--text-2xl);
    line-height: 1;
    cursor: pointer;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    min-height: 3.65rem;
    align-items: center;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--menu-row-border, var(--color-border));
    border-radius: var(--radius-control);
    background: var(--menu-row-bg, var(--color-surface));
    color: var(--menu-ink, var(--color-ink));
    font-family: var(--font-heading);
    font-size: var(--text-heading);
    font-weight: 550;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  nav a.active {
    border-color: var(--menu-active, var(--color-primary));
    color: var(--menu-active, var(--color-primary));
  }

  nav a span {
    font-size: var(--text-base);
    color: var(--menu-muted, var(--color-ink-muted));
  }

  nav a.menu-contact {
    margin-top: var(--space-2);
    border-color: transparent;
    background: var(--menu-action-bg, var(--color-primary));
    color: var(--menu-action-fg, var(--color-on-primary, var(--color-inverse)));
  }

  nav a.menu-contact span {
    color: inherit;
  }

  .menu-overlay[data-state="open"] .menu-backdrop,
  .menu-overlay[data-state="open"] .menu-dialog {
    opacity: 1;
  }

  .menu-overlay[data-state="open"] .menu-dialog {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-overlay[data-state="open"] .menu-dialog {
      animation: menu-slide-in 280ms var(--motion-ease-out);
    }
    .menu-overlay[data-state="open"] .menu-backdrop {
      animation: menu-fade-in 240ms ease-out;
    }
  }

  @keyframes menu-slide-in {
    from {
      opacity: 0;
      transform: translateX(1.5rem);
    }
  }

  @keyframes menu-fade-in {
    from {
      opacity: 0;
    }
  }

  .menu-dialog__footer {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--space-4);
  }

  .menu-dialog__footer :global(.language-switch) {
    padding-inline: var(--space-3);
    border: 1px solid var(--menu-row-border, var(--color-border));
    border-radius: var(--radius-control);
    color: var(--menu-muted, var(--color-ink-muted));
  }

  @media (max-height: 30rem) {
    .menu-dialog__header {
      padding-block: max(var(--space-3), env(safe-area-inset-top)) var(--space-3);
    }
    ul {
      margin-top: var(--space-3);
    }
    nav a {
      min-height: 3.5rem;
      font-size: var(--text-heading);
    }
    .menu-dialog__footer {
      margin-top: var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .menu-overlay {
      display: none;
    }
  }
</style>

<script>
  import "../../lib/mobile-navigation";
</script>
