---
import type { Locale } from "../../types/site";
import Container from "../ui/Container.astro";
import GooglePlayBadge from "../ui/GooglePlayBadge.astro";

interface Props {
  locale: Locale;
  variant?: "home" | "catalog";
}

const { locale, variant = "catalog" } = Astro.props as Props;
const es = locale === "es";
const landingUrl = es ? "/es/productos/prestazo/" : "/en/products/prestazo/";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=com.prestamos.prestamos_app";
const letteringDesktop = es
  ? "/img/lettering/hero-lettering-es-desktop.svg"
  : "/img/lettering/hero-lettering-en-desktop.svg";
const letteringMobile = es
  ? "/img/lettering/hero-lettering-es-mobile.svg"
  : "/img/lettering/hero-lettering-en-mobile.svg";
const initialDesktop = es
  ? "/img/lettering/hero-initial-es-desktop.svg"
  : "/img/lettering/hero-initial-en-desktop.svg";
const initialMobile = es
  ? "/img/lettering/hero-initial-es-mobile.svg"
  : "/img/lettering/hero-initial-en-mobile.svg";
---

<section class="prestazo-featured" data-variant={variant} aria-labelledby={`prestazo-featured-${variant}`}>
  <Container>
    <article class="prestazo-featured__panel" data-reveal>
      <div class="prestazo-featured__content">
        <div class="prestazo-featured__eyebrow">{es ? "Nuevo producto" : "New product"}</div>
        <h2 class="prestazo-featured__sr-only" id={`prestazo-featured-${variant}`}>
          {es ? "Concéntrate en lo que realmente importa" : "Focus on what truly matters"}
        </h2>
        <div class="prestazo-featured__lettering">
          <picture class="prestazo-featured__lettering-main">
            <source media="(max-width: 40rem)" srcset={letteringMobile} />
            <img
              src={letteringDesktop}
              alt={es
                ? "Concéntrate en lo que realmente importa. Deja que Prestazo se encargue de facilitarte la gestión de tu cartera."
                : "Focus on what truly matters. Let Prestazo make managing your loan portfolio easier."}
              width="1400"
              height="970"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <picture class="prestazo-featured__lettering-initial" aria-hidden="true">
            <source media="(max-width: 40rem)" srcset={initialMobile} />
            <img src={initialDesktop} width="1400" height="970" loading="lazy" decoding="async" alt="" />
          </picture>
        </div>
        <div class="prestazo-featured__proof" aria-label={es ? "Beneficios de Prestazo" : "Prestazo benefits"}>
          <span>{es ? "Clientes" : "Customers"}</span>
          <span>{es ? "Préstamos" : "Loans"}</span>
          <span>{es ? "Cobros" : "Collections"}</span>
          <span>{es ? "Reportes" : "Reports"}</span>
        </div>
        <div class="prestazo-featured__actions">
          <a class="prestazo-featured__cta" href={landingUrl}>
            <span class="prestazo-featured__cta-label">
              <span class="prestazo-featured__cta-label-top">{es ? "Conocer" : "Explore"}</span>
              <span class="prestazo-featured__cta-label-bottom">Prestazo</span>
            </span>
          </a>
          <GooglePlayBadge class="prestazo-featured__google-play" locale={locale} href={googlePlayUrl} productName="Prestazo" />
        </div>
      </div>
      <a class="prestazo-featured__visual" href={landingUrl} aria-label={es ? "Abrir la landing page de Prestazo" : "Open the Prestazo product page"}>
        <div class="prestazo-featured__visual-glow" aria-hidden="true"></div>
        <img src="/img/prestazo-hero-personas-crecimiento.png" alt={es ? "Prestamista organizando su cartera con Prestazo" : "Lender organizing a portfolio with Prestazo"} width="1680" height="1050" loading={variant === "home" ? "eager" : "lazy"} decoding="async" />
      </a>
    </article>
  </Container>
</section>

<style>
  .prestazo-featured{padding:clamp(2rem,5vw,4.5rem) 0;background:var(--color-canvas)}
  .prestazo-featured[data-variant="catalog"]{padding-top:0;padding-bottom:clamp(2.5rem,5vw,5rem)}
  .prestazo-featured__panel{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);min-height:34rem;overflow:hidden;border:1px solid #1c6f67;border-radius:clamp(1rem,2vw,1.75rem);color:#f6fffc;background:linear-gradient(122deg,#061d2d 0%,#073a43 54%,#08705e 100%);box-shadow:0 1.5rem 4rem -2.6rem #052c3580}
  .prestazo-featured__panel::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 14% 8%,#49f0b439,transparent 32%),linear-gradient(90deg,#061d2d 0%,#061d2db8 39%,transparent 72%)}
  .prestazo-featured__content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;min-width:0;padding:clamp(2rem,4vw,4.25rem)}
  .prestazo-featured__eyebrow{margin-bottom:1.2rem;color:#8af4ce;font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .prestazo-featured__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .prestazo-featured__lettering{position:relative;display:block;width:min(100%,40rem);margin:-1rem 0 -.25rem}
  .prestazo-featured__lettering-main,.prestazo-featured__lettering-initial{display:block}
  .prestazo-featured__lettering-main img,.prestazo-featured__lettering-initial img{display:block;width:100%;height:auto}
  .prestazo-featured__lettering-initial{position:absolute;inset:0;pointer-events:none}
  .prestazo-featured__proof{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}
  .prestazo-featured__proof span{padding:.42rem .7rem;border:1px solid #70e7c34d;border-radius:999px;color:#d9fff1;background:#75e7c314;font-size:.78rem;font-weight:650}
  .prestazo-featured__actions{display:grid;grid-template-columns:repeat(2,var(--product-card-action-width));justify-content:center;gap:.75rem 1rem;margin-top:1.7rem}
  .prestazo-featured__cta{display:inline-flex;align-items:center;justify-content:center;width:var(--product-card-action-width);height:var(--product-card-action-height);box-sizing:border-box;padding:.45rem .75rem;border-radius:.55rem;color:#062c2a;background:#b8ffe2;font-size:var(--text-base);font-weight:750;line-height:1.08;text-align:center;text-decoration:none;white-space:normal;text-wrap:balance;transition:transform 180ms ease,background 180ms ease}
  .prestazo-featured__cta-label{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.08rem;min-width:0}
  .prestazo-featured__cta-label-top{font-size:.68em;font-weight:650;letter-spacing:.02em}
  .prestazo-featured__cta-label-bottom{font-size:1em;font-weight:800}
  .prestazo-featured__cta:hover{color:#062c2a;background:#e1fff3;transform:translateY(-2px)}
  .prestazo-featured__cta:focus-visible,.prestazo-featured__visual:focus-visible{outline:3px solid #f3d878;outline-offset:4px}
  .prestazo-featured__visual{position:relative;display:block;min-height:34rem;overflow:hidden;text-decoration:none}
  .prestazo-featured__visual::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#061d2d 0%,transparent 30%),linear-gradient(0deg,#061d2d66,transparent 30%);pointer-events:none}
  .prestazo-featured__visual img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 700ms cubic-bezier(.2,.7,.2,1),filter 300ms ease}
  .prestazo-featured__visual:hover img{transform:scale(1.035);filter:saturate(1.08)}
  .prestazo-featured__visual-glow{position:absolute;inset:15% 12%;z-index:1;border-radius:50%;background:#5dffd65c;filter:blur(5rem);pointer-events:none}
  @media(max-width:64rem){.prestazo-featured__panel{grid-template-columns:1fr}.prestazo-featured__content{padding-bottom:2rem}.prestazo-featured__visual{min-height:24rem}.prestazo-featured__visual::after{background:linear-gradient(0deg,#061d2d 0%,transparent 38%)}}
  @media(max-width:40rem){.prestazo-featured__content{padding:2rem 1.4rem 1.5rem}.prestazo-featured__lettering{width:100%;margin:-.5rem 0 0}.prestazo-featured__actions{grid-template-columns:1fr;justify-items:center}.prestazo-featured__cta{width:var(--product-card-action-width);max-width:100%;height:var(--product-card-action-height)}.prestazo-featured__visual{min-height:19rem}.prestazo-featured__visual img{object-position:58% center}}
  @media(prefers-reduced-motion:reduce){.prestazo-featured__visual img,.prestazo-featured__cta{transition:none}}
</style>
