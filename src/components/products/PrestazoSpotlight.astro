---
import type { Locale } from "../../types/site";
import Container from "../ui/Container.astro";

interface Props {
  locale: Locale;
  variant?: "home" | "catalog";
}

const { locale, variant = "catalog" } = Astro.props as Props;
const es = locale === "es";
const landingUrl = es ? "/es/productos/prestazo/" : "/en/products/prestazo/";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=com.prestamos.prestamos_app";
---

<section class="prestazo-featured" data-variant={variant} aria-labelledby={`prestazo-featured-${variant}`}>
  <Container>
    <article class="prestazo-featured__panel" data-reveal>
      <div class="prestazo-featured__content">
        <div class="prestazo-featured__eyebrow">{es ? "Nuevo producto" : "New product"}</div>
        <h2 id={`prestazo-featured-${variant}`}>{es ? "Concéntrate en lo que realmente importa" : "Focus on what truly matters"}</h2>
        <p class="prestazo-featured__description">
          {es
            ? "Y deja que Prestazo se encargue de facilitarte la gestión de tu cartera."
            : "And let Prestazo make managing your loan portfolio easier."}
        </p>
        <div class="prestazo-featured__proof" aria-label={es ? "Beneficios de Prestazo" : "Prestazo benefits"}>
          <span>{es ? "Clientes" : "Customers"}</span>
          <span>{es ? "Préstamos" : "Loans"}</span>
          <span>{es ? "Cobros" : "Collections"}</span>
          <span>{es ? "Reportes" : "Reports"}</span>
        </div>
        <div class="prestazo-featured__actions">
          <a class="prestazo-featured__cta" href={landingUrl}>{es ? "Conocer Prestazo" : "Explore Prestazo"}</a>
          <a class="prestazo-featured__secondary" href={googlePlayUrl} target="_blank" rel="noopener noreferrer">
            <svg class="prestazo-featured__play-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="#00c1ff" d="M3.4 2.6c-.25.28-.4.72-.4 1.28v16.24c0 .56.15 1 .4 1.28L13 12 3.4 2.6Z" />
              <path fill="#00f076" d="m14.05 13.05-2.7-2.64L3.4 2.6c.32-.34.84-.38 1.48-.02l11.02 6.26-1.85 4.21Z" />
              <path fill="#ffcf00" d="m14.05 13.05 1.85 4.21L4.88 19.02c-.64.36-1.16.32-1.48-.02l7.95-8.59 2.7 2.64Z" />
              <path fill="#ff3b57" d="m17.9 10.86 2.44 1.39c.88.5.88 1.32 0 1.82l-4.44 2.52-1.85-4.21 3.85-1.52Z" />
            </svg>
            <span>{es ? "Descargar en Google Play" : "Download on Google Play"}</span>
          </a>
        </div>
      </div>
      <a class="prestazo-featured__visual" href={landingUrl} aria-label={es ? "Abrir la landing page de Prestazo" : "Open the Prestazo product page"}>
        <div class="prestazo-featured__visual-glow" aria-hidden="true"></div>
        <img src="/img/prestazo-hero-personas-crecimiento.png" alt={es ? "Prestamista organizando su cartera con Prestazo" : "Lender organizing a portfolio with Prestazo"} width="1680" height="1050" loading={variant === "home" ? "eager" : "lazy"} decoding="async" />
      </a>
    </article>
  </Container>
</section>

<style>
  .prestazo-featured{padding:clamp(2rem,5vw,4.5rem) 0;background:var(--color-canvas)}
  .prestazo-featured[data-variant="catalog"]{padding-top:0;padding-bottom:clamp(2.5rem,5vw,5rem)}
  .prestazo-featured__panel{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);min-height:34rem;overflow:hidden;border:1px solid #1c6f67;border-radius:clamp(1rem,2vw,1.75rem);color:#f6fffc;background:linear-gradient(122deg,#061d2d 0%,#073a43 54%,#08705e 100%);box-shadow:0 1.5rem 4rem -2.6rem #052c3580}
  .prestazo-featured__panel::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 14% 8%,#49f0b439,transparent 32%),linear-gradient(90deg,#061d2d 0%,#061d2db8 39%,transparent 72%)}
  .prestazo-featured__content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;min-width:0;padding:clamp(2rem,4vw,4.25rem)}
  .prestazo-featured__eyebrow{margin-bottom:1.2rem;color:#8af4ce;font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .prestazo-featured h2{max-width:16ch;margin:0;color:inherit;font-size:clamp(2.25rem,4vw,4.1rem);font-weight:650;letter-spacing:-.055em;line-height:1.03;text-wrap:balance}
  .prestazo-featured__description{max-width:41ch;margin:1.4rem 0 0;color:#d7efea;font-size:clamp(1rem,1.35vw,1.16rem);line-height:1.6}
  .prestazo-featured__proof{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}
  .prestazo-featured__proof span{padding:.42rem .7rem;border:1px solid #70e7c34d;border-radius:999px;color:#d9fff1;background:#75e7c314;font-size:.78rem;font-weight:650}
  .prestazo-featured__actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem 1rem;margin-top:1.7rem}
  .prestazo-featured__cta{display:inline-flex;align-items:center;justify-content:center;height:4rem;padding:.8rem 1.25rem;border-radius:.6rem;color:#062c2a;background:#b8ffe2;font-size:var(--text-base);font-weight:750;line-height:1;text-decoration:none;white-space:nowrap;transition:transform 180ms ease,background 180ms ease}
  .prestazo-featured__cta:hover{color:#062c2a;background:#e1fff3;transform:translateY(-2px)}
  .prestazo-featured__secondary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:4rem;min-width:0;padding:.8rem 1.25rem;border-radius:.6rem;color:#062c2a;background:#b8ffe2;font-size:clamp(.78rem,1vw,1rem);font-weight:750;line-height:1;text-align:center;text-decoration:none;white-space:nowrap;transition:transform 180ms ease,background 180ms ease}
  .prestazo-featured__play-icon{display:block;flex:0 0 1.35rem;width:1.35rem;height:1.35rem}
  .prestazo-featured__secondary:hover{color:#062c2a;background:#e1fff3}
  .prestazo-featured__secondary:hover{transform:translateY(-2px)}
  .prestazo-featured__cta:focus-visible,.prestazo-featured__secondary:focus-visible,.prestazo-featured__visual:focus-visible{outline:3px solid #f3d878;outline-offset:4px}
  .prestazo-featured__visual{position:relative;display:block;min-height:34rem;overflow:hidden;text-decoration:none}
  .prestazo-featured__visual::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#061d2d 0%,transparent 30%),linear-gradient(0deg,#061d2d66,transparent 30%);pointer-events:none}
  .prestazo-featured__visual img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 700ms cubic-bezier(.2,.7,.2,1),filter 300ms ease}
  .prestazo-featured__visual:hover img{transform:scale(1.035);filter:saturate(1.08)}
  .prestazo-featured__visual-glow{position:absolute;inset:15% 12%;z-index:1;border-radius:50%;background:#5dffd65c;filter:blur(5rem);pointer-events:none}
  @media(max-width:64rem){.prestazo-featured__panel{grid-template-columns:1fr}.prestazo-featured__content{padding-bottom:2rem}.prestazo-featured__visual{min-height:24rem}.prestazo-featured__visual::after{background:linear-gradient(0deg,#061d2d 0%,transparent 38%)}}
  @media(max-width:40rem){.prestazo-featured__content{padding:2rem 1.4rem 1.5rem}.prestazo-featured h2{max-width:14ch}.prestazo-featured__actions{grid-template-columns:1fr}.prestazo-featured__cta,.prestazo-featured__secondary{width:100%}.prestazo-featured__secondary{font-size:var(--text-base)}.prestazo-featured__visual{min-height:19rem}.prestazo-featured__visual img{object-position:58% center}}
  @media(prefers-reduced-motion:reduce){.prestazo-featured__visual img,.prestazo-featured__cta,.prestazo-featured__secondary{transition:none}}
</style>
