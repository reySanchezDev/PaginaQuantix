---
import type { ProductPageContent } from "../../types/site";
import Container from "../ui/Container.astro";

interface Props {
  content: NonNullable<ProductPageContent["gallery"]>;
}

const { content } = Astro.props as Props;
---

<section
  class:list={[
    "section",
    "product-gallery",
    { "product-gallery--stories": content.layout === "stories" },
  ]}
  aria-labelledby="gallery-title"
>
  <Container>
    <div class="section-intro">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="gallery-title">{content.title}</h2>
      <p>{content.lead}</p>
    </div>
    <div class="gallery-grid">
      {
        content.items.map((item) => (
          <figure>
            {item.detailSrc ? (
              <a
                class="gallery-frame gallery-frame--link"
                data-reveal="image"
                href={item.detailSrc}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${content.detailLabel}: ${item.title}`}
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading={item.loading ?? "lazy"}
                  decoding="async"
                />
              </a>
            ) : (
              <div class="gallery-frame" data-reveal="image">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading={item.loading ?? "lazy"}
                  decoding="async"
                />
              </div>
            )}
            {(item.title || item.caption) && (
              <figcaption data-reveal data-motion-delay="80">
                {item.title && <h3>{item.title}</h3>}
                {item.caption && <p>{item.caption}</p>}
                {item.detailSrc && (
                  <a href={item.detailSrc} target="_blank" rel="noopener noreferrer">
                    {content.detailLabel}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                )}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .product-gallery {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-8) var(--space-5);
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  .gallery-frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-canvas);
  }
  .gallery-frame--link {
    transition: border-color var(--transition-fast);
  }
  .gallery-frame--link:hover {
    border-color: var(--color-primary);
  }

  img {
    width: 100%;
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--color-ink-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  figcaption p {
    margin: 0;
  }
  figcaption h3 {
    margin-bottom: 0.75rem;
    color: var(--color-ink);
    font-size: var(--text-heading);
    line-height: 1.2;
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
    text-underline-offset: 0.25em;
  }
  .product-gallery--stories .gallery-grid {
    grid-template-columns: 1fr;
    gap: 4rem;
  }
  .product-gallery--stories figure {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .product-gallery--stories figcaption {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.65;
  }
  @media (max-width: 52rem) {
    .product-gallery--stories figure {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .product-gallery--stories figcaption {
      max-width: 40rem;
    }
  }

  @media (min-width: 52rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    figure:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
