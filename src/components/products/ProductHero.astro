---
import type { ProductPageContent, ProductSummary } from "../../types/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  content: ProductPageContent;
  product: ProductSummary;
}

const { content, product } = Astro.props as Props;
const { hero } = content;
---

<section class="product-hero" data-product={content.id} aria-labelledby="product-title">
  <Container class="product-hero__layout">
    <div class="product-hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="product-title">{product.name}</h1>
      <p class="product-hero__tagline">{hero.title}</p>
      <p class="product-hero__lead">{hero.lead}</p>
      <div class="product-hero__actions">
        {
          hero.primary && (
            <Button href={hero.primary.href} target={hero.primary.target} size="lg">
              {hero.primary.label}
            </Button>
          )
        }
        {
          hero.secondary && (
            <Button
              href={hero.secondary.href}
              target={hero.secondary.target}
              variant="secondary"
              size="lg"
              class="product-secondary"
            >
              {hero.secondary.label}
            </Button>
          )
        }
      </div>
    </div>

    <div class="product-hero__visual">
      {
        hero.video ? (
          <figure class="video-shell">
            <video
              src={hero.video.src}
              poster={hero.video.poster}
              controls
              playsinline
              preload="none"
              aria-label={hero.video.label}
            />
            <figcaption>{hero.video.label}</figcaption>
          </figure>
        ) : (
          <div class="product-sheet">
            <p>{product.category}</p>
            <strong>{product.name}</strong>
            <div class="product-sheet__meta">
              <span>{product.status}</span>
              <span>Quantix Software</span>
            </div>
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .product-hero {
    --product-accent: #7fbcad;
    padding: clamp(var(--space-16), 8vw, var(--space-24)) 0;
    overflow: hidden;
    background: var(--color-dark);
  }

  .product-hero[data-product="viggo"] {
    --product-accent: #aaa5ee;
  }
  .product-hero[data-product="takofy"] {
    --product-accent: #78bdb4;
  }
  .product-hero[data-product="nica-finanzas"] {
    --product-accent: #91bd9e;
  }
  .product-hero[data-product="qavision"] {
    --product-accent: #91b5d3;
  }

  .product-hero__layout {
    display: grid;
    gap: clamp(var(--space-10), 7vw, var(--space-20));
    align-items: center;
  }

  .eyebrow {
    color: var(--product-accent);
  }

  h1 {
    color: var(--color-inverse);
    font-size: clamp(3.25rem, 8vw, 6.5rem);
    letter-spacing: -0.055em;
  }

  .product-hero__tagline {
    max-width: 24ch;
    margin: var(--space-5) 0 0;
    color: var(--color-inverse);
    font-size: clamp(var(--text-xl), 2.8vw, var(--text-3xl));
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: var(--leading-snug);
  }

  .product-hero__lead {
    max-width: 38rem;
    margin: var(--space-5) 0 0;
    color: var(--color-inverse-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .product-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .product-hero :global(.product-secondary) {
    border-color: rgb(239 242 237 / 0.45);
    color: var(--color-inverse);
  }

  .product-hero :global(.product-secondary:hover) {
    border-color: var(--color-inverse);
    color: var(--color-inverse);
  }

  .video-shell {
    margin: 0;
    border: 1px solid rgb(239 242 237 / 0.25);
    background: var(--color-dark-raised);
    box-shadow: var(--shadow-lg);
  }

  video {
    width: 100%;
    aspect-ratio: 1.95 / 1;
    background: #0d1511;
  }

  figcaption {
    padding: var(--space-3) var(--space-4);
    color: var(--color-inverse-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .product-sheet {
    padding: clamp(var(--space-6), 5vw, var(--space-10));
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .product-sheet > p {
    margin: 0 0 var(--space-12);
    color: var(--color-ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-sheet > strong {
    display: block;
    margin-bottom: var(--space-10);
    color: var(--color-ink);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    letter-spacing: -0.04em;
  }

  .product-sheet__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-strong);
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (min-width: 56rem) {
    .product-hero__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(26rem, 1.1fr);
    }
  }

  @media (max-width: 40rem) {
    .product-hero__actions {
      display: grid;
    }
  }
</style>
