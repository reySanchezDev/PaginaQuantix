---
import type { ProductPageContent } from "../../types/site";
import Container from "../ui/Container.astro";

interface Props {
  content: NonNullable<ProductPageContent["release"]>;
}

const { content } = Astro.props as Props;
---

<section class="release-notes" aria-labelledby="release-title">
  <Container class="release-notes__layout">
    <div>
      <p class="eyebrow">{content.label}</p>
      <h2 id="release-title">v{content.version}</h2>
      {content.date && <time datetime={content.date}>{content.date}</time>}
    </div>
    <div class="release-notes__detail">
      <ul>{content.changes.map((change) => <li>{change}</li>)}</ul>
      {
        content.checksum && (
          <dl>
            <dt>{content.checksum.label}</dt>
            <dd>
              <span>
                {content.checksum.algorithm} · {content.checksum.size}
              </span>
              <code>{content.checksum.value}</code>
            </dd>
          </dl>
        )
      }
    </div>
  </Container>
</section>

<style>
  .release-notes {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    background: var(--color-dark);
    color: var(--color-inverse);
  }

  .release-notes__layout {
    display: grid;
    gap: var(--space-10);
  }

  .eyebrow,
  time {
    color: var(--color-inverse-muted);
  }

  h2 {
    margin-bottom: var(--space-3);
    color: var(--color-inverse);
    font-size: var(--text-5xl);
  }

  time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: var(--space-5);
    color: var(--color-inverse-muted);
    line-height: var(--leading-relaxed);
  }

  dl {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid rgb(239 242 237 / 0.2);
  }

  dt,
  dd {
    margin: 0;
  }

  dt,
  dd span {
    color: var(--color-inverse-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  dd {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  code {
    overflow-wrap: anywhere;
    color: var(--color-inverse);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (min-width: 56rem) {
    .release-notes__layout {
      grid-template-columns: minmax(12rem, 0.45fr) minmax(0, 1.55fr);
    }
  }
</style>
