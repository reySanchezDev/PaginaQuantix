---
import ProductLayout from "../../layouts/ProductLayout.astro";
import ContactSection from "../sections/ContactSection.astro";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { products } from "../../data/products";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props as Props;
const product = products.find((item) => item.id === "viggo");

if (!product) {
  throw new Error("Producto no encontrado: viggo");
}

const isEs = lang === "es";
const contactHref = isEs ? "/es/contacto/" : "/en/contact/";
const flowHref = "#viggo-flow";
const primaryCtaHref = product.publicUrl ?? contactHref;
const primaryCtaLabel = product.publicUrl
  ? isEs
    ? "Ir a VIGGO"
    : "Go to VIGGO"
  : product.externalLabel?.[lang] ?? (isEs ? "Solicitar información" : "Request information");

const copy = isEs
  ? {
      title: "VIGGO - Operación integral para negocios",
      description:
        "VIGGO ayuda a negocios que gestionan servicios, inventario o ambos a controlar clientes, ventas, cobros, accesos e historial desde una sola operación.",
      h1: "VIGGO",
      lead:
        "VIGGO conecta clientes, servicios, inventario y ventas en una operación controlada desde el primer día. No importa dónde estés: puedes ver cómo avanza tu negocio en tiempo real y administrarlo con información confiable.",
      secondaryCta: "Ver flujo operativo",
      positioningKicker: "Operación conectada",
      positioningTitle: "Clientes, servicios, inventario y ventas trabajando en una misma operación",
      positioningLead:
        "VIGGO organiza la información clave del negocio en un flujo lógico: primero el cliente, luego los servicios que utiliza, el inventario que se mueve, las ventas que se registran, los cobros que se reciben y el historial que respalda cada decisión.",
      remoteTitle: "Dirige tu negocio aunque no estés en la sede",
      remoteText:
        "Consulta clientes atendidos, servicios activos, inventario, ventas, cobros, accesos y actividad diaria desde una visión actualizada. VIGGO permite supervisar resultados y tomar decisiones mientras el equipo sigue atendiendo.",
      positioningCards: [
        ["Clientes como punto de partida", "Cada atención inicia con un perfil consultable, estado visible y relación clara con servicios, accesos e historial."],
        ["Servicios con vigencia controlada", "Planes, renovaciones, vencimientos y condiciones de uso se mantienen visibles para atender con seguridad."],
        ["Inventario conectado a la venta", "Cada salida de inventario actualiza existencias, movimientos y Kardex sin separar el registro comercial."],
        ["Ventas y cobros trazables", "Pagos, métodos, comprobantes, cierres e historial quedan vinculados al movimiento real del negocio."],
      ],
      heroMetrics: [
        ["Clientes", "Activos, vencidos y por renovar"],
        ["Servicios", "Planes, vigencias y renovaciones"],
        ["Inventario", "Compras, stock por sede y Kardex"],
        ["Ventas", "Cobros, comprobantes y cierres"],
      ],
      inventoryKicker: "Inventario conectado",
      inventoryTitle: "Inventario que opera al mismo nivel que ventas",
      inventoryLead:
        "VIGGO trata el inventario como parte central del negocio: compras, inventario inicial, stock por sede, ubicaciones, transferencias, conteos físicos, transacciones, auditoría y Kardex quedan conectados con ventas, cobros y comprobantes.",
      inventoryHighlights: [
        ["Catálogos completos", "Unidades, marcas, categorías, subcategorías, proveedores, ubicaciones y tipos de movimiento para ordenar la base operativa."],
        ["Stock por sede", "Existencias visibles por ítem de inventario, sede y ubicación, con mínimos de referencia para detectar reposición a tiempo."],
        ["Compras y movimientos", "Entradas, salidas, ajustes y documentos de inventario quedan registrados con trazabilidad."],
        ["Transferencias y conteos", "Mueve inventario entre sedes o ubicaciones y compara la existencia real contra el registro operativo."],
        ["Kardex por ítem", "Consulta entradas, salidas, documentos y saldo por sede en una línea de tiempo clara."],
        ["Auditoría de consistencia", "Revisa diferencias entre stock, ubicaciones y Kardex para actuar antes de que afecten la operación."],
      ],
      inventoryFlow: [
        "Configura inventario, proveedores, unidades y ubicaciones.",
        "Registra inventario inicial, compras, ajustes o transferencias.",
        "Registra ventas y el stock se actualiza dentro del mismo flujo.",
        "Consulta Kardex, transacciones, saldos y auditoría para tomar decisiones.",
      ],
      painsTitle: "Controles críticos que VIGGO ayuda a ordenar",
      painsLead:
        "Cuando clientes, servicios, inventario, ventas y cobros se administran por separado, el negocio pierde visibilidad, aumenta el retrabajo y se vuelve más difícil tomar decisiones con confianza.",
      pains: [
        {
          title: "Clientes sin estado claro",
          text: "Saber quién está activo, vencido, moroso, bloqueado o pendiente deja de depender de memoria, mensajes o listas sueltas.",
        },
        {
          title: "Cobros dispersos",
          text: "Pagos, renovaciones, transacciones y cierres quedan vinculados al cliente, al servicio prestado y al movimiento comercial.",
        },
        {
          title: "Inventario separado",
          text: "Compras, stock, movimientos, ventas y Kardex dejan de vivir aparte del servicio al cliente.",
        },
        {
          title: "Accesos sin control",
          text: "La credencial digital ayuda a validar clientes, localizar perfiles y tomar decisiones operativas con información visible.",
        },
        {
          title: "Ventas sin trazabilidad",
          text: "Cobros, métodos de pago, comprobantes, cierres, diferencias y transacciones quedan disponibles para revisión.",
        },
        {
          title: "Decisiones sin historia",
          text: "Pagos, vigencias, accesos, inventario y movimientos dejan evidencia consultable para revisar cada evento importante.",
        },
      ],
      capabilitiesTitle: "Una operación completa, no módulos aislados",
      capabilitiesLead:
        "VIGGO conecta áreas que normalmente terminan divididas entre registros manuales, hojas de cálculo, mensajes, procesos de venta e inventario sin seguimiento.",
      capabilities: [
        ["Clientes y servicios", "Registro, perfiles, planes, vigencias, renovaciones y estados visibles."],
        ["Ventas y cobros", "Transacciones, pagos, comprobantes, cierres, historial y control diario."],
        ["Inventario avanzado", "Catálogo, compras, inventario inicial, stock por sede, transferencias, conteos, auditoría y Kardex."],
        ["Credencial y validación", "Identificación digital para consultar, validar y actuar según el estado del cliente."],
        ["Usuarios y permisos", "Roles para que cada persona opere solo lo que corresponde."],
        ["Historial operativo", "Pagos, vigencias, accesos, ventas e inventario con seguimiento consultable."],
      ],
      differentiatorsTitle: "Por qué VIGGO marca diferencia en la operación",
      differentiatorsLead:
        "Su valor está en conectar áreas que normalmente trabajan por separado, sin perder visibilidad entre clientes, servicios, inventario, ventas, cobros y accesos.",
      differentiators: [
        ["Operación integral", "Clientes, servicios, inventario, ventas y control de acceso no viven como procesos aislados."],
        ["Trazabilidad real", "Cada cobro, venta, movimiento y cambio conserva contexto para revisión posterior."],
        ["Preparado para crecer", "Usuarios, roles, sedes, ubicaciones y stock se ordenan sin perder control operativo."],
        ["Dirección en tiempo real", "El dashboard convierte el trabajo diario en ventas, cobros, ticket promedio, alertas y señales para actuar."],
      ],
      outcomeTitle: "Impacto para el negocio",
      outcomeText:
        "Mayor orden operativo, más claridad en atención, ventas y cobros, mejor visibilidad sobre lo que se mueve en inventario y quién puede utilizar cada servicio.",
      resultsTitle: "Beneficios para el negocio",
      resultsLead:
        "VIGGO reduce fricción operativa y convierte la rutina diaria en control medible para equipos que necesitan atender mejor y crecer con orden.",
      results: [
        ["Cierres más confiables", "Ventas, cobros e historial se revisan con datos conectados."],
        ["Inventario más confiable", "Ventas, compras, transferencias, conteos y Kardex cuentan la misma historia."],
        ["Atención más rápida", "El equipo consulta estado, vigencias y registros sin buscar en listas externas."],
        ["Más control para crecer", "La operación queda preparada para más clientes, servicios, inventario y sedes."],
      ],
      flow: [
        "Registra clientes, servicios, inventario y reglas de operación.",
        "Gestiona ventas y cobros de servicios, inventario o combinaciones.",
        "Controla vigencias, renovaciones, stock por sede, compras, transferencias y movimientos.",
        "Valida credenciales, consulta estados y conserva historial.",
      ],
      contactTitle: "¿Quieres implementar VIGGO en tu operación?",
      contactDescription:
        "Conoce cómo VIGGO puede ordenar la operación de tu negocio y llevar clientes, servicios, inventario, ventas y control diario a un mismo flujo.",
    }
  : {
      title: "VIGGO - Integrated business operations",
      description:
        "VIGGO helps businesses that manage services, inventory, or both control customers, sales, payments, access, and history from one operating flow.",
      h1: "VIGGO",
      lead:
        "VIGGO connects customers, services, inventory, and sales into a controlled operation from day one. Wherever you are, you can see how your business is moving in real time and manage it with reliable information.",
      secondaryCta: "View operating flow",
      positioningKicker: "Connected operations",
      positioningTitle: "Customers, services, inventory, and sales working in one operating flow",
      positioningLead:
        "VIGGO organizes the key information of the business in a logical flow: first the customer, then the services they use, the inventory that moves, the sales that are recorded, the payments received, and the history behind each decision.",
      remoteTitle: "Run your business even when you are not on site",
      remoteText:
        "Review served customers, active services, inventory, sales, payments, access, and daily activity from an up-to-date view. VIGGO helps you supervise results and make decisions while your team keeps serving customers.",
      positioningCards: [
        ["Customers as the starting point", "Each interaction starts with a searchable profile, visible status, and a clear relationship with services, access, and history."],
        ["Services with controlled validity", "Plans, renewals, expiration dates, and usage conditions remain visible for reliable service."],
        ["Inventory connected to sales", "Each inventory exit updates stock, movements, and Kardex without separating the commercial record."],
        ["Traceable sales and payments", "Payments, methods, receipts, closings, and history remain linked to real business movement."],
      ],
      heroMetrics: [
        ["Customers", "Active, expired, and up for renewal"],
        ["Services", "Plans, validity periods, and renewals"],
        ["Inventory", "Purchases, branch stock, and Kardex"],
        ["Sales", "Payments, receipts, and closings"],
      ],
      inventoryKicker: "Connected inventory",
      inventoryTitle: "Inventory that operates at the same level as sales",
      inventoryLead:
        "VIGGO treats inventory as a core part of the business: purchases, initial inventory, branch stock, locations, transfers, physical counts, transactions, audit, and Kardex stay connected to sales, payments, and receipts.",
      inventoryHighlights: [
        ["Complete catalogs", "Units, brands, categories, subcategories, suppliers, locations, and movement types to organize the operating base."],
        ["Stock by branch", "Visible stock by inventory item, branch, and location, with reference minimums to detect replenishment needs on time."],
        ["Purchases and movements", "Entries, exits, adjustments, and inventory documents remain recorded with traceability."],
        ["Transfers and counts", "Move inventory between branches or locations and compare real stock against operational records."],
        ["Item Kardex", "Review entries, exits, documents, and branch balance in a clear timeline."],
        ["Consistency audit", "Review differences between stock, locations, and Kardex to act before they affect operations."],
      ],
      inventoryFlow: [
        "Configure inventory, suppliers, units, and locations.",
        "Register initial inventory, purchases, adjustments, or transfers.",
        "Register sales and stock updates inside the same flow.",
        "Review Kardex, transactions, balances, and audit to make decisions.",
      ],
      painsTitle: "Critical controls VIGGO helps organize",
      painsLead:
        "When customers, services, inventory, sales, and payments are managed separately, the business loses visibility, rework increases, and confident decisions become harder.",
      pains: [
        {
          title: "Unclear customer status",
          text: "Knowing who is active, expired, delinquent, blocked, or pending no longer depends on memory, messages, or loose lists.",
        },
        {
          title: "Scattered payments",
          text: "Payments, renewals, transactions, and closings remain linked to the customer, the service delivered, and the commercial movement.",
        },
        {
          title: "Separate inventory",
          text: "Purchases, stock, movements, sales, and Kardex stop living apart from customer service.",
        },
        {
          title: "Access without control",
          text: "The digital credential helps validate customers, locate profiles, and act with visible operating information.",
        },
        {
          title: "Sales without traceability",
          text: "Payments, payment methods, receipts, closings, differences, and transactions remain available for review.",
        },
        {
          title: "Decisions without history",
          text: "Payments, validity periods, access, inventory, and movements leave searchable evidence for each important event.",
        },
      ],
      capabilitiesTitle: "A complete operation, not isolated modules",
      capabilitiesLead:
        "VIGGO connects areas that often end up split across manual records, spreadsheets, messages, sales processes, and inventory without follow-up.",
      capabilities: [
        ["Customers and services", "Profiles, plans, validity periods, renewals, and visible status."],
        ["Sales and payments", "Transactions, payments, receipts, closings, history, and daily control."],
        ["Advanced inventory", "Catalog, purchases, initial inventory, stock by branch, transfers, counts, audit, and Kardex."],
        ["Credential and validation", "Digital identification to consult, validate, and act based on customer status."],
        ["Users and permissions", "Roles so each person operates only what they should."],
        ["Operational history", "Payments, validity periods, access, sales, and inventory with searchable follow-up."],
      ],
      differentiatorsTitle: "What makes VIGGO different in day-to-day operations",
      differentiatorsLead:
        "Its value is connecting areas that usually work separately, without losing visibility across customers, services, inventory, sales, payments, and access.",
      differentiators: [
        ["Integrated operation", "Customers, services, inventory, sales, and access control do not live as isolated processes."],
        ["Real traceability", "Every payment, sale, movement, and change keeps context for later review."],
        ["Ready to grow", "Users, roles, branches, locations, and stock stay organized without losing operational control."],
        ["Real-time direction", "The dashboard turns daily work into sales, payments, average ticket, alerts, and signals to act."],
      ],
      outcomeTitle: "Business impact",
      outcomeText:
        "Greater operational order, clearer service, sales, and payment processes, and better visibility into what moves in inventory and who can use each service.",
      resultsTitle: "Business benefits",
      resultsLead:
        "VIGGO reduces operational friction and turns daily routines into measurable control for teams that need better service and organized growth.",
      results: [
        ["More reliable closings", "Sales, payments, and history are reviewed with connected data."],
        ["More reliable inventory", "Sales, purchases, transfers, counts, and Kardex tell the same story."],
        ["Faster service", "The team reviews status, validity periods, and records without searching external lists."],
        ["More control to grow", "The operation is prepared for more customers, services, inventory, and branches."],
      ],
      flow: [
        "Register customers, services, inventory, and operating rules.",
        "Manage sales and payments for services, inventory, or combinations.",
        "Control validity periods, renewals, branch stock, purchases, transfers, and movements.",
        "Validate credentials, review status, and keep history.",
      ],
      contactTitle: "Want to bring VIGGO into your operation?",
      contactDescription:
        "See how VIGGO can organize your business operation and bring customers, services, inventory, sales, and daily control into one flow.",
    };
---

<ProductLayout title={copy.title} description={copy.description} lang={lang}>
  <section class="viggo-hero" aria-labelledby="viggo-title">
    <Container>
      <div class="viggo-hero__grid">
        <div class="viggo-hero__content">
          <h1 id="viggo-title">{copy.h1}</h1>
          <p>{copy.lead}</p>
          <div class="viggo-actions">
            <Button href={primaryCtaHref} target={product.publicUrl ? "_blank" : undefined} variant="primary" size="lg">
              {primaryCtaLabel}
            </Button>
            <Button href={flowHref} variant="secondary" size="lg">{copy.secondaryCta}</Button>
          </div>
        </div>

        <div class="viggo-hero__preview" aria-hidden="true">
          <div class="hero-video-shell">
            <div class="hero-video-shell__top">
              <i></i><i></i><i></i>
              <span>VIGGO Dashboard</span>
            </div>
            <video
              src="/videos/viggo/dashboard-video.mp4"
              poster="/images/viggo/viggo-dashboard.png"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="viggo-positioning" aria-labelledby="viggo-positioning-title">
    <Container>
      <div class="positioning-panel">
        <div class="section-heading section-heading--wide">
          <span class="viggo-kicker">{copy.positioningKicker}</span>
          <h2 id="viggo-positioning-title">{copy.positioningTitle}</h2>
          <p>{copy.positioningLead}</p>
        </div>

        <div class="positioning-grid">
          {copy.positioningCards.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>

        <div class="remote-control-panel">
          <div>
            <span>{isEs ? "Visión del negocio" : "Business visibility"}</span>
            <h3>{copy.remoteTitle}</h3>
          </div>
          <p>{copy.remoteText}</p>
        </div>
      </div>
    </Container>
  </section>

  <section id="viggo-flow" class="viggo-showcase" aria-labelledby="viggo-showcase-title">
    <Container>
      <div class="showcase-heading">
        <span class="viggo-kicker">{isEs ? "VIGGO en operación" : "VIGGO in operation"}</span>
        <h2 id="viggo-showcase-title">{isEs ? "Ventas, transacciones e inventario conectados" : "Sales, transactions, and inventory connected"}</h2>
        <p>
          {isEs
            ? "Desde la preparación de ventas hasta el historial de transacciones y el Kardex, VIGGO deja visible cada paso comercial y operativo."
            : "From sales preparation to transaction history and Kardex, VIGGO keeps each commercial and operational step visible."}
        </p>
      </div>

      <div class="showcase-flow" aria-label={isEs ? "Flujo de ventas hacia Kardex" : "Sales to Kardex flow"}>
        <article class="pos-mockup pos-mockup--cash">
          <div class="pos-mockup__label">
            <span>01</span>
            <strong>{isEs ? "Ventas preparadas y bajo control" : "Sales ready and controlled"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Gestión de ventas" : "Sales management"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-gestion-2.png"
                alt={isEs ? "Pantalla de VIGGO mostrando preparación y gestión de ventas" : "VIGGO screen showing sales preparation and management"}
                loading="eager"
                width="1916"
                height="940"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "ventas listas" : "sales ready"}</span>
        </div>

        <article class="pos-mockup pos-mockup--sales">
          <div class="pos-mockup__label">
            <span>02</span>
            <strong>{isEs ? "La venta queda facturada" : "The sale is invoiced"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Factura en VIGGO" : "Invoice in VIGGO"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-factura.png"
                alt={isEs ? "Pantalla de VIGGO creando una factura de venta" : "VIGGO screen creating a sales invoice"}
                loading="eager"
                width="1919"
                height="944"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "primera venta" : "first sale"}</span>
        </div>

        <article class="pos-mockup pos-mockup--sales">
          <div class="pos-mockup__label">
            <span>03</span>
            <strong>{isEs ? "La venta crece con más detalle" : "The sale grows with more detail"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Factura ampliada" : "Expanded invoice"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-factura-2.png"
                alt={isEs ? "Pantalla de VIGGO creando una segunda factura con más detalle de venta" : "VIGGO screen creating a second invoice with more sales detail"}
                loading="eager"
                width="1918"
                height="944"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "ventas registradas" : "sales recorded"}</span>
        </div>

        <article class="pos-mockup pos-mockup--history">
          <div class="pos-mockup__label">
            <span>04</span>
            <strong>{isEs ? "Historial de transacciones" : "Transaction history"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Historial de ventas" : "Sales history"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-historial-transacciones-2.png"
                alt={isEs ? "Pantalla de VIGGO mostrando historial de transacciones de ambas facturas" : "VIGGO screen showing transaction history from both invoices"}
                loading="eager"
                width="1918"
                height="936"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "movimiento visible" : "movement visible"}</span>
        </div>

        <article class="pos-mockup pos-mockup--kardex">
          <div class="pos-mockup__label">
            <span>05</span>
            <strong>{isEs ? "Kardex registra el movimiento" : "Kardex records the movement"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>Kardex</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-kardex-2.png"
                alt={isEs ? "Pantalla de VIGGO Kardex mostrando movimientos de inventario de ambas ventas" : "VIGGO Kardex screen showing inventory movements from both sales"}
                loading="eager"
                width="1917"
                height="941"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "operación resumida" : "operation summarized"}</span>
        </div>

        <article class="pos-mockup pos-mockup--dashboard">
          <div class="pos-mockup__label">
            <span>06</span>
            <strong>{isEs ? "Dashboard resume la operación" : "Dashboard summarizes the operation"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>Dashboard</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-dashboard.png"
                alt={isEs ? "Dashboard de VIGGO resumiendo ventas, cobros e indicadores del día" : "VIGGO dashboard summarizing daily sales, payments, and indicators"}
                loading="eager"
                width="1917"
                height="945"
              />
            </div>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <section class="viggo-strip" aria-label={isEs ? "Áreas principales de VIGGO" : "VIGGO main areas"}>
    <Container>
      <div class="viggo-strip__grid">
        {copy.heroMetrics.map(([label, text]) => (
          <article>
            <strong>{label}</strong>
            <span>{text}</span>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="inventory-focus" aria-labelledby="inventory-focus-title">
    <Container>
      <div class="inventory-focus__layout">
        <div class="inventory-focus__intro">
          <span class="viggo-kicker">{copy.inventoryKicker}</span>
          <h2 id="inventory-focus-title">{copy.inventoryTitle}</h2>
          <p>{copy.inventoryLead}</p>

          <ol class="inventory-flow">
            {copy.inventoryFlow.map((item) => <li>{item}</li>)}
          </ol>
        </div>

        <div class="inventory-highlight-grid">
          {copy.inventoryHighlights.map(([title, text]) => (
