---
import ProductLayout from "../../layouts/ProductLayout.astro";
import ContactSection from "../sections/ContactSection.astro";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { products } from "../../data/products";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props as Props;
const product = products.find((item) => item.id === "viggo");

if (!product) {
  throw new Error("Producto no encontrado: viggo");
}

const isEs = lang === "es";
const contactHref = isEs ? "/es/contacto/" : "/en/contact/";
const flowHref = "#viggo-flow";
const primaryCtaHref = product.publicUrl ?? contactHref;
const primaryCtaLabel = product.publicUrl
  ? isEs
    ? "Ir a VIGGO"
    : "Go to VIGGO"
  : product.externalLabel?.[lang] ?? (isEs ? "Solicitar información" : "Request information");

const copy = isEs
  ? {
      title: "VIGGO - Operación integral para negocios",
      description:
        "VIGGO ayuda a negocios que venden servicios, productos o ambos a controlar clientes, cobros, caja, inventario, accesos e historial desde una sola operación.",
      launchLabel: "Próximo lanzamiento",
      launchText: "Disponible el miércoles 10 de junio de 2026",
      h1: "VIGGO",
      lead:
        "VIGGO convierte ventas, servicios, caja, inventario y clientes en una operación controlada desde el primer día. Diseñado para negocios que necesitan trazabilidad real, atención ágil y datos confiables para crecer.",
      secondaryCta: "Ver flujo operativo",
      positioningKicker: "Operación conectada",
      positioningTitle: "Todo lo que pasa en el negocio, conectado en una misma operación",
      positioningLead:
        "VIGGO no se limita a registrar ventas: une clientes, servicios, productos, cobros, stock, accesos, roles e historial para que cada atención deje evidencia y cada decisión tenga contexto.",
      positioningCards: [
        ["Vende servicios, productos o ambos", "Arma operaciones mixtas sin separar caja, atención e inventario."],
        ["Caja con trazabilidad diaria", "Aperturas, cobros, métodos de pago, cierres e historial quedan conectados."],
        ["Inventario que responde a la venta", "Cada producto vendido actualiza movimientos, existencias y Kardex."],
        ["Clientes con estado visible", "Vigencias, renovaciones, accesos y condiciones operativas quedan al alcance del equipo."],
      ],
      heroMetrics: [
        ["Clientes", "Activos, vencidos y por renovar"],
        ["Caja", "Cobros, turnos y cierres"],
        ["Inventario", "Compras, stock por sede y Kardex"],
        ["Acceso", "Credencial y validación operativa"],
      ],
      inventoryKicker: "Inventario conectado",
      inventoryTitle: "Inventario que opera al mismo nivel que caja",
      inventoryLead:
        "VIGGO trata el inventario como parte central de la operación: productos, compras, inventario inicial, stock por sede, ubicaciones, transferencias, conteos físicos, transacciones, auditoría y Kardex quedan conectados con caja y facturación.",
      inventoryHighlights: [
        ["Catálogos completos", "Unidades, marcas, categorías, subcategorías, proveedores, ubicaciones y tipos de movimiento para ordenar la base operativa."],
        ["Stock por sede", "Existencias visibles por producto, sede y ubicación, con mínimos de referencia para detectar reposición a tiempo."],
        ["Compras y movimientos", "Entradas, salidas, ajustes y documentos de inventario quedan registrados con trazabilidad."],
        ["Transferencias y conteos", "Mueve inventario entre sedes o ubicaciones y compara la existencia real contra el registro operativo."],
        ["Kardex por producto", "Consulta entradas, salidas, documentos y saldo por sede en una línea de tiempo clara."],
        ["Auditoría de consistencia", "Revisa diferencias entre stock, ubicaciones y Kardex para actuar antes de que afecten la operación."],
      ],
      inventoryFlow: [
        "Configura productos, proveedores, unidades y ubicaciones.",
        "Registra inventario inicial, compras, ajustes o transferencias.",
        "Vende desde caja y el stock se actualiza dentro del mismo flujo.",
        "Consulta Kardex, transacciones, saldos y auditoría para tomar decisiones.",
      ],
      painsTitle: "Controles críticos que VIGGO ayuda a ordenar",
      painsLead:
        "A medida que un negocio crece, los registros separados, los controles manuales y los cobros sin seguimiento pueden afectar la eficiencia, la rentabilidad y la confianza operativa.",
      pains: [
        {
          title: "Clientes sin estado claro",
          text: "Saber quién está activo, vencido, moroso, bloqueado o pendiente deja de depender de memoria, mensajes o listas sueltas.",
        },
        {
          title: "Cobros dispersos",
          text: "Los pagos, renovaciones, transacciones y cierres quedan conectados a la operación real del cliente y del negocio.",
        },
        {
          title: "Inventario separado",
          text: "Productos, compras, stock, movimientos y ventas dejan de vivir aparte de caja y atención.",
        },
        {
          title: "Accesos sin control",
          text: "La credencial digital ayuda a validar clientes, localizar perfiles y tomar decisiones operativas con información visible.",
        },
        {
          title: "Caja sin trazabilidad",
          text: "Aperturas, cierres, métodos de pago, diferencias y transacciones quedan disponibles para revisión.",
        },
        {
          title: "Decisiones sin historia",
          text: "Pagos, vigencias, accesos, inventario y movimientos dejan registro para consultar lo que realmente pasó.",
        },
      ],
      capabilitiesTitle: "Una operación completa, no herramientas aisladas",
      capabilitiesLead:
        "VIGGO conecta las áreas que normalmente terminan divididas entre registros manuales, hojas de cálculo, mensajes, procesos de caja y controles no estandarizados.",
      capabilities: [
        ["Clientes y servicios", "Registro, perfiles, planes, vigencias, renovaciones y estados visibles."],
        ["Caja y cobros", "Transacciones, pagos, turnos, cierres, historial y control diario."],
        ["Inventario avanzado", "Productos, compras, inventario inicial, stock por sede, transferencias, conteos, auditoría y Kardex."],
        ["Credencial y validación", "Identificación digital para consultar, validar y actuar según el estado del cliente."],
        ["Usuarios y permisos", "Roles para que cada persona opere solo lo que corresponde."],
        ["Historial operativo", "Pagos, vigencias, accesos, caja e inventario con seguimiento consultable."],
      ],
      differentiatorsTitle: "Por qué VIGGO marca diferencia en la operación",
      differentiatorsLead:
        "Su valor está en conectar áreas que normalmente trabajan por separado, sin obligar al negocio a perder visibilidad entre caja, atención, inventario y control.",
      differentiators: [
        ["Operación integral", "Atención, caja, inventario y control de acceso no viven en pantallas aisladas."],
        ["Trazabilidad real", "Cada cobro, venta, movimiento y cambio conserva contexto para revisión posterior."],
        ["Preparado para crecer", "Usuarios, roles, sedes, ubicaciones y stock se ordenan sin perder control operativo."],
        ["Información para decidir", "El dashboard convierte el trabajo diario en ventas, cobros, ticket promedio y alertas."],
      ],
      outcomeTitle: "Impacto para el negocio",
      outcomeText:
        "Mayor orden operativo, más claridad en atención y caja, mejor visibilidad sobre lo que se vende, lo que se cobra, lo que queda en inventario y quién puede utilizar cada servicio.",
      resultsTitle: "Beneficios para el negocio",
      resultsLead:
        "VIGGO reduce fricción operativa y convierte la rutina diaria en control medible para equipos que necesitan atender mejor y crecer con orden.",
      results: [
        ["Menos diferencias al cierre", "Caja e historial se revisan con datos conectados."],
        ["Inventario más confiable", "Ventas, compras, transferencias, conteos y Kardex cuentan la misma historia."],
        ["Atención más rápida", "El equipo consulta estado, vigencias y registros sin buscar en listas externas."],
        ["Más control para crecer", "La operación queda preparada para más clientes, productos, servicios y sedes."],
      ],
      flow: [
        "Registra clientes, productos, servicios y reglas de operación.",
        "Cobra servicios, productos o combinaciones desde caja.",
        "Controla vigencias, renovaciones, stock por sede, compras, transferencias y movimientos.",
        "Valida credenciales, consulta estados y conserva historial.",
      ],
      contactTitle: "¿Quieres conocer VIGGO antes del lanzamiento?",
      contactDescription:
        "Solicita información a Quantix y conversemos sobre cómo VIGGO puede ordenar la operación de tu negocio antes de su salida oficial.",
    }
  : {
      title: "VIGGO - Integrated business operations",
      description:
        "VIGGO helps businesses that sell services, products, or both control customers, payments, cash desk, inventory, access, and history from one operating flow.",
      launchLabel: "Coming soon",
      launchText: "Available Wednesday, June 10, 2026",
      h1: "VIGGO",
      lead:
        "VIGGO turns sales, services, cash desk, inventory, and customers into a controlled operation from day one. Built for businesses that need real traceability, faster service, and reliable data to grow.",
      secondaryCta: "View operating flow",
      positioningKicker: "Connected operations",
      positioningTitle: "Everything that happens in the business, connected in one operating flow",
      positioningLead:
        "VIGGO goes beyond recording sales: it connects customers, services, products, payments, stock, access, roles, and history so every interaction leaves evidence and every decision has context.",
      positioningCards: [
        ["Sell services, products, or both", "Run mixed operations without separating cash desk, service, and inventory."],
        ["Daily cash traceability", "Openings, payments, payment methods, closings, and history remain connected."],
        ["Inventory that responds to sales", "Each product sold updates movements, stock, and Kardex."],
        ["Visible customer status", "Validity periods, renewals, access, and operating conditions remain available to the team."],
      ],
      heroMetrics: [
        ["Customers", "Active, expired, and up for renewal"],
        ["Cash desk", "Payments, shifts, and closings"],
        ["Inventory", "Purchases, branch stock, and Kardex"],
        ["Access", "Credential and operational validation"],
      ],
      inventoryKicker: "Connected inventory",
      inventoryTitle: "Inventory that operates at the same level as the cash desk",
      inventoryLead:
        "VIGGO treats inventory as a core part of the operation: products, purchases, initial inventory, stock by branch, locations, transfers, physical counts, transactions, audit, and Kardex stay connected to cash desk and invoicing.",
      inventoryHighlights: [
        ["Complete catalogs", "Units, brands, categories, subcategories, suppliers, locations, and movement types to organize the operating base."],
        ["Stock by branch", "Visible stock by product, branch, and location, with reference minimums to detect replenishment needs on time."],
        ["Purchases and movements", "Entries, exits, adjustments, and inventory documents remain recorded with traceability."],
        ["Transfers and counts", "Move inventory between branches or locations and compare real stock against operational records."],
        ["Product Kardex", "Review entries, exits, documents, and branch balance in a clear timeline."],
        ["Consistency audit", "Review differences between stock, locations, and Kardex to act before they affect operations."],
      ],
      inventoryFlow: [
        "Configure products, suppliers, units, and locations.",
        "Register initial inventory, purchases, adjustments, or transfers.",
        "Sell from the cash desk and stock updates inside the same flow.",
        "Review Kardex, transactions, balances, and audit to make decisions.",
      ],
      painsTitle: "Critical controls VIGGO helps organize",
      painsLead:
        "As a business grows, separated records, manual controls, and payments without follow-up can affect efficiency, profitability, and operational confidence.",
      pains: [
        {
          title: "Unclear customer status",
          text: "Knowing who is active, expired, delinquent, blocked, or pending no longer depends on memory, messages, or loose lists.",
        },
        {
          title: "Scattered payments",
          text: "Payments, renewals, transactions, and closings connect to the real operation of the customer and business.",
        },
        {
          title: "Separate inventory",
          text: "Products, purchases, stock, movements, and sales stop living apart from cash desk and customer service.",
        },
        {
          title: "Access without control",
          text: "The digital credential helps validate customers, locate profiles, and act with visible operating information.",
        },
        {
          title: "Cash desk without traceability",
          text: "Openings, closings, payment methods, differences, and transactions remain available for review.",
        },
        {
          title: "Decisions without history",
          text: "Payments, validity periods, access, inventory, and movements leave a record of what really happened.",
        },
      ],
      capabilitiesTitle: "A complete operation, not isolated tools",
      capabilitiesLead:
        "VIGGO connects areas that often end up split across manual records, spreadsheets, messages, cash desk processes, and non-standardized controls.",
      capabilities: [
        ["Customers and services", "Profiles, plans, validity periods, renewals, and visible status."],
        ["Cash desk and payments", "Transactions, payments, shifts, closings, history, and daily control."],
        ["Advanced inventory", "Products, purchases, initial inventory, stock by branch, transfers, counts, audit, and Kardex."],
        ["Credential and validation", "Digital identification to consult, validate, and act based on customer status."],
        ["Users and permissions", "Roles so each person operates only what they should."],
        ["Operational history", "Payments, validity periods, access, cash desk, and inventory with searchable follow-up."],
      ],
      differentiatorsTitle: "What makes VIGGO different in day-to-day operations",
      differentiatorsLead:
        "Its value is connecting areas that usually work separately, without forcing the business to lose visibility across cash desk, service, inventory, and control.",
      differentiators: [
        ["Integrated operation", "Service, cash desk, inventory, and access control do not live in isolated screens."],
        ["Real traceability", "Every payment, sale, movement, and change keeps context for later review."],
        ["Ready to grow", "Users, roles, branches, locations, and stock stay organized without losing operational control."],
        ["Information for decisions", "The dashboard turns daily work into sales, payments, average ticket, and alerts."],
      ],
      outcomeTitle: "Business impact",
      outcomeText:
        "Greater operational order, clearer service and cash desk processes, and better visibility into what is sold, what is collected, what remains in inventory, and who can use each service.",
      resultsTitle: "Business benefits",
      resultsLead:
        "VIGGO reduces operational friction and turns daily routines into measurable control for teams that need better service and organized growth.",
      results: [
        ["Fewer closing differences", "Cash desk and history are reviewed with connected data."],
        ["More reliable inventory", "Sales, purchases, transfers, counts, and Kardex tell the same story."],
        ["Faster service", "The team reviews status, validity periods, and records without searching external lists."],
        ["More control to grow", "The operation is prepared for more customers, products, services, and branches."],
      ],
      flow: [
        "Register customers, products, services, and operating rules.",
        "Charge services, products, or combinations from the cash desk.",
        "Control validity periods, renewals, branch stock, purchases, transfers, and movements.",
        "Validate credentials, review status, and keep history.",
      ],
      contactTitle: "Want to know VIGGO before launch?",
      contactDescription:
        "Request information from Quantix and let us talk about how VIGGO can organize your business operation before its official release.",
    };
---

<ProductLayout title={copy.title} description={copy.description} lang={lang}>
  <section class="viggo-hero" aria-labelledby="viggo-title">
    <Container>
      <div class="viggo-hero__grid">
        <div class="viggo-hero__content">
          <div class="launch-banner" aria-label={`${copy.launchLabel}: ${copy.launchText}`}>
            <span>{copy.launchLabel}</span>
            <strong>{copy.launchText}</strong>
          </div>
          <h1 id="viggo-title">{copy.h1}</h1>
          <p>{copy.lead}</p>
          <div class="viggo-actions">
            <Button href={primaryCtaHref} target={product.publicUrl ? "_blank" : undefined} variant="primary" size="lg">
              {primaryCtaLabel}
            </Button>
            <Button href={flowHref} variant="secondary" size="lg">{copy.secondaryCta}</Button>
          </div>
        </div>

        <div class="viggo-hero__preview" aria-hidden="true">
          <div class="hero-video-shell">
            <div class="hero-video-shell__top">
              <i></i><i></i><i></i>
              <span>VIGGO Dashboard</span>
            </div>
            <video
              src="/videos/viggo/dashboard-video.mp4"
              poster="/images/viggo/viggo-dashboard.png"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="viggo-positioning" aria-labelledby="viggo-positioning-title">
    <Container>
      <div class="positioning-panel">
        <div class="section-heading section-heading--wide">
          <span class="viggo-kicker">{copy.positioningKicker}</span>
          <h2 id="viggo-positioning-title">{copy.positioningTitle}</h2>
          <p>{copy.positioningLead}</p>
        </div>

        <div class="positioning-grid">
          {copy.positioningCards.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section id="viggo-flow" class="viggo-showcase" aria-labelledby="viggo-showcase-title">
    <Container>
      <div class="showcase-heading">
        <span class="viggo-kicker">{isEs ? "VIGGO en operación" : "VIGGO in operation"}</span>
        <h2 id="viggo-showcase-title">{isEs ? "Caja, transacciones e inventario conectados" : "Cash desk, transactions, and inventory connected"}</h2>
        <p>
          {isEs
            ? "Desde la apertura de caja hasta el historial de transacciones y el Kardex, VIGGO deja visible cada paso operativo de la venta."
            : "From cash desk opening to transaction history and Kardex, VIGGO keeps each operational step of the sale visible."}
        </p>
      </div>

      <div class="showcase-flow" aria-label={isEs ? "Flujo de caja hacia Kardex" : "Cash desk to Kardex flow"}>
        <article class="pos-mockup pos-mockup--cash">
          <div class="pos-mockup__label">
            <span>01</span>
            <strong>{isEs ? "Caja abierta y bajo control" : "Cash desk open and controlled"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Gestión de caja" : "Cash desk management"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-gestion-2.png"
                alt={isEs ? "Pantalla de VIGGO mostrando apertura y gestión de caja" : "VIGGO screen showing cash desk opening and management"}
                loading="eager"
                width="1916"
                height="940"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "caja lista" : "cash ready"}</span>
        </div>

        <article class="pos-mockup pos-mockup--sales">
          <div class="pos-mockup__label">
            <span>02</span>
            <strong>{isEs ? "Caja factura la venta" : "Cash desk invoices the sale"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Factura en VIGGO" : "Invoice in VIGGO"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-factura.png"
                alt={isEs ? "Pantalla de VIGGO Caja creando una factura" : "VIGGO Cash desk screen creating an invoice"}
                loading="eager"
                width="1919"
                height="944"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "primera venta" : "first sale"}</span>
        </div>

        <article class="pos-mockup pos-mockup--sales">
          <div class="pos-mockup__label">
            <span>03</span>
            <strong>{isEs ? "Caja registra una segunda factura" : "Cash desk records a second invoice"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Factura ampliada" : "Expanded invoice"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-factura-2.png"
                alt={isEs ? "Pantalla de VIGGO Caja creando una segunda factura con más productos" : "VIGGO Cash desk screen creating a second invoice with more products"}
                loading="lazy"
                width="1918"
                height="944"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "ventas registradas" : "sales recorded"}</span>
        </div>

        <article class="pos-mockup pos-mockup--history">
          <div class="pos-mockup__label">
            <span>04</span>
            <strong>{isEs ? "Historial de transacciones" : "Transaction history"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>{isEs ? "Historial de caja" : "Cash desk history"}</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-caja-historial-transacciones-2.png"
                alt={isEs ? "Pantalla de VIGGO mostrando historial de transacciones de ambas facturas" : "VIGGO screen showing transaction history from both invoices"}
                loading="eager"
                width="1918"
                height="936"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "movimiento visible" : "movement visible"}</span>
        </div>

        <article class="pos-mockup pos-mockup--kardex">
          <div class="pos-mockup__label">
            <span>05</span>
            <strong>{isEs ? "Kardex registra el movimiento" : "Kardex records the movement"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>Kardex</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-kardex-2.png"
                alt={isEs ? "Pantalla de VIGGO Kardex mostrando movimientos de inventario de ambas ventas" : "VIGGO Kardex screen showing inventory movements from both sales"}
                loading="eager"
                width="1917"
                height="941"
              />
            </div>
          </div>
        </article>

        <div class="showcase-connector" aria-hidden="true">
          <span>{isEs ? "operación resumida" : "operation summarized"}</span>
        </div>

        <article class="pos-mockup pos-mockup--dashboard">
          <div class="pos-mockup__label">
            <span>06</span>
            <strong>{isEs ? "Dashboard resume la operación" : "Dashboard summarizes the operation"}</strong>
          </div>
          <div class="pos-device">
            <div class="pos-device__top">
              <i></i><i></i><i></i>
              <span>Dashboard</span>
            </div>
            <div class="pos-screen">
              <img
                src="/images/viggo/viggo-dashboard.png"
                alt={isEs ? "Dashboard de VIGGO resumiendo ventas, cobros e indicadores del día" : "VIGGO dashboard summarizing daily sales, payments, and indicators"}
                loading="eager"
                width="1917"
                height="945"
              />
            </div>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <section class="viggo-strip" aria-label={isEs ? "Áreas principales de VIGGO" : "VIGGO main areas"}>
    <Container>
      <div class="viggo-strip__grid">
        {copy.heroMetrics.map(([label, text]) => (
          <article>
            <strong>{label}</strong>
            <span>{text}</span>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="inventory-focus" aria-labelledby="inventory-focus-title">
    <Container>
      <div class="inventory-focus__layout">
        <div class="inventory-focus__intro">
          <span class="viggo-kicker">{copy.inventoryKicker}</span>
          <h2 id="inventory-focus-title">{copy.inventoryTitle}</h2>
          <p>{copy.inventoryLead}</p>

          <ol class="inventory-flow">
            {copy.inventoryFlow.map((item) => <li>{item}</li>)}
          </ol>
        </div>

        <div class="inventory-highlight-grid">
          {copy.inventoryHighlights.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="viggo-section viggo-section--surface" aria-labelledby="differentiators-title">
    <Container>
      <div class="section-heading section-heading--wide">
        <span class="viggo-kicker">{isEs ? "Diferenciadores" : "Differentiators"}</span>
        <h2 id="differentiators-title">{copy.differentiatorsTitle}</h2>
        <p>{copy.differentiatorsLead}</p>
      </div>

      <div class="value-grid">
        {copy.differentiators.map(([title, text]) => (
