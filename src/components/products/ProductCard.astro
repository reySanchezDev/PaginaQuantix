---
import type { ProductSummary } from "../../types/site";

interface Props {
  product: ProductSummary;
  viewLabel: string;
  index: number;
}

const { product, viewLabel, index } = Astro.props as Props;
---

<article class="product-row" data-product={product.id} data-reveal>
  <span class="product-row__index">{String(index + 1).padStart(2, "0")}</span>
  <div class="product-row__identity">
    <p>{product.category}</p>
    <h3><a href={product.href}>{product.name}</a></h3>
  </div>
  <div class="product-row__detail">
    <p>{product.description}</p>
    <span>{product.status}</span>
  </div>
  <span class="product-row__arrow" aria-hidden="true">↗</span>
  <span class="visually-hidden">{viewLabel}: {product.name}</span>
</article>

<style>
  .product-row[data-reveal] {
    --product-accent: var(--color-primary);
    position: relative;
    display: grid;
    min-width: 0;
    gap: var(--space-5);
    align-items: start;
    padding-block: clamp(var(--space-6), 4vw, var(--space-10));
    border-top: 1px solid var(--color-border-strong);
    isolation: isolate;
    transition:
      opacity var(--transition-reveal),
      transform var(--transition-reveal),
      background var(--transition-base);
  }

  .product-row::before {
    position: absolute;
    inset: 0 auto 0 calc(-1 * var(--space-2));
    z-index: -1;
    width: 0.2rem;
    background: var(--product-accent);
    content: "";
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--transition-base);
  }

  .product-row:hover,
  .product-row:focus-within {
    background: color-mix(in srgb, var(--product-accent) 5%, transparent);
  }

  .product-row:hover::before,
  .product-row:focus-within::before {
    transform: scaleY(1);
  }

  .product-row:last-child {
    border-bottom: 1px solid var(--color-border-strong);
  }

  .product-row[data-product="viggo"] {
    --product-accent: var(--product-viggo);
  }
  .product-row[data-product="takofy"] {
    --product-accent: var(--product-takofy);
  }
  .product-row[data-product="nica-finanzas"] {
    --product-accent: var(--product-finance);
  }
  .product-row[data-product="qavision"] {
    --product-accent: var(--product-qavision);
  }

  .product-row__index,
  .product-row__detail > span {
    color: var(--color-ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .product-row__identity > p {
    margin: 0 0 var(--space-2);
    color: var(--product-accent);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  h3 {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .product-row__detail > p {
    max-width: 36rem;
    margin: 0 0 var(--space-5);
    color: var(--color-ink-muted);
    line-height: var(--leading-relaxed);
  }

  .product-row__arrow {
    color: var(--color-ink);
    font-size: var(--text-xl);
    transition: transform var(--transition-fast);
  }

  .product-row:hover .product-row__arrow,
  .product-row:focus-within .product-row__arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (min-width: 52rem) {
    .product-row {
      grid-template-columns: 2rem minmax(14rem, 0.8fr) minmax(18rem, 1.2fr) 2rem;
    }
  }

  @media (max-width: 51.99rem) {
    .product-row {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    }

    .product-row__detail {
      grid-column: 2 / -1;
    }

    .product-row__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
