---
import type { ProductSummary } from "../../types/site";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";

interface Props {
  product: ProductSummary;
  viewLabel: string;
}

const { product, viewLabel } = Astro.props as Props;
---

<article
  class:list={["product-card", { "product-card--featured": product.featured }]}
  data-product={product.id}
>
  <div class="product-card__header">
    <Badge tone="accent">{product.status}</Badge>
    <span class="product-card__category">{product.category}</span>
  </div>

  <div class="product-card__body">
    <h3><a href={product.href}>{product.name}</a></h3>
    <p>{product.description}</p>
    <ul aria-label={product.category}>
      {product.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>

  <div class="product-card__actions">
    <Button href={product.href} variant="secondary">{viewLabel}</Button>
    {
      product.external && (
        <Button href={product.external.href} target={product.external.target} variant="link">
          {product.external.label}
          <span aria-hidden="true"> ↗</span>
        </Button>
      )
    }
  </div>
</article>

<style>
  .product-card {
    --product-accent: var(--color-primary);
    --product-soft: var(--color-primary-soft);
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    padding: clamp(var(--space-5), 3vw, var(--space-8));
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .product-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 0.25rem;
    background: var(--product-accent);
    content: "";
  }

  .product-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .product-card[data-product="viggo"] {
    --product-accent: var(--product-viggo);
    --product-soft: var(--product-viggo-soft);
  }
  .product-card[data-product="takofy"] {
    --product-accent: var(--product-takofy);
    --product-soft: var(--product-takofy-soft);
  }
  .product-card[data-product="nica-finanzas"] {
    --product-accent: var(--product-finance);
    --product-soft: var(--product-finance-soft);
  }
  .product-card[data-product="qavision"] {
    --product-accent: var(--product-qavision);
    --product-soft: var(--product-qavision-soft);
  }

  .product-card--featured {
    background: linear-gradient(145deg, var(--color-surface), var(--product-soft));
  }

  .product-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    color: var(--color-ink-subtle);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h3 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .product-card__body > p {
    min-height: 5.1rem;
    margin: var(--space-4) 0 0;
    color: var(--color-ink-muted);
    line-height: var(--leading-relaxed);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.35rem var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .product-card__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-8);
  }
</style>
