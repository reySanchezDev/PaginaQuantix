---
import type { CaseStudyContent } from "../../types/case-study";
import type { Locale } from "../../types/site";
import { getRoute } from "../../i18n/routes";
import ViggoRegisterDetail from "../products/ViggoRegisterDetail.astro";

interface Props {
  study: CaseStudyContent;
  locale: Locale;
}
const { study, locale } = Astro.props;
const es = locale === "es";
const registerAlt = es
  ? "Detalle de dos cobros de VIGGO con sus importes y métodos de pago."
  : "Detail of two VIGGO payments showing their amounts and payment methods.";
---

<figure class="case-preview-figure" data-reveal={study.id === "takofy" ? undefined : "image"}>
  <a
    class:list={["case-image", { "case-image--staged": study.id === "takofy" }]}
    href={getRoute(study.id === "takofy" ? "case-takofy" : "case-viggo", locale)}
    aria-label={`${es ? "Conocer el caso" : "Read the case study"}: ${study.productName}`}
  >
    {
      study.id === "viggo" ? (
        <ViggoRegisterDetail alt={registerAlt} />
      ) : (
        <>
          <span class="case-image__brand">{study.productName}</span>
          <div class="case-image__viewport">
            <img
              src={study.heroImage.src}
              alt={study.heroImage.alt}
              width={study.heroImage.width}
              height={study.heroImage.height}
              loading="lazy"
              decoding="async"
              data-reveal="frame"
              data-motion-delay="75"
            />
          </div>
        </>
      )
    }
  </a>
  <figcaption>
    {
      study.id === "viggo"
        ? es
          ? "Importes y métodos de pago. Datos de ejemplo."
          : "Amounts and payment methods. Sample data."
        : es
          ? "Una mesa, sus platos y las indicaciones para cocina. Datos de ejemplo."
          : "A table, its items and the kitchen notes. Sample data."
    }
  </figcaption>
</figure>

<style>
  .case-preview-figure {
    min-width: 0;
    margin: 0;
  }
  .case-image {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
  }
  .case-image--staged {
    padding: clamp(0.4rem, 1.3vw, 0.8rem);
    border-color: var(--color-border-strong);
    border-radius: 1.05rem;
    background: linear-gradient(148deg, var(--color-surface-raised), var(--color-surface-muted));
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .case-image__brand {
    display: block;
    padding: 0.05rem 0.35rem 0.5rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .case-image__viewport {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: 0.65rem;
    background: var(--color-surface);
  }
  @media (prefers-reduced-motion: no-preference) {
    .case-image__viewport:has([data-motion-state="running"])::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, transparent 42%, #fff5d64d 50%, transparent 58%);
      pointer-events: none;
      animation: case-frame-light 720ms var(--motion-ease-out) both;
    }
  }
  @keyframes case-frame-light {
    from {
      opacity: 0;
      transform: translateX(-100%);
    }
    35% {
      opacity: 0.7;
    }
    to {
      opacity: 0;
      transform: translateX(100%);
    }
  }
  img {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
