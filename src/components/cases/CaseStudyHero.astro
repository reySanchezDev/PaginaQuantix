---
import type { CaseStudyContent } from "../../types/case-study";
import type { LinkItem, Locale } from "../../types/site";
import Container from "../ui/Container.astro";
import CaseStudyFigure from "./CaseStudyFigure.astro";

interface Props {
  caseStudy: CaseStudyContent;
  locale: Locale;
  backLink?: LinkItem;
}
const { caseStudy, locale, backLink } = Astro.props;
const es = locale === "es";
---

<header class="case-hero">
  <Container>
    {
      backLink && (
        <a class="case-back" href={backLink.href}>
          <span aria-hidden="true">←</span>
          {backLink.label}
        </a>
      )
    }
    <div class="case-hero__heading">
      <div>
        <p class="eyebrow">{es ? "Caso de producto" : "Product study"} · {caseStudy.productName}</p>
        <h1 id="case-title">{caseStudy.title}</h1>
        <p class="case-hero__summary">{caseStudy.summary}</p>
      </div>
      <aside class="case-context" aria-label={es ? "Contexto del producto" : "Product context"}>
        <dl>
          <div>
            <dt>Sector</dt>
            <dd>{caseStudy.category}</dd>
          </div>
          <div>
            <dt>{es ? "En este caso" : "In this study"}</dt>
            <dd>{caseStudy.scope}</dd>
          </div>
        </dl>
        <p>{caseStudy.context}</p>
      </aside>
    </div>
    <CaseStudyFigure image={caseStudy.heroImage} locale={locale} priority />
  </Container>
</header>

<style>
  .case-hero {
    padding: 1.25rem 0 0;
  }
  .case-back {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .case-back:hover {
    color: var(--color-primary);
  }
  .case-hero__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 0.7fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }
  h1 {
    max-width: 24ch;
    font-size: var(--text-title);
  }
  .case-hero__summary {
    max-width: 58ch;
    margin: 1.5rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
  }
  .case-context {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-strong);
    font-size: var(--text-sm);
  }
  dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  dt {
    color: var(--color-ink-muted);
  }
  dd {
    margin: 0.125rem 0 0;
    font-weight: 500;
  }
  .case-context p {
    margin: 1.25rem 0 0;
    color: var(--color-ink-muted);
  }
  @media (max-width: 52rem) {
    .case-hero__heading {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .case-context dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .case-context p {
      max-width: 64ch;
    }
  }
</style>
