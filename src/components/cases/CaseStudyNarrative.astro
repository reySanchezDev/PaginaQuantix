---
import type { CaseStudyContent } from "../../types/case-study";
import type { Locale } from "../../types/site";
import Container from "../ui/Container.astro";
import CaseStudyFigure from "./CaseStudyFigure.astro";

interface Props {
  caseStudy: CaseStudyContent;
  locale: Locale;
}
const { caseStudy, locale } = Astro.props;
const es = locale === "es";
const chapters = [
  {
    id: "need",
    label: es ? "La necesidad operativa" : "The operational need",
    ...caseStudy.problem,
  },
  { id: "solution", label: es ? "La solución construida" : "The solution", ...caseStudy.solution },
];
---

<div class="case-narrative">
  <Container>
    {
      chapters.map((chapter) => (
        <section class="case-chapter" aria-labelledby={`${chapter.id}-title`}>
          <p class="eyebrow">{chapter.label}</p>
          <div class="case-chapter__copy">
            <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
            {chapter.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))
    }
    <section class="case-workflow" aria-labelledby="workflow-title">
      <div>
        <p class="eyebrow">{es ? "El funcionamiento" : "How it works"}</p>
        <h2 id="workflow-title">{caseStudy.workflow.title}</h2>
      </div>
      <ul role="list">
        {
          caseStudy.workflow.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>
    <CaseStudyFigure image={caseStudy.detailImage} locale={locale} />
  </Container>
</div>

<style>
  .case-narrative {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .case-chapter {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .case-chapter > .eyebrow {
    margin: 0;
    padding-top: 0.4rem;
  }
  .case-chapter__copy {
    max-width: 46rem;
  }
  .case-chapter h2 {
    max-width: 32ch;
    font-size: var(--text-heading);
    line-height: 1.2;
  }
  .case-chapter__copy p {
    max-width: 68ch;
    margin: 1.25rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  .case-workflow {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
  }
  .case-workflow h2 {
    max-width: 18ch;
    font-size: var(--text-section);
  }
  ul {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  h3 {
    font-size: var(--text-subtitle);
  }
  li p {
    max-width: 60ch;
    margin: 0.5rem 0 0;
    color: var(--color-ink-muted);
    font-size: var(--text-base);
  }
  @media (max-width: 52rem) {
    .case-chapter,
    .case-workflow {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .case-workflow {
      gap: 2rem;
    }
  }
</style>
