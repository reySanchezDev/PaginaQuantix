{
  "name": "quantix-software-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Corporate website for Quantix Software.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "deadcode": "knip --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:og": "node scripts/generate-og-images.mjs",
    "check:size": "node scripts/check-source-size.mjs",
    "test:build": "node scripts/validate-build.mjs",
    "audit": "npm audit --audit-level=high",
    "quality": "npm run format:check && npm run lint && npm run deadcode && npm run check:size && npm run check && npm run build && npm run test:build && npm run audit",
    "astro": "astro"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "astro": "^7.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "brace-expansion@^1.1.18": "1.1.21",
    "brace-expansion@^5.0.9": "5.0.12",
    "fast-uri": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "postcss-selector-parser": "7.1.6",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2"
  }
}
