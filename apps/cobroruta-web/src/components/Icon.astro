---
const { name } = Astro.props as {name:string};
---
<svg class="feature-icon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name==='users' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></>}
  {name==='calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M8 14h3"/></>}
  {name==='wallet' && <><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M16 11h5v5h-5a2.5 2.5 0 1 1 0-5ZM3 9V5a2 2 0 0 1 2-2h13"/></>}
  {name==='route' && <><circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M6 16V7a4 4 0 0 1 4-4h4M18 8v8a4 4 0 0 1-4 4h-4"/></>}
  {name==='chart' && <><path d="M3 3v18h18M7 17v-4M12 17V9M17 17V6"/></>}
  {name==='cloud' && <><path d="M20 16.5a4.5 4.5 0 0 0-1.7-8.7 6.5 6.5 0 0 0-12.7 1.7 4.6 4.6 0 0 0 0 9h12.3"/><path d="m10 15 2 2 4-4"/></>}
</svg>
