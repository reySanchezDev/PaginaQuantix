---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import PaymentDemo from './PaymentDemo.astro';
import ScreensGallery from './ScreensGallery.astro';
import {copy} from '../content/copy';
import {routeMap,type Locale} from '../lib/routes';
const {locale} = Astro.props as {locale:Locale};
const c=copy[locale];
const play='https://play.google.com/store/apps/details?id=dev.hensell.cobro_ruta';
---
<section class="hero-section" id="inicio">
  <div class="hero-pattern" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="eyebrow pill-eyebrow"><span class="tiny-star">✳</span> {c.hero.eyebrow}</div>
      <h1><span>{c.hero.titleA}</span><br/><em>{c.hero.titleB}</em></h1>
      <p class="hero-subtitle">{c.hero.body}</p>
      <div class="hero-ctas"><a class="btn btn-primary btn-xl" href={routeMap.demo[locale]}>{c.hero.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href={play} target="_blank" rel="noopener noreferrer">{c.hero.secondary}<span aria-hidden="true">↗</span></a></div>
      <div class="hero-note"><span class="note-seal" aria-hidden="true">✓</span>{c.hero.footnote}</div>
    </div>
    <div class="hero-visual" aria-label={c.hero.screenStatus}>
      <div class="hero-arc arc-1" aria-hidden="true"></div><div class="hero-arc arc-2" aria-hidden="true"></div>
      <div class="float-label float-top"><span class="float-icon"><Mark/></span><span><strong>CobroRuta</strong><small>Android · Offline-first</small></span></div>
      <figure class="phone-shell"><div class="phone-speaker" aria-hidden="true"></div><img src="/images/screens/home-android.jpg" alt={c.hero.screenCaption} width="230" height="512" loading="eager" decoding="async" /></figure>
      <div class="float-label float-bottom"><span class="status-orbit" aria-hidden="true"></span><span><strong>{c.hero.screenStatus}</strong><small>{c.hero.screenCaption}</small></span></div>
      <span class="hero-visual-index">01 / 04 — COBRORUTA</span>
    </div>
  </div>
  <div class="hero-scroll container"><span>{c.hero.scroll}</span><span aria-hidden="true">↓</span></div>
</section>
<div class="marquee-strip"><div class="container marquee-inner">{c.marquee.map((item,i)=><><span>{item}</span>{i<3&&<b aria-hidden="true">✳</b>}</>)}</div></div>
<section class="section section-journey" id="jornada">
  <div class="container">
    <div class="section-head journey-head" data-reveal><span class="eyebrow">{c.intro.eyebrow}</span><h2>{c.intro.title}</h2><p>{c.intro.body}</p></div>
    <div class="journey-grid">
      <div class="journey-visual" data-reveal><div class="journey-window"><div class="journey-window-top"><span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span><small>COBRORUTA / JOURNEY</small></div><div class="journey-art"><div class="route-illustration" aria-hidden="true"><div class="route-line"></div><span class="route-stop stop-1">01</span><span class="route-stop stop-2">02</span><span class="route-stop stop-3">03</span><span class="route-stop stop-4">04</span><div class="map-orbit orbit-a"></div><div class="map-orbit orbit-b"></div></div><div class="art-note">{locale==='es'?'Recorrido ilustrativo · No es una pantalla de la app':'Illustrative flow · Not an app screen'}</div></div></div></div>
      <div class="journey-steps">{c.intro.steps.map(s=><div class="journey-step" data-reveal><span class="journey-number">{s.num}</span><div><h3>{s.title}</h3><p>{s.text}</p></div><span class="step-arrow" aria-hidden="true">↗</span></div>)}</div>
    </div>
  </div>
</section>
<section class="section demo-section" id="demo">
  <div class="container">
    <div class="demo-section-grid"><div class="demo-intro" data-reveal><span class="eyebrow">{c.demo.eyebrow}</span><h2>{c.demo.title}</h2><p>{c.demo.body}</p><div class="demo-proof"><span class="proof-mark">✳</span><span>{c.demo.viewCode}</span></div></div><div data-reveal><PaymentDemo locale={locale}/></div></div>
  </div>
</section>
<section class="section feature-section" id="funciones"><div class="container"><div class="section-head feature-head" data-reveal><span class="eyebrow">{c.feature.eyebrow}</span><h2>{c.feature.title}</h2><p>{c.feature.subtitle}</p></div><div class="features-grid">{c.feature.cards.map((f,i)=><article class="feature-card" data-reveal><span class="feature-index">0{i+1}</span><div class="feature-symbol"><Icon name={f.icon}/></div><h3>{f.title}</h3><p>{f.text}</p><span class="feature-trace" aria-hidden="true"></span></article>)}</div></div></section>
<ScreensGallery locale={locale}/>
<section class="final-cta"><div class="container closing-grid"><div class="closing-orbit" aria-hidden="true"><span></span><span></span><Mark/></div><div class="closing-copy" data-reveal><span class="eyebrow">{c.close.eyebrow}</span><h2>{c.close.title}</h2><p>{c.close.body}</p><div class="closing-actions"><a href={play} class="btn btn-light btn-xl" target="_blank" rel="noopener noreferrer">{c.close.primary}<span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href={routeMap.demo[locale]}>{c.close.secondary} <span aria-hidden="true">→</span></a></div></div></div></section>
