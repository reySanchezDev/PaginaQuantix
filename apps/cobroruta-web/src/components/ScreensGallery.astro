---
import type { Locale } from '../lib/routes';
const {locale} = Astro.props as {locale:Locale};
const es = locale === 'es';
const images = [
 {src:'/images/screens/home-android.jpg', es:'Inicio de CobroRuta',en:'CobroRuta home screen',descEs:'Todo empieza aquí',descEn:'Your starting point'},
 {src:'/images/screens/clients-empty-android.jpg',es:'Estado inicial de clientes',en:'Customer empty state',descEs:'Tus clientes',descEn:'Your customers'},
 {src:'/images/screens/route-empty-android.jpg',es:'Ruta diaria sin cuotas vencidas',en:'Daily route with no due installments',descEs:'Tu ruta del día',descEn:'Your daily route'},
 {src:'/images/screens/reports-menu-android.jpg',es:'Listado de reportes de CobroRuta',en:'CobroRuta reporting menu',descEs:'Reportes',descEn:'Reporting'},
 {src:'/images/screens/portfolio-report-android.jpg',es:'Reporte de salud de cartera con datos vacíos',en:'Portfolio report with empty data',descEs:'Salud de cartera',descEn:'Portfolio insights'},
 {src:'/images/screens/forecast-report-android.jpg',es:'Proyección de cobros con datos vacíos',en:'Collection forecast with empty data',descEs:'Próximos cobros',descEn:'Upcoming collections'},
];
---
<section class="section screenshot-section" aria-labelledby="screen-gallery-title">
  <div class="container">
    <div class="section-head screenshot-gallery-heading" data-reveal>
      <span class="eyebrow">{es?'COBRORUTA EN ACCIÓN':'COBRORUTA AT WORK'}</span>
      <h2 id="screen-gallery-title">{es?'Explorá CobroRuta.':'Explore CobroRuta.'}</h2>
    </div>
    <div class="screens-carousel" data-screens-carousel>
      <div class="screen-carousel-toolbar">
        <p class="screen-carousel-hint"><span class="screen-carousel-swipe" aria-hidden="true">⟷</span>{es?'Deslizá para descubrir más':'Swipe to explore more'}</p>
        <div class="screen-carousel-navigation">
          <span class="screen-carousel-count" aria-live="polite"><strong data-carousel-current>01</strong> / {String(images.length).padStart(2,'0')}</span>
        </div>
      </div>
      <div class="screen-carousel-stage">
        <div class="screen-gallery" data-carousel-track role="region" aria-roledescription={es?'carrusel':'carousel'} aria-label={es?'Pantallas de CobroRuta':'CobroRuta screens'} tabindex="0">
        {images.map((item,i)=><figure class="screen-gallery-card" data-carousel-slide>
          <div class="screen-gallery-device"><img src={item.src} alt={es?item.es:item.en} width="230" height="512" loading="lazy" decoding="async"/></div>
          <figcaption><span>{String(i+1).padStart(2,'0')}</span>{es?item.descEs:item.descEn}</figcaption>
        </figure>)}
        </div>
        <div class="screen-carousel-floating-controls" aria-label={es?'Navegación entre pantallas':'Screen navigation'}>
          <button class="screen-carousel-arrow screen-carousel-arrow--previous" type="button" data-carousel-prev aria-label={es?'Pantalla anterior':'Previous screen'} disabled>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
          </button>
          <button class="screen-carousel-arrow screen-carousel-arrow--next" type="button" data-carousel-next aria-label={es?'Pantalla siguiente':'Next screen'}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg>
          </button>
        </div>
      </div>
      <div class="screen-carousel-pagination" data-carousel-dots aria-label={es?'Ir a una captura':'Go to screenshot'}>
        {images.map((item,i)=><button type="button" class:list={['screen-carousel-dot',{'is-active':i===0}]} data-carousel-dot={i} aria-label={(es?'Ir a la captura ':'Go to screenshot ')+(i+1)+': '+(es?item.descEs:item.descEn)} aria-current={i===0?'true':undefined}><span></span></button>)}
      </div>
    </div>
  </div>
</section>
<script>
  function initScreensCarousels() {
    document.querySelectorAll<HTMLElement>('[data-screens-carousel]').forEach(root => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const track=root.querySelector<HTMLElement>('[data-carousel-track]');
      const slides=Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
      const previous=root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next=root.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const current=root.querySelector<HTMLElement>('[data-carousel-current]');
      const dots=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
      if(!track||!slides.length||!previous||!next||!current) return;
      let firstIndex=0;
      let frame=0;
      const perView=()=>window.matchMedia('(min-width:1101px)').matches?3:window.matchMedia('(min-width:701px)').matches?2:1;
      const maxStart=()=>Math.max(0,slides.length-perView());
      const offset=(i:number)=>slides[i].offsetLeft-slides[0].offsetLeft;
      const reduced=window.matchMedia('(prefers-reduced-motion:reduce)');
      const update=()=>{
        let nearest=0;
        slides.forEach((_,i)=>{if(Math.abs(offset(i)-track.scrollLeft)<Math.abs(offset(nearest)-track.scrollLeft))nearest=i;});
        firstIndex=Math.min(maxStart(),nearest);
        current.textContent=String(firstIndex+1).padStart(2,'0');
        previous.disabled=firstIndex===0;
        next.disabled=firstIndex===maxStart();
        dots.forEach((dot,i)=>{
          dot.hidden=i>maxStart();
          dot.classList.toggle('is-active',i===firstIndex);
          if(i===firstIndex)dot.setAttribute('aria-current','true');
          else dot.removeAttribute('aria-current');
        });
      };
      const go=(index:number)=>{
        firstIndex=Math.max(0,Math.min(maxStart(),index));
        track.scrollTo({left:offset(firstIndex),behavior:reduced.matches?'auto':'smooth'});
        current.textContent=String(firstIndex+1).padStart(2,'0');
        previous.disabled=firstIndex===0;
        next.disabled=firstIndex===maxStart();
        dots.forEach((dot,i)=>{dot.hidden=i>maxStart();dot.classList.toggle('is-active',i===firstIndex);if(i===firstIndex)dot.setAttribute('aria-current','true');else dot.removeAttribute('aria-current');});
      };
      previous.addEventListener('click',()=>go(firstIndex-1));
      next.addEventListener('click',()=>go(firstIndex+1));
      dots.forEach((dot,i)=>dot.addEventListener('click',()=>go(i)));
      track.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){e.preventDefault();go(firstIndex+1);}else if(e.key==='ArrowLeft'){e.preventDefault();go(firstIndex-1);}});
      track.addEventListener('scroll',()=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(update);},{passive:true});
      window.addEventListener('resize',()=>{track.scrollTo({left:offset(Math.min(firstIndex,maxStart())),behavior:'auto'});update();},{passive:true});
      update();
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',initScreensCarousels,{once:true});
  else initScreensCarousels();
</script>